<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.shmedo.mcloudapp">

    <!--允许程序打开网络套接字-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--允许程序访问CellID或WiFi热点来获取粗略的位置-->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!--允许程序访问精良位置(如GPS)-->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--允许程序改变Wi-Fi连接状态-->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--允许程序访问Wi-Fi网络状态信息-->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--允许程序获取网络状态-->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!--允许应用程序访问额外的位置提供命令-->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <!--允许程序设置内置sd卡的读权限-->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!--允许程序设置内置sd卡的写权限-->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!--允许程序连接到已配对的蓝牙设备-->
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <!-- 允许程序发现和配对蓝牙设备 -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <!--用于读取手机当前的状态-->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <!-- 请求访问使用照相设备 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!--允许程序录制音频-->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!--用WakeLock使Android应用程序保持后台唤醒-->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--访问闪光灯-->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!--允许访问振动设备-->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="n">
        <activity android:name=".ui.activity.WelcomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 定位需要的服务 使用2.0的定位需要加上这个 -->
        <service android:name="com.amap.api.location.APSService" >

        </service>
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="31d7ee436c402270e11183ce1b5d01dc" />
        <!--兼容7.0-->
        <provider
            android:name="android.support.v4.content.FileProvider"
            android:authorities="com.shmedo.mcloudapp.FileProvider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".ui.activity.MainActivity"/>
        <activity
            android:name=".ui.activity.LoginActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            />
        <activity
            android:name=".ui.activity.ServiceConfigActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppThemeBar"
            android:label="配置服务器"
            />
        <activity android:name=".ui.activity.UserInfoActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppThemeBar"
            android:label="我的"
            />
        <activity android:name=".ui.activity.ScanAddDeviceActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppThemeBar"
            android:label="添加设备"
            />
        <activity android:name=".ui.activity.InputDeviceSNActivity"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/AppThemeBar"
            android:label="添加设备"
            />
        <activity android:name=".ui.activity.DeviceManageActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppThemeBar"
            android:label="设备管理"
            />
        <activity android:name=".ui.activity.SearchDeviceActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppThemeBar"
            android:label="搜索设备"
            />
        <activity android:name=".ui.activity.DeviceManageDetailActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"
            />

        <activity android:name=".ui.activity.BlueToothListActivity"
            android:label="@string/select_device"
            android:theme="@style/AppTheme.Dialog"
            android:configChanges="orientation|keyboardHidden"
            android:launchMode="singleInstance"
            />
        <activity android:name=".ui.activity.WifiConnectionActivity"
            android:label=""
            android:theme="@style/AppTheme.Dialog"
            android:configChanges="orientation|keyboardHidden"
            android:launchMode="singleInstance"
            />
        <activity android:name=".ui.activity.device.AccessDeviceDetailsActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"

            />

        <activity android:name=".ui.activity.device.senior.ProductRegistrationActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"
            />
        <activity android:name=".ui.activity.device.senior.InstructionDebugActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"
            />
        <activity android:name=".ui.activity.device.GeneralSettingActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:theme="@style/AppTheme.NoActionBar"
            />
        <activity android:name=".ui.activity.device.sensor.SenSorMPSConfigActivity"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/AppTheme.NoActionBar"
            />
        <activity android:name=".ui.activity.device.sensor.SenSorBGKConfigActivity"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/AppTheme.NoActionBar"
            />

        <activity android:name=".ui.activity.device.OsmometerConfigActivity"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/AppTheme.NoActionBar"
            />
        <activity android:name=".ui.activity.device.RainConfigActivity"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/AppTheme.NoActionBar"
            />
        <activity android:name=".ui.activity.AllDeviceActivity"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/AppTheme.NoActionBar"
            />

    </application>

</manifest>