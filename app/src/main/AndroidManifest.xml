<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.shmedo.mcloudapp">

    <uses-permission android:name="android.permission.INTERNET" /> <!-- 允许程序打开网络套接字 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- 允许程序访问CellID或WiFi热点来获取粗略的位置 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" /> <!-- 允许程序访问精良位置(如GPS) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> <!-- 允许程序访问精良位置(如GPS) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" /> <!-- 允许程序改变Wi-Fi连接状态 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" /> <!-- 允许程序访问Wi-Fi网络状态信息 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- 允许程序获取网络状态 -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" /> <!-- 允许应用程序访问额外的位置提供命令 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" /> <!-- 允许程序设置内置sd卡的读权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" /> <!-- 允许程序设置内置sd卡的写权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" /> <!-- 允许程序连接到已配对的蓝牙设备 -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" /> <!-- 允许程序发现和配对蓝牙设备 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" /> <!-- 用于读取手机当前的状态 -->
    <uses-permission android:name="android.permission.CAMERA" /> <!-- 请求访问使用照相设备 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" /> <!-- 允许程序录制音频 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" /> <!-- 用WakeLock使Android应用程序保持后台唤醒 -->
    <uses-permission android:name="android.permission.FLASHLIGHT" /> <!-- 访问闪光灯 -->
    <uses-permission android:name="android.permission.VIBRATE" /> <!-- 允许访问振动设备 -->
    <uses-permission android:name="android.permission.GET_TASKS"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" /><!--Android8.0 安装 apk 需要添加权限-->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".MCloudApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/logo"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning"
        tools:targetApi="n"
        tools:replace="android:appComponentFactory"
        android:appComponentFactory="permission">

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${mapApikey}" /> <!-- 定位需要的服务 使用2.0的定位需要加上这个 -->

        <service android:name="com.amap.api.location.APSService" /> <!-- 兼容7.0 -->

        <!--<provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.shmedo.mcloudapp.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true"
            >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource" />
        </provider>-->

        <!--蒲公英配置-->
        <activity android:name="com.pgyersdk.feedback.FeedbackActivity"/>
        <meta-data
                android:name="PGYER_APPID"
                android:value="${pgyerKey}" >
        </meta-data>


        <activity android:name="com.shmedo.mcloudapp.ui.activity.WelcomeActivity"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.LoginActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.MainActivity"
            android:label="主页面"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.ServiceConfigActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.UserInfoActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.InputDeviceSNActivity"
            android:label="添加设备"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.DeviceManageActivity"
            android:label="设备管理"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.SearchDeviceActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.DeviceManageDetailActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.BlueToothListActivity"
            android:configChanges="orientation|keyboardHidden"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.Dialog" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.WifiConnectionActivity"
            android:configChanges="orientation|keyboardHidden"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.Dialog" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.senior.ProductRegistrationActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.senior.InstructionDebugActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.GeneralSettingActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.sensor.SenSorBGKConfigActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.OsmometerConfigActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.RainConfigActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.ConfigE60Activity"
            android:label="E60设备配置页面"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.ConfigADMEActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.ScanActivity"
            android:screenOrientation="portrait"
            android:theme="@style/ScanActivityTheme" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.ADMESensorExecutiveAgencyConfigActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.ADMEMotorControlActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.CountMeterWheelActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.ConfigDASActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name="com.shmedo.mcloudapp.ui.activity.device.MqttSettingActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
                android:name="com.shmedo.mcloudapp.ui.activity.device.senior.LogPrintActivity"
                android:screenOrientation="portrait"
                android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />

        <activity
                android:name="com.shmedo.mcloudapp.ui.activity.AboutAppActivity"
                android:screenOrientation="portrait" />

    </application>

</manifest>