<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 连框颜色值 -->
    <item>
        <shape>

            <corners android:radius="30dp" />

        </shape>
    </item>
    <!-- 主体背景颜色值 -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:centerColor="@color/app_color_blue_2"
                android:endColor="@color/app_color_blue"
                android:startColor="@color/app_color_blue_disabled"
                android:type="linear" />

            <!--<padding-->
            <!--android:left="2dp"-->
            <!--android:top="2dp"-->
            <!--android:right="2dp"-->
            <!--android:bottom="2dp" />-->
            <!-- 圆角 -->
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>