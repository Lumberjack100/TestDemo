<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.GW100BaseInfoViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.gw100.fragment.GW100BaseInfoFragment.ClickProxy" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/main_bg_gray">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_size_50"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/dimen_size_10"
                        android:layout_marginStart="@dimen/dimen_size_10"
                        android:text="基本信息"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_17"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/DeviceCurrentState_SingleItem_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/DeviceCurrentState_SingleItem_NameStyle"
                            android:text="设备SN" />

                        <TextView
                            style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                            android:text="@{stateVM.wrapStateInfo.sn}"
                            tools:text="modo-1819929190" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/DeviceCurrentState_SingleItem_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/DeviceCurrentState_SingleItem_NameStyle"
                            android:text="硬件版本" />

                        <TextView
                            style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                            android:text="@{stateVM.wrapStateInfo.hardwareVersion}"
                            tools:text="1212" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/DeviceCurrentState_SingleItem_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/DeviceCurrentState_SingleItem_NameStyle"
                            android:text="固件版本" />

                        <TextView
                            style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                            android:text="@{stateVM.wrapStateInfo.firmwareVersion}"
                            tools:text="1212" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ll_device_abnormal_diagnosis"
                        style="@style/Common_ClickableItem_LayoutStyle"
                        onClickWithDebouncing="@{()->click.onShowErrorModulesInfoClick()}"
                        android:layout_height="44dp"
                        android:enabled="@{!stateVM.deviceNormal}">

                        <TextView
                            style="@style/DeviceCurrentState_SingleItem_NameStyle"
                            android:text="设备状态" />

                        <TextView
                            android:id="@+id/tv_device_abnormal_diagnosis"
                            style="@style/Common_ClickableItem_ValueStyle"
                            rightArrowVisible="@{!stateVM.deviceNormal}"
                            android:text='@{stateVM.deviceNormal?"正常":"异常"}'
                            android:textColor="@{stateVM.deviceNormal?@color/text_color_3AD094:@color/red}"
                            android:textSize="15sp"
                            tools:drawableEndCompat="@drawable/icon_arrow_right"
                            tools:text="异常" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/dimen_size_10"
                        android:layout_marginStart="@dimen/dimen_size_10"
                        android:text="测站节点信息"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_17"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_station_node"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:clipToPadding="false"
                        android:splitMotionEvents="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="6"
                        tools:listitem="@layout/item_gw100_device_info_station_node" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>