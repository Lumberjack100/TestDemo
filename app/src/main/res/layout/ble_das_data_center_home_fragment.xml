<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.scwang.smart.refresh.header.ClassicsHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:paddingStart="16.5dp"
                android:text="通用设置"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_15" />

            <LinearLayout
                android:id="@+id/communicationMethodLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="通讯方式" />

                <TextView
                    android:id="@+id/tv_communication_method"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="4g" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="上报间隔(min)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/reportingIntervalET"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_bd_card_number"
                style="@style/Common_EditItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="北斗目标卡号" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/bdCardNumberET"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/dataCenterOneLayout"
                style="@style/Common_ClickableItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="数据中心1" />

                <TextView
                    android:id="@+id/tv_data_center_one"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="未启用" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/dataCenterTwoLayout"
                style="@style/Common_ClickableItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="数据中心2" />

                <TextView
                    android:id="@+id/tv_data_center_two"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="未启用" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/dataCenterThreeLayout"
                style="@style/Common_ClickableItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="数据中心3" />

                <TextView
                    android:id="@+id/tv_data_center_three"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="未启用" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_confirm"
                style="@style/SubmitBordelessButtonStyle"
                android:text="保存" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.scwang.smart.refresh.footer.ClassicsFooter
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</com.scwang.smart.refresh.layout.SmartRefreshLayout>