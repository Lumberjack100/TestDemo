<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <include
            android:id="@+id/head_info_layout"
            layout="@layout/device_config_head_info" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#a6a6a6" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="@color/bg_main_light_white"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_pro"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/icon_project" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_toRightOf="@id/iv_pro"
                android:gravity="center_vertical"
                android:text="分配到项目"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />


            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@id/tv_lock"
                android:gravity="center"
                android:src="@drawable/icon_close_lock" />

            <TextView
                android:id="@+id/tv_lock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="10dp"
                android:gravity="center_vertical"
                android:text="已锁定"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_14" />

        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@color/bg_main_light_white"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp">

            <com.shmedo.mcloudapp.views.editspinner.EditSpinner
                android:id="@+id/editSpinner1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:Background="@drawable/bg_view_frame"
                app:hint="请输入工程项目名称关键字"
                app:maxLine="2" />

            <TextView
                android:id="@+id/tv_projectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:padding="5dp"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_15"
                android:visibility="gone" />
        </FrameLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/icon_state_setting" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:text="状态设置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/bluetooth_connect_layout"
            layout="@layout/device_config_switchview_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/device_enable_state_layout"
            layout="@layout/device_config_switchview_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/device_lock_state_layout"
            layout="@layout/device_config_switchview_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/debug_model_layout"
            layout="@layout/device_config_switchview_item3" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/sim_A_layout"
            layout="@layout/device_config_switchview_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/sim_B_layout"
            layout="@layout/device_config_switchview_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/icon_serson_setting" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:text="传感器设置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/switch_layout"
            layout="@layout/device_config_switchview_item3" />

        <LinearLayout
            android:id="@+id/llty_rain_break_alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_main_light_white"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:background="@color/white"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tv_rain_gauge"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:paddingLeft="50dp"
                android:text="雨量计配置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_14" />

            <LinearLayout
                android:id="@+id/llty_break_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/bg_main_light_white">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="50dp"
                        android:gravity="center"
                        android:text="断线报警器" />

                    <TextView
                        android:id="@+id/tv_break_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="10dp"
                        android:layout_toLeftOf="@id/sb_break_alarm"
                        android:gravity="center"
                        android:text="常闭"
                        android:textColor="@color/gray_807B7B" />

                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/sb_break_alarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="20dp"
                        app:kswAnimationDuration="100"
                        app:kswBackDrawable="@drawable/sl_switchbutton_back"
                        app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                        app:kswThumbHeight="22dp"
                        app:kswThumbRangeRatio="2"
                        app:kswThumbWidth="22dp" />

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/osmometer_config_layout"
            layout="@layout/device_config_switchview_item4" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/sensor_setting_layout"
            layout="@layout/device_config_choose_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RelativeLayout
            android:id="@+id/rl_mqtt_setting"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white">

            <ImageView
                android:id="@+id/iv_mqtt_setting"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/font_main" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_toRightOf="@id/iv_mqtt_setting"
                android:text="MQTT设置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:src="@drawable/icon_right" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RelativeLayout
            android:id="@+id/rl_general_setting"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="20dp"
            android:background="@color/bg_main_light_white">

            <ImageView
                android:id="@+id/iv_general_setting"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_toRightOf="@id/iv_general_setting"
                android:text="通用设置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:src="@drawable/icon_right" />

        </RelativeLayout>

    </LinearLayout>

</ScrollView>