                            android:hint="请输入"
                            android:inputType="number"
                            android:maxLength="3"
                            android:text="@={stateVM.rainfallGapTime}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
