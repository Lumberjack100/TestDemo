<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="RtlSymmetry">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.baseclickproxy.BaseClickProxy" />
    </data>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.MyApp.MaterialToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back_black"
        app:statusBarPadding="@{true}"
        app:subtitle=""
        app:subtitleTextColor="@color/sub_title_text_color"
        app:titleTextColor="@color/title_text_color"
        tools:title="配置">

        <FrameLayout
            visible="@{vm.toolbarIvActionVisible || vm.toolbarTvActionVisible}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="15dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_action"
                imageResId="@{vm.toolbarIvActionResId}"
                onClickWithDebouncing="@{()->click.onToolbarIvClick()}"
                visible="@{vm.toolbarIvActionVisible}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                tools:src="@drawable/ic_ble_connect"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_action"
                onClickWithDebouncing="@{()->click.onToolbarTvClick()}"
                visible="@{vm.toolbarTvActionVisible}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@{vm.toolbarTvActionText}"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_14"
                tools:text="编辑"
                tools:visibility="visible" />
        </FrameLayout>

    </com.google.android.material.appbar.MaterialToolbar>
</layout>