<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="RtlSymmetry">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.BaseClickProxy" />
    </data>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:theme="@style/AppTheme.AppBarOverlay"
        app:layout_scrollFlags="scroll|enterAlways"
        app:navigationIcon="@drawable/ic_navigation_black2"
        app:popupTheme="@style/AppTheme.PopupOverlay"
        app:titleTextAppearance="@style/Toolbar_TitleText"
        app:titleTextColor="@color/title_text_color"
        tools:title="消息">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="15dp">

            <ImageView
                android:id="@+id/iv_action"
                imageResId="@{vm.toolbarIvActionResId}"
                visible="@{vm.toolbarIvActionVisible}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{()->click.onToolbarIvClick()}"
                android:padding="5dp"
                tools:src="@drawable/ic_query_device_data"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_action"
                visible="@{vm.toolbarTvActionVisible}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="@{()->click.onToolbarTvClick()}"
                android:singleLine="true"
                android:text="@{vm.toolbarTvActionText}"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_15"
                tools:text="编辑"
                tools:visibility="visible" />

        </FrameLayout>

    </androidx.appcompat.widget.Toolbar>
</layout>