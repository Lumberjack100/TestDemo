<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/dimen_size_16"
        android:layout_marginEnd="@dimen/dimen_size_16"
        android:background="@drawable/bg_search_project_device_gray"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="13dp"
            android:src="@drawable/ic_search_project" />

        <TextView
            android:id="@+id/tv_search_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="设备SN搜索"
            android:textColor="#ffb3b3b3"
            android:textSize="@dimen/text_size_13" />

    </LinearLayout>

</FrameLayout>