<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.NetDeviceListFragment.ClickProxy" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_search_placeholder"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/dimen_size_16"
            android:layout_marginTop="@dimen/dimen_size_15"
            android:layout_marginEnd="@dimen/dimen_size_16"
            android:background="@drawable/bg_search_project_device_gray"
            android:gravity="center_vertical"
            android:onClick="@{() -> click.onGoToSearch()}">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="13dp"
                android:src="@drawable/ic_search_project" />

            <TextView
                android:id="@+id/tv_search_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="设备SN搜索"
                android:textColor="#ffb3b3b3"
                android:textSize="@dimen/text_size_13" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</layout>