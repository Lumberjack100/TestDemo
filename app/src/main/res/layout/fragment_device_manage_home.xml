<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.DeviceManageHomeViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.main.DeviceManageHomeFragment.ClickProxy" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:elevation="0dp">

            <View
                android:id="@+id/status_bar_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/white" />

            <RelativeLayout
                android:id="@+id/rl_company"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_size_12"
                android:layout_marginTop="@dimen/dimen_size_10">

                <com.google.android.material.textview.MaterialTextView
                    onClickWithDebouncing="@{(view)->click.showCompanySelectionPopupView(view)}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawablePadding="@dimen/dimen_size_12"
                    android:ellipsize="end"
                    android:ems="13"
                    android:maxLines="1"
                    android:paddingVertical="@dimen/dimen_size_3"
                    android:text="@{stateVM.companyName}"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_14"
                    android:textStyle="bold"
                    tools:text="新疆克力多铁矿选矿厂尾矿库在线监测" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_more"
                    onClickWithDebouncing="@{()->click.onMoreChooseClick()}"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_add_more" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingHorizontal="@dimen/dimen_size_12">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    app:tabGravity="center"
                    app:tabIndicatorColor="@color/transparent"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="0dp"
                    app:tabMode="fixed" />

            </RelativeLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

        </androidx.viewpager2.widget.ViewPager2>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
