<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <RelativeLayout style="@style/SwitchButton_LayoutStyle">

        <TextView
            style="@style/SwitchButton_TitleStyle"
            android:text="开启状态" />

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/centerEnableSBtn"
            style="@style/SwitchButton_ButtonStyle"
            app:kswAnimationDuration="100"
            app:kswBackDrawable="@drawable/sl_switchbutton_back"
            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
            app:kswThumbHeight="28dp"
            app:kswThumbRangeRatio="2"
            app:kswThumbWidth="28dp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据中心地址" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_data_server_address"
                style="@style/Common_EditItem_EditText_Style" />

        </LinearLayout>

        <LinearLayout style="@style/Common_EditItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据中心端口" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_data_server_port"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/ll_transfer_protocol"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="传输协议" />

            <TextView
                android:id="@+id/tv_transfer_protocol"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="MQTT" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_data_protocol"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据协议" />

            <TextView
                android:id="@+id/tv_data_protocol"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="RES_OUT" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_platform_type"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="平台类型" />

            <TextView
                android:id="@+id/tv_platform_type"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="地灾一期" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_mqtt_child_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="产品ID" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_product_id"
                    style="@style/Common_EditItem_EditText_Style" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="设备ID" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_device_id"
                    style="@style/Common_EditItem_EditText_Style" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="设备Key" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_device_key"
                    style="@style/Common_EditItem_EditText_Style" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="设备注册地址" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_device_register_address"
                    style="@style/Common_EditItem_EditText_Style" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="设备注册端口" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_device_register_port"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="设备注册码" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_device_register_code"
                    style="@style/Common_EditItem_EditText_Style" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_sl651_child_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/ll_station_classification"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="测站分类" />

                <TextView
                    android:id="@+id/tv_station_classification"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="P" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_center_station_addr"
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="中心站地址" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_center_station_addr"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_password"
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="密码" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_password"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_telemetry_station_addr"
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="测站编码" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_telemetry_station_addr"
                    style="@style/Common_EditItem_EditText_Style" />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rl_hourly_report"
                style="@style/SwitchButton_LayoutStyle">

                <TextView
                    style="@style/SwitchButton_TitleStyle"
                    android:text="小时报" />

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/hourlyReportEnableSBtn"
                    style="@style/SwitchButton_ButtonStyle"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_data_link_maintenance"
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="数据链路维持报(s)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_data_link_maintenance"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>


        </LinearLayout>

        <Button
            android:id="@+id/btn_confirm"
            style="@style/SubmitBordelessButtonStyle"
            android:text="保存" />

    </LinearLayout>

</LinearLayout>
