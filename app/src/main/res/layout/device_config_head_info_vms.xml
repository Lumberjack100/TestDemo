<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="15dp">

        <ImageView
            android:id="@+id/iv_device_logo"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/ic_device_logo_def" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxEms="10"
                    android:singleLine="true"
                    android:textColor="@color/text_color_1f1f1f"
                    android:textSize="@dimen/text_size_16"
                    tools:text="物联网数据采集器凤飞飞方法旺旺sss" />

                <TextView
                    android:id="@+id/tv_device_state_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_device_offline_state_flag"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:singleLine="true"
                    android:text="已断开"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_10" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_device_sn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="设备SN号：183123R" />

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="所属产品：DAS-V1.5-雷达物位采集器" />

            <TextView
                android:id="@+id/tv_firmware_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="固件版本：3.1.10_Q12" />

            <TextView
                android:id="@+id/tv_extended_field3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="运行状态：等待" />

            <TextView
                android:id="@+id/tv_platform_communication_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="米度平台连接状态：在线" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_device_connect_operate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:singleLine="true"
                android:textColor="@color/text_color_b3b3b3"
                android:textSize="@dimen/text_size_13"
                android:visibility="invisible"
                tools:text="断开连接"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/ll_scan_add_device"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:gravity="center_horizontal"
                android:visibility="visible"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_scan_device_code"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_scan_device_code" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:text="扫码添加"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_11" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider_line_bg_efefef" />

</LinearLayout>