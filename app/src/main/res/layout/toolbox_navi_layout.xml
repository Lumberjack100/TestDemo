<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#73F2F2F2"
        android:padding="@dimen/dimen_size_10"
        android:text="工具箱"
        android:textColor="@color/gray_807B7B"
        android:textSize="@dimen/text_size_18" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/testSpeedView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/dimen_size_10">

        <ImageView
            android:id="@+id/iv_test_speed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_toolbox_test_speed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_test_speed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_size_10"
            android:text="网络检测"
            android:textColor="@color/black_333333"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintLeft_toRightOf="@+id/iv_test_speed"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_test_speed_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测网络上传、下载速度及信号强度"
            android:textColor="@color/gray_797979"
            android:textSize="@dimen/text_size_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tv_test_speed_title"
            app:layout_constraintLeft_toRightOf="@+id/iv_test_speed"
            app:layout_constraintTop_toBottomOf="@+id/tv_test_speed_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/measureDistanceView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/dimen_size_10">

        <ImageView
            android:id="@+id/iv_measure_distance"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_toolbox_measure_distance"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_measure_distance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_size_10"
            android:text="测距"
            android:textColor="@color/black_333333"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintLeft_toRightOf="@+id/iv_measure_distance"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_measure_distance_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="地图上确定多个点，确定直线距离"
            android:textColor="@color/gray_797979"
            android:textSize="@dimen/text_size_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tv_measure_distance_title"
            app:layout_constraintLeft_toRightOf="@+id/iv_measure_distance"
            app:layout_constraintTop_toBottomOf="@+id/tv_measure_distance_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calculatedAreaView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/dimen_size_10">

        <ImageView
            android:id="@+id/iv_calculated_area"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_toolbox_maparea"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_calculated_area_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_size_10"
            android:text="面积计算"
            android:textColor="@color/black_333333"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintLeft_toRightOf="@+id/iv_calculated_area"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_calculated_area_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="地图上确定多个点，计算出范围面积"
            android:textColor="@color/gray_797979"
            android:textSize="@dimen/text_size_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tv_calculated_area_title"
            app:layout_constraintLeft_toRightOf="@+id/iv_calculated_area"
            app:layout_constraintTop_toBottomOf="@+id/tv_calculated_area_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/compassView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/dimen_size_10">

        <ImageView
            android:id="@+id/iv_compass"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_toolbox_compass"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_compass_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_size_10"
            android:text="指南针"
            android:textColor="@color/black_333333"
            android:textSize="@dimen/text_size_16"
            app:layout_constraintLeft_toRightOf="@+id/iv_compass"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_compass_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测网络上传、下载速度及信号强度"
            android:textColor="@color/gray_797979"
            android:textSize="@dimen/text_size_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/tv_compass_title"
            app:layout_constraintLeft_toRightOf="@+id/iv_compass"
            app:layout_constraintTop_toBottomOf="@+id/tv_compass_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>

