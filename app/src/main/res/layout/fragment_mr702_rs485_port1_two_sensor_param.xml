                            android:hint="请输入"
                            android:text="@={stateVM.initialTemperatureT0}"
                            app:lengthFilter="@{20}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
