<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gray_f2f2f2"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar_primary_bg" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_15"
                android:background="@drawable/bg_corner_10dp_white"
                android:orientation="vertical"
                android:paddingTop="@dimen/dimen_size_20"
                android:paddingBottom="@dimen/dimen_size_30">

                <LinearLayout style="@style/UserInfo_LinearLayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="企业名称"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/tv_companyName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:maxLines="1"
                        android:textColor="@color/gray_818182"
                        android:textSize="@dimen/text_size_15"
                        tools:text="上海米度测控科技有限公司" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:background="@color/gray_f2f2f2"
                    android:visibility="gone" />

                <LinearLayout
                    style="@style/UserInfo_LinearLayoutStyle"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="企业性质"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/tv_companyType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:maxLines="1"
                        android:textColor="@color/gray_818182"
                        android:textSize="@dimen/text_size_16"
                        tools:text="私营企业" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:background="@color/gray_f2f2f2" />

                <LinearLayout style="@style/UserInfo_LinearLayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="所属行业"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/tv_IndustryName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:maxLines="1"
                        android:textColor="@color/gray_818182"
                        android:textSize="@dimen/text_size_15"
                        tools:text="互联网科技" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:background="@color/gray_f2f2f2" />

                <LinearLayout style="@style/UserInfo_LinearLayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="联系电话"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/tv_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:maxLines="1"
                        android:textColor="@color/gray_818182"
                        android:textSize="@dimen/text_size_16"
                        tools:text="021-33923627" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:background="@color/gray_f2f2f2" />

                <LinearLayout style="@style/UserInfo_LinearLayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="企业地址"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/tv_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_size_15"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:maxLines="2"
                        android:textColor="@color/gray_818182"
                        android:textSize="@dimen/text_size_16"
                        tools:text="上海市闵行区联航路1188号32号楼5层" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:background="@color/gray_f2f2f2" />

                <LinearLayout
                    android:id="@+id/websiteLayout"
                    style="@style/UserInfo_LinearLayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="企业官网"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/tv_website"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dimen_size_15"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="right"
                        android:maxLines="2"
                        android:textColor="@color/app_color_theme_6"
                        android:textSize="@dimen/text_size_16"
                        tools:text="www.shmedo.cn" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:background="@color/gray_f2f2f2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:layout_marginTop="@dimen/dimen_size_15"
                    android:text="企业简介"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:id="@+id/tv_companyIntro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:layout_marginTop="@dimen/dimen_size_10"
                    android:layout_marginEnd="@dimen/dimen_size_20"
                    android:textColor="@color/gray_818182"
                    android:textSize="@dimen/text_size_16"
                    tools:text="@string/company_intro" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>
</LinearLayout>