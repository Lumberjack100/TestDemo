<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_corner_10dp_white"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <include layout="@layout/bottom_dialog_header" />

    <FrameLayout
        android:id="@+id/search_layout_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/search_placeholder"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_project_device_gray"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="13dp"
                android:src="@drawable/ic_search_project" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="设备SN搜索"
                android:textColor="#ffb3b3b3"
                android:textSize="@dimen/text_size_13" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_project_device_gray"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="13dp"
                    android:src="@drawable/ic_search_project" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_keywords"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索设备"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:textColor="@color/search_input_text_color"
                    android:textColorHint="@color/search_hint_text_color"
                    android:textSize="@dimen/text_size_13" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_cancel_search"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:layout_marginStart="13dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="取消"
                android:textColor="@color/blue_52B4F8"
                android:textSize="@dimen/text_size_15" />

        </LinearLayout>

    </FrameLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:splitMotionEvents="false"
        android:paddingStart="15dp"
        android:paddingRight="15dp"
        android:paddingBottom="15dp" />

</LinearLayout>