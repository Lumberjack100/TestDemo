<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/activity_custom_toolbar" />

    <LinearLayout
        android:id="@+id/ll_reset_data"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:gravity="center_vertical"
        android:paddingStart="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="恢复出厂设置" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_restart_system"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:gravity="center_vertical"
        android:paddingStart="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="重启系统" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_modify_authorization"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:paddingStart="25dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="修改授权码" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_right" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_product_register"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:paddingStart="25dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="产品注册" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_right" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:paddingStart="25dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="固件升级" />

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/sw_firmware_upgrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:kswAnimationDuration="100"
            app:kswBackDrawable="@drawable/sl_switchbutton_back"
            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
            app:kswThumbHeight="22dp"
            app:kswThumbRangeRatio="2"
            app:kswThumbWidth="22dp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_instruction_debug"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:paddingStart="25dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="指令交互调试模式" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_right" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_log_print"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:paddingStart="25dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="指令日志输出" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_right" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_sync_position"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:paddingStart="25dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="同步安装位置" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_right" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="1dp"
        android:background="@color/bg_main_light_white"
        android:gravity="center_vertical"
        android:paddingStart="25dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tv_config_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_15"
            android:text="调试模式" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@color/white">

            <Spinner
                android:id="@+id/sp_debug_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:dropDownVerticalOffset="30dp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>