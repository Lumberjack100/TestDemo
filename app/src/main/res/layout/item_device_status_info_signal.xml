<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.device.model.DeviceStatusInfoSignalItem" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        style="@style/DeviceCurrentState_SingleItem_Style"
        android:background="@drawable/layer_common_click_item_with_divider">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/DeviceCurrentState_SingleItem_NameStyle"
            android:text='@{m.name}'
            tools:text="4G信号强度" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_4g_signal_strength"
            style="@style/DeviceCurrentState_SingleItem_ValueStyle"
            android:text='@{m.signalValue==0?"--dBm":m.signalValue+"dBm" }'
            tools:text="-51dBm" />

        <com.shmedo.mcloudapp.common.widget.SignalView
            android:id="@+id/signal"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            app:bind_signal_value="@{m.signalValue}"
            app:connected="true"
            app:primary_color="@color/text_color_cccccc"
            app:shadow_color="@color/text_color_3AD094"
            app:shadow_open="false"
            app:signal_maximum="4"
            app:spacing="1"
            app:unit_width="8" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>