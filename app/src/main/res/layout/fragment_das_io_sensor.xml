<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.DasIOSensorViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.collector_product.fragment.das.DasIOSensorFragment.ClickProxy" />

    </data>

    <com.drake.brv.PageRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_content_container_padding_horizontal_12"
            android:paddingTop="@dimen/page_content_container_padding_top_12"
            android:paddingBottom="@dimen/page_content_container_padding_bottom_100">

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Common_ClickableItem_Layout_Style"
                onClickWithDebouncing="@{()->click.onModeChooseClick()}"
                android:background='@{stateVM.mode.contains("关闭")?@drawable/bg_white_corner_4dp:@drawable/layer_common_click_item_top_corner_4_with_divider}'>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Common_ClickableItem_Title_Style"
                    android:text="工作模式" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Common_ClickableItem_Value_Style"
                    android:text="@{stateVM.mode}"
                    tools:text="关闭" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Common_ClickableItem_Layout_Style"
                visible='@{stateVM.mode.contains("雨量计")}'
                android:background="@drawable/layer_common_click_item_with_divider"
                android:onClick="@{()->click.onChooseResolutionClick()}">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Common_ClickableItem_Title_Style"
                    android:text="雨量计分辨率（毫米）" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_rain_resolution"
                    style="@style/Common_ClickableItem_Value_Style"
                    android:text="@{stateVM.rainResolution}"
                    tools:text="0.1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Common_ClickableItem_Layout_Style"
                visible='@{stateVM.supportDumpMInTime &amp;&amp; stateVM.mode.contains("雨量计")}'
                android:background="@drawable/layer_common_click_item_with_divider">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Common_ClickableItem_Title_Style"
                    android:text="翻斗翻转最小间隔（秒）" />

                <com.shmedo.mcloudapp.ui.widget.ClearEditText
                    style="@style/Common_EditItem_EditText_Style"
                    android:hint="请输入"
                    android:inputType="number"
                    android:text="@={stateVM.dumpMinTime}"
                    app:lengthFilter="@{6}" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/Common_ClickableItem_Layout_Style"
                onClickWithDebouncing="@{()->click.onBreakAlarmModeChooseClick()}"
                visible='@{stateVM.mode.contains("断线报警器")}'
                android:background="@drawable/shape_common_click_item_bottom_corner_4">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Common_ClickableItem_Title_Style"
                    android:text="断线报警器" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Common_ClickableItem_Value_Style"
                    android:text="@{stateVM.breakAlarmMode}"
                    tools:text="常开" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                style="@style/ResetButton_Style"
                android:layout_marginTop="@dimen/reset_button_margin_top_50"
                android:onClick="@{()->click.onResetButtonClick()}"
                android:text="@string/button_reset_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                style="@style/SubmitButton_Style2"
                onClickWithDebouncing="@{()->click.onSubmitButtonClick()}"
                android:layout_marginTop="@dimen/summit_button_margin_top_20"
                android:enabled="@{stateVM.isDataModified}"
                android:text="@string/button_save_text" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.drake.brv.PageRefreshLayout>
</layout>