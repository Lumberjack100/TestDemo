<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.core.model.BuiltinCommandInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_corner_4dp"
        android:elevation="@dimen/dimen_size_2"
        android:foreground="?attr/selectableItemBackground"
        android:paddingHorizontal="@dimen/dimen_size_10"
        android:paddingVertical="@dimen/dimen_size_10">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_select"
            visible="@{m.cbVisibility}"
            android:checked="@{m.checked}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_size_15"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:checked="true" />

        <!-- 指令分类标签 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_category"
            drawable_radius="@{2}"
            drawable_solidColor="@{@color/colorPrimary}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimen_size_3"
            android:paddingVertical="@dimen/dimen_size_2"
            android:text="@{m.category}"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_9"
            app:layout_constraintStart_toEndOf="@+id/cb_select"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@color/colorPrimary"
            tools:text="通用指令" />

        <!-- 指令名称 -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_size_4"
            android:layout_marginEnd="@dimen/dimen_size_8"
            android:text="@{m.name}"
            android:textColor="@color/title_text_color"
            android:textSize="@dimen/text_size_13"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_send"
            app:layout_constraintStart_toStartOf="@id/tv_category"
            app:layout_constraintTop_toBottomOf="@id/tv_category"
            tools:text="获取设备状态" />

        <!-- 指令内容 -->
        <TextView
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_size_4"
            android:layout_marginEnd="@dimen/dimen_size_8"
            android:text="@{m.content}"
            android:textColor="@color/sub_title_text_color"
            android:textSize="@dimen/text_size_12"
            app:layout_constraintEnd_toStartOf="@id/btn_send"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="$cmd=getstatus" />

        <!-- 发送按钮 -->
        <com.google.android.material.button.MaterialButton
            visible="@{!m.cbVisibility}"
            android:id="@+id/btn_send"
            style="@style/Common_MaterialButton_Style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimen_size_10"
            android:paddingVertical="@dimen/dimen_size_5"
            android:text="发送"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_13"
            app:backgroundTint="@drawable/submit_button_background_tint"
            app:cornerRadius="@dimen/dimen_size_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout> 