<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"
            android:background="@color/white"
            >
            <ImageView
                android:layout_width="89dp"
                android:layout_height="89dp"
                android:src="@drawable/icon_device_logo"
                android:layout_marginLeft="10dp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设备名称："
                        android:textColor="@color/app_color_blue"
                        android:textSize="14dp"
                        />
                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="物联网数据采集器"
                        android:textColor="@color/app_color_blue"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设备编号："
                        android:textColor="@color/app_color_blue"
                        />
                    <TextView
                        android:id="@+id/tv_device_sn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="183123R"
                        android:textColor="@color/app_color_blue"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="功能型号："
                        android:textColor="@color/app_color_blue"
                        />
                    <TextView
                        android:id="@+id/tv_device_model"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAS"
                        android:textColor="@color/app_color_blue"
                        />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="传感器类型："
                        android:textColor="@color/app_color_blue"
                        />
                    <TextView
                        android:id="@+id/tv_sensor_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="拉线位移计"
                        android:textColor="@color/app_color_blue"
                        />
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="#a6a6a6" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/bg2_light_white"
            android:layout_gravity="center_vertical"
            >
            <ImageView
                android:id="@+id/iv_pro"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_project"
                android:layout_marginLeft="16dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="分配到项目"
                android:textSize="18sp"
                android:layout_toRightOf="@id/iv_pro"
                android:layout_marginLeft="5dp"
                android:gravity="center_vertical"
                />
            <ImageView
                android:id="@+id/iv_lock"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toLeftOf="@id/tv_lock"
                android:gravity="center"
                android:layout_centerVertical="true"
                />
            <TextView
                android:id="@+id/tv_lock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="已锁定"
                android:layout_alignParentRight="true"
                android:gravity="center_vertical"
                android:layout_marginRight="15dp"
                android:layout_marginLeft="15dp"
                android:textColor="@color/colorPrimary"
                />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="1dp"
            android:background="@color/bg2_light_white"
            android:orientation="horizontal"
            >
            <EditText
                android:id="@+id/et_query"
                android:layout_width="0dp"
                android:layout_weight="9"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:hint="请输入工程项目名称关键字"/>
            <TextView
                android:id="@+id/tv_query"
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:layout_height="match_parent"
                android:text="搜索"
                android:background="@color/colorPrimary"
                android:textColor="@color/white"
                android:layout_marginRight="10dp"
                android:gravity="center"
                />
        </LinearLayout>
        <Spinner
            android:id="@+id/sp_project_name"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingLeft="15dp"
            android:gravity="center_vertical"
            android:layout_marginTop="1dp"
            android:textSize="16sp"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_state_setting"
                android:layout_marginLeft="16dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="状态设置"
                android:textSize="18sp"
                android:layout_toRightOf="@id/iv_pro"
                android:layout_marginLeft="5dp"
                android:gravity="center_vertical"
                />

        </LinearLayout>
       <!-- <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="蓝牙连接状态"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/tv_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_marginRight="10dp"
                android:textColor="@color/colorPrimary"
                android:layout_toLeftOf="@id/sw_bluetooth"
                android:text="已连接"/>
            <Switch
                android:id="@+id/sw_bluetooth"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="20dp"
                android:layout_alignParentRight="true"
                android:gravity="center"/>

        </RelativeLayout>-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="设备启用状态"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/tv_device_state"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/sw_device_state"
                android:textColor="@color/colorPrimary"
                android:text="已激活"/>
            <ch.ielse.view.SwitchView
                android:id="@+id/sw_device_state"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginRight="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:gravity="center"/>

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="设备锁定状态"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />

            <TextView
                android:id="@+id/tv_device_luck_state"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/sw_device_luck_state"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:text="已锁定"/>
            <ch.ielse.view.SwitchView
                android:id="@+id/sw_device_luck_state"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:gravity="center"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="调试模式"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />
            <Spinner
                android:id="@+id/sp_debug"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/sw_debug"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:background="@color/white"
                />
            <ch.ielse.view.SwitchView
                android:id="@+id/sw_debug"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:gravity="center"/>

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="SIM卡A功能"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/tv_sim_1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text=" "
                android:gravity="center"
                android:layout_marginRight="20dp"
                android:layout_toLeftOf="@id/tv_sim_A"
                />

            <TextView
                android:id="@+id/tv_sim_A"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/sw_sim_A"
                android:gravity="center"
                android:text="AUTO"/>
            <ch.ielse.view.SwitchView
                android:id="@+id/sw_sim_A"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:gravity="center"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="SIM卡B功能"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/tv_sim_2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text=" "
                android:gravity="center"
                android:layout_marginRight="20dp"
                android:layout_toLeftOf="@id/tv_sim_B"
                />

            <TextView
                android:id="@+id/tv_sim_B"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/sw_sim_B"
                android:gravity="center"
                android:text="AUTO"/>
            <ch.ielse.view.SwitchView
                android:id="@+id/sw_sim_B"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:gravity="center"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_serson_setting"
                android:layout_marginLeft="16dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="传感器设置"
                android:textSize="18sp"
                android:layout_toRightOf="@id/iv_pro"
                android:layout_marginLeft="5dp"
                android:gravity="center_vertical"
                />

        </LinearLayout>


        <RelativeLayout
            android:id="@+id/rl_sensor_setting"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="传感器参数配置"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />
            <ImageView
                android:id="@+id/sw_sensor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="20dp"
                android:src="@drawable/icon_right"
                android:layout_alignParentRight="true"
                android:gravity="center"/>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_general_setting"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp">
            <ImageView
                android:id="@+id/iv_general_setting"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:src="@drawable/icon_general_setting"
                android:layout_marginLeft="16dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="通用设置"
                android:textSize="18sp"
                android:layout_toRightOf="@id/iv_general_setting"
                android:layout_marginLeft="5dp"
                android:gravity="center_vertical"
                />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="20dp"
                android:src="@drawable/icon_right"
                android:layout_alignParentRight="true"
                android:gravity="center"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="雨量计功能"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />

            <TextView
                android:id="@+id/tv_rain_config"
                android:layout_width="50dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/sw_rain"

                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center_vertical|center_horizontal"
                 />
            <ch.ielse.view.SwitchView
                android:id="@+id/sw_rain"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:gravity="center"/>

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg2_light_white"
            android:layout_marginTop="1dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="渗压计功能"
                android:layout_marginLeft="30dp"
                android:gravity="center"
                />

            <TextView
                android:id="@+id/tv_osmometer_config"
                android:layout_width="50dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/sw_osmometer"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center_vertical|center_horizontal"/>
            <ch.ielse.view.SwitchView
                android:id="@+id/sw_osmometer"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="20dp"
                android:layout_centerVertical="true"
                android:gravity="center"/>
        </RelativeLayout>

    </LinearLayout>
</ScrollView>