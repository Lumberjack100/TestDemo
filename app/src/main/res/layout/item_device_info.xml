<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.lib.core.base.model.DeviceInfo" />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:focusable="true"
        android:foreground="?android:selectableItemBackground"
        app:cardCornerRadius="3dp"
        app:cardElevation="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_size_10"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_device_state_flag"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginBottom="@dimen/dimen_size_8"
                android:background="@{m.onlineStatus?@drawable/bg_device_online_state_flag2:@drawable/bg_device_offline_state_flag2}"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@{m.onlineStatus?@string/device_online:@string/device_offline}"
                android:textColor="@{m.onlineStatus?@color/device_online_foreground:@color/device_offline_foreground}"
                android:textSize="@dimen/text_size_10"
                tools:background="@drawable/bg_device_offline_state_flag"
                tools:text="在线"
                tools:textColor="@color/device_offline_foreground" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_device_sn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="2"
                android:text='@{m.deviceToken==""?m.deviceSn:m.deviceToken}'
                android:textColor="@{m.onlineStatus?@color/title_text_color:@color/text_color_b3b3b3}"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold"
                tools:text="19D95B"
                tools:textColor="@color/title_text_color" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_10"
                android:gravity="center_vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_battery"
                    android:layout_width="26dp"
                    android:layout_height="15dp"
                    android:src="@{m.onlineStatus?@drawable/ic_battery_full_online:@drawable/ic_battery_full_offline}"
                    tools:src="@drawable/ic_battery_default" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_battery_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="100%"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_14" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="@dimen/dimen_size_10"
                android:layout_marginBottom="@dimen/dimen_size_10"
                android:background="@color/divider_line_bg2" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="类型:"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_device_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_8"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@{m.productName}"
                    android:textColor="@{m.onlineStatus?@color/title_text_color:@color/text_color_b3b3b3}"
                    android:textSize="@dimen/text_size_13"
                    tools:text="智能声光报警器专业监测设备"
                    tools:textColor="@color/title_text_color" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
</layout>