<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_corner_3dp_white"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingBottom="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_device_sn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="left"
            android:singleLine="true"
            android:textColor="@color/title_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="19D95B" />

        <ImageView
            android:id="@+id/iv_signal"
            android:layout_width="15dp"
            android:layout_height="13dp"
            android:layout_marginStart="10dp"
            tools:src="@drawable/ic_signal_default" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_battery"
            android:layout_width="26dp"
            android:layout_height="15dp"
            tools:src="@drawable/ic_battery_default" />

        <TextView
            android:id="@+id/tv_battery_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textColor="@color/sub_title_text_color"
            android:textSize="16sp"
            tools:text="67%" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="13dp"
        android:background="@color/divider_line_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="类型"
            android:textColor="@color/sub_title_text_color"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_device_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/title_text_color"
            android:textSize="13sp"
            tools:text="DAS" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="传感器"
            android:textColor="@color/sub_title_text_color"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_sensor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/title_text_color"
            android:textSize="13sp"
            tools:text="物位计 x1" />

    </LinearLayout>

</LinearLayout>