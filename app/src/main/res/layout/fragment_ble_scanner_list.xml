<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.BleScannerListViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.BleScannerListFragment.ClickProxy" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_search_layout"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="@dimen/dimen_size_16"
            android:layout_marginTop="@dimen/dimen_size_10"
            android:background="@drawable/bg_search_project_device_gray"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="13dp"
                android:src="@drawable/ic_search_project" />

            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                android:id="@+id/et_keywords"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索设备"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:text="@={vm.keyWords}"
                android:textColor="@color/title_text_color"
                android:textColorHint="@color/text_color_b3b3b3"
                android:textSize="@dimen/text_size_13" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            visible="@{!vm.bluetoothMissPermission &amp;&amp; !vm.bluetoothDisabled &amp;&amp; !vm.bluetoothMissPermission}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_search_layout">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_device"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="@dimen/dimen_size_15"
                android:splitMotionEvents="false"
                tools:listitem="@layout/item_ble_device" />

        </com.drake.brv.PageRefreshLayout>

        <include
            android:id="@+id/bluetooth_miss_permission"
            layout="@layout/info_bluetooth_miss_permission"
            visible="@{vm.bluetoothMissPermission}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:click="@{click}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/bluetooth_disabled"
            layout="@layout/info_bluetooth_disabled"
            visible="@{vm.bluetoothDisabled}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:click="@{click}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>