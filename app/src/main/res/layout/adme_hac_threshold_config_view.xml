<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingStart="16.5dp"
        android:text="电压阈值参数配置"
        android:textColor="@color/sub_title_text_color"
        android:textSize="@dimen/text_size_15" />

    <LinearLayout
        android:id="@+id/ll_drive_standard_voltage_threshold"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="驱动器标压阈值" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_drive_standard_voltage_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_drive_low_voltage_threshold"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="驱动器低压阈值" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_drive_low_voltage_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_drive_under_voltage_threshold"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="驱动器欠压阈值" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_drive_under_voltage_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_inclinometer_standard_voltage_threshold"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测斜仪标压阈值" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_inclinometer_standard_voltage_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_inclinometer_low_voltage_threshold"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测斜仪低压阈值" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_inclinometer_low_voltage_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_inclinometer_under_voltage_threshold"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测斜仪欠压阈值" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_inclinometer_under_voltage_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_first_level_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="16.5dp"
            android:text="一级预警设置"
            android:textColor="@color/red"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:id="@+id/ll_first_level_x_axis_min"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="X轴相对位移量最小值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_first_level_x_axis_min"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_first_level_x_axis_max"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="X轴相对位移量最大值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_first_level_x_axis_max"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_first_level_y_axis_min"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="Y轴相对位移量最小值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_first_level_y_axis_min"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_first_level_y_axis_max"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="Y轴相对位移量最大值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_first_level_y_axis_max"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_add_second_level"
            style="@style/SubmitBordelessButtonStyle"
            android:layout_width="200dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_gravity="center_horizontal"
            android:text="添加二级预警" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_second_level_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="16.5dp"
            android:text="二级预警设置"
            android:textColor="@color/red"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:id="@+id/ll_second_level_x_axis_min"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="X轴相对位移量最小值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_second_level_x_axis_min"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_second_level_x_axis_max"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="X轴相对位移量最大值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_second_level_x_axis_max"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_second_level_y_axis_min"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="Y轴相对位移量最小值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_second_level_y_axis_min"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_second_level_y_axis_max"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="Y轴相对位移量最大值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_second_level_y_axis_max"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_add_third_level"
            style="@style/SubmitBordelessButtonStyle"
            android:layout_width="200dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="添加三级预警" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_third_level_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="16.5dp"
            android:text="三级预警设置"
            android:textColor="@color/red"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:id="@+id/ll_third_level_x_axis_min"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="X轴相对位移量最小值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_third_level_x_axis_min"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_third_level_x_axis_max"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="X轴相对位移量最大值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_third_level_x_axis_max"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_third_level_y_axis_min"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="Y轴相对位移量最小值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_third_level_y_axis_min"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_third_level_y_axis_max"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="Y轴相对位移量最大值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_third_level_y_axis_max"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <Button
        android:id="@+id/btn_confirm"
        style="@style/SubmitBordelessButtonStyle"
        android:text="保存" />

</LinearLayout>