                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/sw_stay1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="16dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="16dp" />

                <TextView
                    android:id="@+id/tv_stay1"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="5dp"
                    android:background="@color/secondary_text"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="已停用"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

