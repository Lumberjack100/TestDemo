<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/sensor_item"
    android:layout_height="50dp"
    android:orientation="horizontal"
    android:background="@color/white">

        <TextView
            android:id="@+id/tv_deviceStatus"
            android:layout_width="25dp"
            android:layout_height="20dp"
            android:background="@color/bg2_light_white"
            android:layout_marginLeft="8dp"
            android:text="E60"
            android:textSize="12sp"
            android:gravity="center"
            />
        <TextView
            android:id="@+id/tv_deviceToken"
            android:layout_weight="1.5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="18A095L"
            android:gravity="center_vertical|center_horizontal"/>
        <LinearLayout
            android:id="@+id/ll_SensorType"
            android:layout_weight="3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical|center_horizontal">
                <ImageView
                    android:id="@+id/img_sensor_type_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/medo_icon_sensortype_0"

                    />
                <ImageView
                    android:id="@+id/img_sensor_type_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/medo_icon_sensortype_0"
                    android:layout_marginLeft="5dp"
                    />
                <ImageView
                    android:id="@+id/img_sensor_type_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/medo_icon_sensortype_0"
                    android:layout_marginLeft="5dp"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:layout_marginLeft="5dp"
                    />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_electricity"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="电量"
            android:gravity="center_vertical|center_horizontal"/>
        <TextView
            android:id="@+id/tv_gprs"
            android:layout_weight="2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="数据量(KB)"
            android:gravity="center_vertical|center_horizontal"/>
        <TextView
            android:id="@+id/tv_signal"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="信号"
            android:gravity="center_vertical|center_horizontal"/>

</LinearLayout>