<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.AdmeHacMeasuringDataProcedureViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.hac.fragment.AdmeHacMeasuringDataProcedureFragment.ClickProxy" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_size_16">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/dimen_size_15"
            android:background="@color/divider_line_bg" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备运行状态:"
                android:textColor="@color/title_text_color"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_motorinfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_size_10"
                android:text="@{stateVM.motorInfo}"
                android:textColor="@color/orange"
                android:textSize="@dimen/text_size_14"
                tools:text="本轮测量已停止,预计 10 分钟后可重新测量，本轮测量已停止,预计 10 分钟后可重新测量" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_size_20">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_inclinometer_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{stateVM.inclinometerBattery}"
                    android:textColor="@{stateVM.inclinometerBatteryColorRes}"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    tools:text="100%"
                    tools:textColor="@color/title_text_color" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_inclinometer_battery_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="测斜仪电量"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_14" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_device_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{stateVM.deviceBattery}"
                    android:textColor="@{stateVM.deviceBatteryColorRes}"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    tools:text="100%"
                    tools:textColor="@color/title_text_color" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_device_battery_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="设备电量"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_14" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_waiting_time"
                invisible="@{stateVM.isWaitTimeVisible}"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_waiting_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{stateVM.waittime}"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    tools:text="30分钟" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_waiting_time_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@{stateVM.waittimedesc}"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_14"
                    tools:text="测量结束倒计时" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btn_action"
            onClickWithDebouncing="@{()->click.onActionClick()}"
            visible="@{stateVM.isRunButtonVisible}"
            android:layout_width="160dp"
            android:layout_height="46dp"
            android:layout_marginVertical="@dimen/dimen_size_35"
            android:background='@{stateVM.runButtonText=="下一步"? @drawable/bg_btn_pause_motor_motion : @drawable/bg_btn_stop_measuring_data}'
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@{stateVM.runButtonText}"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_17"
            android:textStyle="bold"
            tools:background="@drawable/bg_btn_stop_measuring_data"
            tools:text="结束测量" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>