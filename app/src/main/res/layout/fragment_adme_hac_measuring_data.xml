<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.AdmeHacMeasuringDataViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.hac.fragment.AdmeHacMeasuringDataFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray"
        android:keepScreenOn="true">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dimen_size_50">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:layout_marginTop="@dimen/dimen_size_1"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:text="测斜仪Mac地址" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:hint="XXXXXXXXXXXX"
                            android:inputType="textCapCharacters"
                            android:maxLength="12"
                            android:text="@={stateVM.address}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="项目号" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="@dimen/dimen_size_130"
                            android:layout_height="44dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/project_num"
                                style="@style/MaterialAutoCompleteTextView_Style"
                                android:focusable="false"
                                android:hint="请选择"
                                android:inputType="none"
                                android:text="@{stateVM.projectNum}" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_project_num"
                            style="@style/TestButton_Style"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dimen_size_30"
                            android:layout_marginStart="@dimen/dimen_size_8"
                            android:minWidth="0dp"
                            android:onClick="@{(view)->click.onEditNumberClick(view)}"
                            android:paddingHorizontal="@dimen/dimen_size_8"
                            android:text="编辑"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="区号" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="@dimen/dimen_size_130"
                            android:layout_height="44dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/area_num"
                                style="@style/MaterialAutoCompleteTextView_Style"
                                android:focusable="false"
                                android:hint="请选择"
                                android:inputType="none"
                                android:text="@{stateVM.areaNum}"
                                tools:text="A001" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_area_num"
                            style="@style/TestButton_Style"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dimen_size_30"
                            android:layout_marginStart="@dimen/dimen_size_8"
                            android:minWidth="0dp"
                            android:onClick="@{(view)->click.onEditNumberClick(view)}"
                            android:paddingHorizontal="@dimen/dimen_size_8"
                            android:text="编辑"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="孔号" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="@dimen/dimen_size_130"
                            android:layout_height="44dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/hole_num"
                                style="@style/MaterialAutoCompleteTextView_Style"
                                android:focusable="false"
                                android:hint="请选择"
                                android:inputType="none"
                                android:text="@{stateVM.holeNum}"
                                tools:text="A001" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_hole_num"
                            style="@style/TestButton_Style"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dimen_size_30"
                            android:layout_marginStart="@dimen/dimen_size_8"
                            android:minWidth="0dp"
                            android:onClick="@{(view)->click.onEditNumberClick(view)}"
                            android:paddingHorizontal="@dimen/dimen_size_8"
                            android:text="编辑"
                            android:textStyle="bold" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="实测测斜管孔深（米）" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Value_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:drawableEnd="@null"
                            android:text="@{stateVM.realHoleDepth }"
                            tools:text="10" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:text="推荐测斜管孔深（米）" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="@={stateVM.recommendHoleDepth}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{5}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:text="下放等待时间（秒）" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:hint="数值范围[30-86400]"
                            android:inputType="number"
                            android:text="@={stateVM.decentralizationWaitingTime}"
                            app:lengthFilter="@{5}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_Layout_Style"
                        onClickWithDebouncing="@{()->click.onDataSettlementMethodClick()}"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isEditable }">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="数据解算方式" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Value_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.dataSettlementMethod }"
                            tools:text="顶部固定法" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <RelativeLayout
                        style="@style/SwitchButton_Item_Layout_Style"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SwitchButton_Item_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="仅用单向测量" />

                        <com.kyleduo.switchbutton.SwitchButton
                            android:id="@+id/switch_single_way"
                            style="@style/SwitchButton_Item_Button_Style"
                            checkedImmediatelyNoEvent="@{stateVM.isSingleWayTest}"
                            android:enabled="@{stateVM.isEditable}"
                            android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                            app:kswAnimationDuration="100"
                            app:kswBackDrawable="@drawable/sl_switchbutton_back"
                            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                    </RelativeLayout>

                    <RelativeLayout
                        style="@style/SwitchButton_Item_Layout_Style"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SwitchButton_Item_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="测斜仪反转自检" />

                        <com.kyleduo.switchbutton.SwitchButton
                            android:id="@+id/switch_reverse"
                            style="@style/SwitchButton_Item_Button_Style"
                            checkedImmediatelyNoEvent="@{stateVM.isCheckReverse}"
                            android:enabled="@{stateVM.isEditable}"
                            android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                            app:kswAnimationDuration="100"
                            app:kswBackDrawable="@drawable/sl_switchbutton_back"
                            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />
                    </RelativeLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_run"
                        style="@style/SubmitButton_Style2"
                        onClickWithDebouncing="@{()->click.onRunClick()}"
                        android:layout_marginHorizontal="@dimen/dimen_size_20"
                        android:layout_marginTop="@dimen/reset_button_margin_top_50"
                        android:enabled="@{stateVM.isRunButtonEnable }"
                        android:text="@={stateVM.runButtonText}"
                        tools:text="正向测量" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>