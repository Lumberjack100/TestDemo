<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_corner_10dp_white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="34dp"
        android:paddingStart="15dp">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:foreground="?attr/selectableItemBackground"
            android:src="@drawable/ic_dispatch_cmd_dialog_close" />

        <TextView
            android:id="@+id/tv_clear_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="清除数据"
            android:textColor="@color/text_color_51B4F8"
            android:textSize="@dimen/text_size_17"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="数据运行"
            android:textColor="@color/title_text_color"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_corner_3dp_gray_f9f9f9"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="24dp"
            android:paddingEnd="10dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_data_left_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_motor_motion_pulse"
                android:drawablePadding="8dp"
                android:text="脉冲数(次)"
                android:textColor="@color/text_color_666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_motion_pulse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/title_text_color"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="2359482" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_corner_3dp_gray_f9f9f9"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="24dp"
            android:paddingEnd="10dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_motor_motion_distance"
                android:drawablePadding="8dp"
                android:text="运动距离(m)"
                android:textColor="@color/text_color_666666"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_motion_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/title_text_color"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="162345" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="34dp">

        <TextView
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_stop_motor_motion"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="停止"
            android:textColor="@color/title_text_color"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <TextView
            android:id="@+id/btn_exit"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_exit_motor_motion"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="退出"
            android:textColor="@color/title_text_color"
            android:textSize="17sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>