<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.youth.banner.Banner
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            app:banner_indicator_marginBottom="25dp"
            app:banner_indicator_normal_color="#6b6b6b"
            app:banner_indicator_selected_color="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:background="@drawable/bg_top_corner_10dp_white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_project_type" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="项目类型"
                        android:textColor="@color/text_color_gray_343434"
                        android:textSize="@dimen/text_size_15" />

                    <TextView
                        android:id="@+id/tv_project_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="@dimen/text_size_13"
                        tools:text="矿山" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_project_level" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="项目等级"
                        android:textColor="@color/text_color_gray_343434"
                        android:textSize="@dimen/text_size_15" />

                    <TextView
                        android:id="@+id/tv_project_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="@dimen/text_size_13"
                        tools:text="2级" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_project_create_time" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="创建时间"
                        android:textColor="@color/text_color_gray_343434"
                        android:textSize="@dimen/text_size_15" />

                    <TextView
                        android:id="@+id/tv_project_create_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="@dimen/text_size_13"
                        tools:text="2019.10.22" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center">

                <View
                    android:layout_width="28dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_line_bg_e1e1e1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="项目介绍"
                    android:textColor="@color/text_color_gray_343434"
                    android:textSize="@dimen/text_size_18" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="1dp"
                    android:background="@color/divider_line_bg_e1e1e1" />

            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tv_project_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="40dp"
                    android:textColor="@color/text_color_gray_343434"
                    android:textSize="@dimen/text_size_16"
                    tools:text="@string/project_desc_test" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/activity_support_actionbar_toolbar" />

</FrameLayout>