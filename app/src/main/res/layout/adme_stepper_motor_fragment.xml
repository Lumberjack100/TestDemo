<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <RelativeLayout style="@style/SwitchButton_LayoutStyle">

                <TextView
                    style="@style/SwitchButton_TitleStyle"
                    android:text="正反测使能" />


                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/paramEnableSBtn"
                    style="@style/SwitchButton_ButtonStyle"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/contentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="绝对精度修正值(p)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_accuracy_correction_value"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="步进电机运动速度(r/min)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_motor_movement_speed"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="number" />

                    </LinearLayout>

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="步进电机力矩" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_motor_torque"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="number" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="20dp" />

                    <Button
                        android:id="@+id/btn_confirm"
                        style="@style/SubmitBordelessButtonStyle"
                        android:text="保存" />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/maskLayerChild"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66ffffff"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                </RelativeLayout>

            </FrameLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/maskLayerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</androidx.core.widget.NestedScrollView>