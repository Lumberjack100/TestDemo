<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.user.viewmodel.state.MineViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.user.fragment.MineFragment.ClickProxy" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/status_bar_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/white"/>

            <RelativeLayout
                android:id="@+id/userLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:foreground="?attr/selectableItemBackground"
                android:onClick="@{()->click.onUpdateUserClick()}"
                android:padding="@dimen/dimen_size_20">

                <ImageView
                    android:id="@+id/userAvatar"
                    circleImageUrl="@{vm.imageUrl}"
                    placeHolder="@{vm.placeHolder}"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dimen_size_10"
                    android:src="@drawable/ic_account" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="15dp"
                    android:layout_toRightOf="@+id/userAvatar"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/userName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{vm.name}"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_18"
                        tools:text="张三丰" />

                    <TextView
                        android:id="@+id/userTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_size_7"
                        android:text="@{vm.title}"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_14"
                        tools:text="产品经理" />

                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_arrow_right" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/companyLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:layout_marginTop="@dimen/dimen_size_14"
                android:onClick="@{()->click.onCompanyClick()}">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_userinfo_company" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:text="所属企业"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:id="@+id/tv_companyName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/icon_arrow_right"
                    android:drawablePadding="@dimen/dimen_size_5"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:maxLines="1"
                    android:text="@{vm.company}"
                    android:textColor="@color/gray_818182"
                    android:textSize="@dimen/text_size_15"
                    tools:text="上海米度测控科技有限公司" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="18dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout
                android:id="@+id/updatePwdLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:onClick="@{()->click.onModifyPasswordClick()}">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_userinfo_setting" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:text="修改密码"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/icon_arrow_right"
                    android:drawablePadding="@dimen/dimen_size_5"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:maxLines="1"
                    android:textColor="@color/gray_818182"
                    android:textSize="@dimen/text_size_16" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/checkVersionLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:layout_marginTop="@dimen/dimen_size_14"
                android:onClick="@{()->click.onVersionCheckClick()}">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_userinfo_check_version" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:text="版本检测"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:id="@+id/tv_versionName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/icon_arrow_right"
                    android:drawablePadding="@dimen/dimen_size_5"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:maxLines="1"
                    android:text="@{vm.appVersion}"
                    android:textColor="@color/gray_818182"
                    android:textSize="@dimen/text_size_15"
                    tools:text="1.1.0" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="18dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout
                android:id="@+id/aboutLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:onClick="@{()->click.onAboutUsClick()}">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icon_userinfo_about" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:text="关于"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/icon_arrow_right"
                    android:drawablePadding="@dimen/dimen_size_5"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:maxLines="1"
                    android:textColor="@color/gray_818182"
                    android:textSize="@dimen/text_size_16" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/loginOutLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:onClick="@{()->click.logout()}">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="退出登录"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>