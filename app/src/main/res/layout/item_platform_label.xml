<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.device.model.PlatformLable" />
    </data>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_size_6"
            android:layout_marginBottom="@dimen/dimen_size_5"
            android:background="@{m.online ? @color/device_online_backround : @color/main_bg_gray_f2f2f2}"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@{m.name}"
            android:textColor="@{m.online ? @color/device_online_foreground : @color/text_color_666666}"
            android:textSize="13sp"
            tools:background="@color/device_online_backround"
            tools:text="全部"
            tools:textColor="@color/device_online_foreground" />

    </FrameLayout>

</layout>