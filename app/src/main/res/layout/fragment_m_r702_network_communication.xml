<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702NetworkCommunicationViewModel" />

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.MR702NetworkCommunicationFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:text="无线配置"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_17"
                        android:textStyle="bold" />

                    <RelativeLayout
                        style="@style/SwitchButton_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/SwitchButton_TitleStyle"
                            android:text="4G通信"
                            android:textColor="@{vm.isMobileEnable()?@color/title_text_color:@color/sub_title_text_color}" />

                        <com.kyleduo.switchbutton.SwitchButton
                            android:id="@+id/mobileCommunicationSB"
                            style="@style/SwitchButton_ButtonStyle"
                            android:enabled="@{vm.isMobileEnable()}"
                            android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                            app:kswAnimationDuration="100"
                            app:kswBackDrawable="@drawable/sl_switchbutton_back"
                            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                            app:kswThumbHeight="18dp"
                            app:kswThumbRangeRatio="2.3"
                            app:kswThumbWidth="18dp" />

                    </RelativeLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="APN接入点" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/apnNameET"
                            style="@style/Common_EditItem_EditText_Style"
                            android:text="@={vm.apnName}" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="用户名" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/userNameET"
                            style="@style/Common_EditItem_EditText_Style"
                            android:text="@{vm.userName}" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="密码" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/pwdET"
                            style="@style/Common_EditItem_EditText_Style"
                            android:text="@{vm.pwd}" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:text="以太网配置"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_17"
                        android:textStyle="bold" />

                    <RelativeLayout
                        style="@style/SwitchButton_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/SwitchButton_TitleStyle"
                            android:text="以太网接入" />

                        <com.kyleduo.switchbutton.SwitchButton
                            android:id="@+id/ethernetAccessSB"
                            style="@style/SwitchButton_ButtonStyle"
                            android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                            app:kswAnimationDuration="100"
                            app:kswBackDrawable="@drawable/sl_switchbutton_back"
                            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                            app:kswThumbHeight="18dp"
                            app:kswThumbRangeRatio="2.3"
                            app:kswThumbWidth="18dp" />

                    </RelativeLayout>

                    <LinearLayout
                        style="@style/Common_ClickableItem_LayoutStyle"
                        android:onClick="@{()->click.onIPModeSwitchClick()}"
                        android:enabled="@{vm.isEthernetEnable()}">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="IP分配" />

                        <TextView
                            android:id="@+id/tv_dhcp"
                            style="@style/Common_ClickableItem_ValueStyle"
                            android:drawableEnd="@null"
                            android:text="@{vm.ipMode}"
                            android:textSize="17sp"
                            tools:text="自动" />

                        <ImageView
                            android:id="@+id/ivExpand"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="@dimen/dimen_size_8"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_arrow_down" />

                    </LinearLayout>

                    <LinearLayout
                        visible="@{vm.isIPContentVisible}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                android:text="IP地址" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                android:id="@+id/ipET"
                                style="@style/Common_EditItem_EditText_Style"
                                android:text="@{vm.ip}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                android:text="子网掩码" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                android:id="@+id/subnetMaskET"
                                style="@style/Common_EditItem_EditText_Style"
                                android:text="@{vm.subnetMask}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                android:text="网关" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                android:id="@+id/gatewayET"
                                style="@style/Common_EditItem_EditText_Style"
                                android:text="@{vm.gateway}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                android:text="首选DNS" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                android:id="@+id/preferredDNSET"
                                style="@style/Common_EditItem_EditText_Style"
                                android:text="@{vm.preferredDNS}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                android:text="备用DNS" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                android:id="@+id/alternateDNSET"
                                style="@style/Common_EditItem_EditText_Style"
                                android:text="@{vm.alternateDNS}" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/maskLayerLayout"
                    visible="@{vm.isMaskVisible}"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/transparent"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>