<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702NetworkCommunicationViewModel" />

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.MR702NetworkCommunicationFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/dimen_size_25">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="无线配置"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold" />

                <RelativeLayout
                    style="@style/SwitchButton_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/SwitchButton_TitleStyle"
                        android:text="4G通信"
                        android:textColor="@{!vm.isWirelessDisabled&amp;&amp; vm.isEditable?@color/title_text_color:@color/sub_title_text_color}" />

                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/mobileCommunicationSB"
                        style="@style/SwitchButton_ButtonStyle"
                        android:enabled="@{!vm.isWirelessDisabled &amp;&amp; vm.isEditable}"
                        android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                        app:kswAnimationDuration="100"
                        app:kswBackDrawable="@drawable/sl_switchbutton_back"
                        app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                        app:kswThumbHeight="18dp"
                        app:kswThumbRangeRatio="2.3"
                        app:kswThumbWidth="18dp" />

                </RelativeLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{vm.isWirelessOpened}"
                        android:text="APN接入点"
                        tools:textColor="@color/title_text_color" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        android:id="@+id/apnNameET"
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{vm.isWirelessOpened}"
                        android:hint="请输入 (非必填)"
                        android:text="@={vm.apnName}"
                        app:isCharacterFilter="@{false}"
                        app:isNumberFilter="@{false}"
                        app:lengthFilter="@{20}" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{vm.isWirelessOpened}"
                        android:text="用户名" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        android:id="@+id/userNameET"
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{vm.isWirelessOpened}"
                        android:hint="请输入 (非必填)"
                        android:text="@={vm.userName}"
                        app:isCharacterFilter="@{false}"
                        app:isNumberFilter="@{false}"
                        app:lengthFilter="@{20}" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{vm.isWirelessOpened}"
                        android:text="密码" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        android:id="@+id/pwdET"
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{vm.isWirelessOpened}"
                        android:hint="请输入 (非必填)"
                        android:text="@={vm.pwd}"
                        app:isCharacterFilter="@{false}"
                        app:isNumberFilter="@{false}"
                        app:lengthFilter="@{20}" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="以太网配置"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold" />

                <RelativeLayout
                    style="@style/SwitchButton_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/SwitchButton_TitleStyle"
                        android:text="以太网接入"
                        android:textColor="@{vm.isEditable?@color/title_text_color:@color/sub_title_text_color}" />

                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/ethernetAccessSB"
                        style="@style/SwitchButton_ButtonStyle"
                        android:enabled="@{vm.isEditable}"
                        android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                        app:kswAnimationDuration="100"
                        app:kswBackDrawable="@drawable/sl_switchbutton_back"
                        app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                        app:kswThumbHeight="20dp"
                        app:kswThumbRangeRatio="2.3"
                        app:kswThumbWidth="18dp" />

                </RelativeLayout>

                <LinearLayout
                    style="@style/Common_ClickableItem_LayoutStyle"
                    android:enabled="@{vm.isEthernetOpened}"
                    android:onClick="@{()->click.onIPModeSwitchClick()}">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{vm.isEthernetOpened}"
                        android:text="IP分配" />

                    <TextView
                        android:id="@+id/tv_dhcp"
                        style="@style/Common_ClickableItem_ValueStyle"
                        textViewEnabled="@{vm.isEthernetOpened}"
                        android:drawableEnd="@null"
                        android:text="@{vm.ipMode}"
                        android:textSize="17sp"
                        tools:text="自动" />

                    <ImageView
                        android:id="@+id/ivExpand"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/dimen_size_8"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_arrow_down" />

                </LinearLayout>

                <LinearLayout
                    visible="@{vm.isManualVisible}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_size_8"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="IP地址" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/ipET"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="@={vm.ip}"
                            app:isCharacterFilter="@{false}"
                            app:isNumberFilter="@{false}"
                            app:lengthFilter="@{100}" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="子网掩码" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/subnetMaskET"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="@={vm.subnetMask}"
                            app:isCharacterFilter="@{false}"
                            app:isNumberFilter="@{false}"
                            app:lengthFilter="@{15}" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="网关" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/gatewayET"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="@={vm.gateway}"
                            app:isCharacterFilter="@{false}"
                            app:isNumberFilter="@{false}"
                            app:lengthFilter="@{15}" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="首选DNS" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/preferredDNSET"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="@={vm.preferredDNS}"
                            app:isCharacterFilter="@{false}"
                            app:isNumberFilter="@{false}"
                            app:lengthFilter="@{15}" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="备用DNS" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/alternateDNSET"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{vm.isEthernetOpened}"
                            android:text="@={vm.alternateDNS}"
                            app:isCharacterFilter="@{false}"
                            app:isNumberFilter="@{false}"
                            app:lengthFilter="@{15}" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onSubmitClick()}"
            visible="@{vm.isEditable &amp;&amp;(vm.isWirelessOpened || vm.isEthernetOpened)}"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="15dp"
            android:text="保存"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollView" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>