<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.UDWorkModelParamViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.u_product.fragment.ud.UDWorkModelParamFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="200dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        android:layout_marginTop="@dimen/dimen_size_1"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:onClick="@{()->click.onModelChooseClick()}">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="模式" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.model}"
                            tools:text="自动" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        visible='@{stateVM.model == "自动"}'
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            style="@style/SwitchButton_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SwitchButton_TitleStyle"
                                android:text="四级报警启用" />

                            <com.kyleduo.switchbutton.SwitchButton
                                style="@style/SwitchButton_ButtonStyle"
                                checkedImmediatelyNoEvent="@{stateVM.alarmEnable}"
                                android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                                app:kswAnimationDuration="100"
                                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                        </RelativeLayout>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.firstAlarmThresholdTitle}"
                                tools:text="一级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:text="@={stateVM.firstAlarmThreshold}"
                                app:inputTypeFilter='@{"numberDecimal"}'
                                app:lengthFilter="@{10}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.secondAlarmThresholdTitle}"
                                tools:text="二级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:text="@={stateVM.secondAlarmThreshold}"
                                app:inputTypeFilter='@{"numberDecimal"}'
                                app:lengthFilter="@{10}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.thirdAlarmThresholdTitle}"
                                tools:text="三级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:text="@={stateVM.thirdAlarmThreshold}"
                                app:inputTypeFilter='@{"numberDecimal"}'
                                app:lengthFilter="@{10}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.fourthAlarmThresholdTitle}"
                                tools:text="四级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:text="@={stateVM.fourthAlarmThreshold}"
                                app:inputTypeFilter='@{"numberDecimal"}'
                                app:lengthFilter="@{10}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        visible='@{stateVM.model == "手动"}'
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_ClickableItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:onClick="@{()->click.onReportFrequencyChooseClick()}">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                android:text="上报频率" />

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_ValueStyle"
                                android:drawableEnd="@drawable/ic_arrow_down"
                                android:text="@{stateVM.reportFrequency}"
                                tools:text="自动" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btn_reset"
            style="@style/ResetButton_ColorPrimary"
            visible='@{!(stateVM.model == "自动" &amp;&amp; !stateVM.alarmEnable)}'
            android:layout_marginTop="0dp"
            android:layout_marginBottom="35dp"
            android:onClick="@{()->click.onResetClick()}"
            android:text="@string/button_reset_text"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onSubmitButtonClick()}"
            visible='@{!(stateVM.model == "自动" &amp;&amp; !stateVM.alarmEnable)}'
            android:layout_marginTop="0dp"
            android:layout_marginBottom="55dp"
            android:text="@string/button_save_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>