<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.LoginViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.login.LoginActivity.ClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/login_top_bg"
        android:orientation="vertical">

        <View
            android:id="@+id/status_bar_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="35dp"
                android:layout_marginTop="64dp"
                android:layout_marginBottom="24dp"
                android:text="您好!\n欢迎来到米易通"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_27" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="211dp"
                android:layout_height="207dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-96dp"
                android:layout_marginEnd="-39dp"
                android:src="@drawable/login_top_right_bg" />

        </FrameLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="34dp"
            android:paddingEnd="34dp"
            app:drawable_radiusLT="@{24}"
            app:drawable_radiusRT="@{24}"
            app:drawable_solidColor="@{@color/white}">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_login_way_title_zh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@{vm.isAccountLogin?@string/login_way_account_zh:@string/login_way_phone_zh}"
                android:textColor="#2F3033"
                android:textSize="@dimen/text_size_18" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_login_way_title_en"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@{vm.isAccountLogin?@string/login_way_account_en:@string/login_way_phone_en}"
                android:textColor="#ABADB3"
                android:textSize="@dimen/text_size_13" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ll_account_login"
                    visible="@{vm.isAccountLogin}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="53dp"
                        android:background="@drawable/login_edittext_shape"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="23dp"
                            android:src="@drawable/icon_account" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            android:id="@+id/accountET"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="请输入账号"
                            android:imeOptions="actionNext"
                            android:maxLength="20"
                            android:singleLine="true"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            android:text="@={vm.account}"
                            android:textColor="@color/title_text_color"
                            android:textColorHint="@color/text_color_CCCCCC"
                            android:textSize="@dimen/text_size_18"
                            app:inputTypeFilter='@{"character"}' />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="53dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/login_edittext_shape"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="23dp"
                            android:src="@drawable/icon_pwd" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            android:id="@+id/passwordET"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="请输入密码"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLength="30"
                            android:singleLine="true"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            android:text="@={vm.password}"
                            android:textColor="@color/title_text_color"
                            android:textColorHint="@color/text_color_CCCCCC"
                            android:textSize="@dimen/text_size_18" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_eye_password"
                            onClickWithDebouncing="@{()->click.eyeClick()}"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="25dp"
                            android:src="@{vm.eyeOpen?@drawable/icon_eye_open:@drawable/icon_eye_close}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ll_phone_login"
                    visible="@{!vm.isAccountLogin}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:visibility="gone">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="53dp"
                        android:background="@drawable/login_edittext_shape"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="23dp"
                            android:src="@drawable/icon_phone" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            android:id="@+id/phoneET"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="请输入手机号"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="11"
                            android:paddingStart="10dp"
                            android:paddingEnd="20dp"
                            android:singleLine="true"
                            android:text="@={vm.phone}"
                            android:textColor="@color/title_text_color"
                            android:textColorHint="@color/text_color_CCCCCC"
                            android:textSize="@dimen/text_size_18" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="53dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/login_edittext_shape"
                        android:gravity="center_vertical">

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            android:id="@+id/codeET"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="请输入验证码"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="8"
                            android:singleLine="true"
                            android:paddingStart="25dp"
                            android:paddingEnd="20dp"
                            android:text="@={vm.code}"
                            android:textColor="@color/title_text_color"
                            android:textColorHint="@color/text_color_CCCCCC"
                            android:textSize="@dimen/text_size_18" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="19dp"
                            android:background="@color/text_color_CCCCCC" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_get_code"
                            onClickWithDebouncing="@{()->click.onGetCodeClick()}"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="43dp"
                            android:text="获取验证码"
                            android:textColor="@color/title_text_color"
                            android:textSize="@dimen/text_size_15" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/btn_confirm"
                onClickWithDebouncing="@{()->click.login()}"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/login_button_gradient_bg"
                android:gravity="center"
                android:text="登录"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_17" />

            <com.google.android.material.textview.MaterialTextView
                android:visibility="visible"
                android:id="@+id/tv_user_protocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_protocol_desc"
                android:textColor="@color/text_color_B3B3B3"
                android:textSize="@dimen/text_size_13" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_login_way"
                onClickWithDebouncing="@{()->click.onSwitchLoginWayClick()}"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@{vm.isAccountLogin?@drawable/icon_account_login:@drawable/icon_phone_login}" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_login_way_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@{vm.isAccountLogin?@string/login_way_phone_zh:@string/login_way_account_zh}"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.textview.MaterialTextView
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="@string/login_medo_copyright"
                android:textColor="@color/text_color_CCCCCC"
                android:textSize="11sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</layout>