<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="productInfo"
            type="com.shmedo.lib.core.base.model.ProductInfo" />
    </data>

    <LinearLayout
        android:id="@+id/ll_item"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:background="@{productInfo.checked?@drawable/bg_device_type_checked:null}"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        tools:background="@drawable/bg_device_type_checked">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{productInfo.productName}"
            tools:text="全部"
            tools:textColor="@color/colorPrimary"
            tools:textSize="17sp" />

        <TextView
            android:id="@+id/tv_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color_b3b3b3"
            android:textSize="15sp"
            tools:text="(07)" />

    </LinearLayout>
</layout>