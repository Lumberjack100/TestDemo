<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_corner_5dp_white"
    android:orientation="vertical">

    <include layout="@layout/cmd_response_dialog_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/contentView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_dispatch_cmd_respone_small_circle"
                android:drawablePadding="8dp"
                android:text="响应成功"
                android:textColor="@color/title_text_color"
                android:textSize="@dimen/text_size_17" />

            <TextView
                android:id="@+id/tv_response_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_15"
                tools:text="发送指令失败" />

        </LinearLayout>

        <include
            android:id="@+id/queryCmdResponseResultLoadingView"
            layout="@layout/query_cmd_response_result_loading_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <ViewStub
            android:id="@+id/queryCmdResponseResultTimeOutView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout="@layout/query_cmd_result_time_out_view" />

    </FrameLayout>

    <include layout="@layout/cmd_response_dialog_footer" />

</LinearLayout>