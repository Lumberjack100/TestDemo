<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_header_container"
    android:layout_width="@dimen/data_table_row_header_width"
    android:layout_height="@dimen/data_table_cell_height"
    android:background="@color/mr_communication_data_table_row_header_backround">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/row_header_textView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Row Data"
        android:textColor="@color/title_text_color"
        android:textSize="@dimen/text_size_15"
        android:textStyle="bold" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="@color/transparent" />

</RelativeLayout>