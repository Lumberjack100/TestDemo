<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.MR702TerminalParameterViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.mr702.fragment.MR702TerminalParameterFragment.ClickProxy" />
    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:background="@color/white">

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="屏幕更新周期(秒)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                android:text="@={stateVM.screenRefreshTime}"
                android:inputType="number"
                app:lengthFilter="@{6}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="亮屏时间(秒)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                android:text="@={stateVM.screenBrightTime}"
                app:inputTypeFilter='@{"numberDecimal"}'
                app:lengthFilter="@{6}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="通电时间(秒)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                android:text="@={stateVM.screenPowerUpTime}"
                app:inputTypeFilter='@{"numberDecimal"}'
                app:lengthFilter="@{6}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat style="@style/Common_EditItem_LayoutStyle">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="屏幕亮度设置"
                tools:textColor="@color/title_text_color" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_EditItem_EditText_Style"
                android:hint=""
                android:text='@{stateVM.lightness+"%"}'
                android:textColor="@color/colorPrimary"
                tools:text="32%" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatSeekBar
            style="@android:style/Widget.Material.SeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_size_10"
            android:layout_marginBottom="@dimen/dimen_size_15"
            android:max="100"
            android:maxHeight="@dimen/dimen_size_8"
            android:min="10"
            android:progress="@={stateVM.lightness}"
            android:progressDrawable="@drawable/seekbar_progress_blue"
            android:thumb="@drawable/ic_seekbar_thumb"
            tools:progress="25" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>