<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <include
            android:id="@+id/head_info_layout"
            layout="@layout/device_config_head_info" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white"
            android:gravity="center_vertical"
            android:paddingStart="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_device_state_set" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="状态设置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/bluetooth_connect_layout"
            layout="@layout/device_config_switchview_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/device_enable_state_layout"
            layout="@layout/device_config_switchview_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white"
            android:gravity="center_vertical"
            android:paddingStart="16dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sensor_config" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="传感器设置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/switch_layout"
            layout="@layout/device_config_switchview_item3" />

        <LinearLayout
            android:id="@+id/llty_rain_break_alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_main_light_white"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white" />

            <include
                android:id="@+id/llty_rain"
                layout="@layout/device_config_switchview_item3"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="20dp" />

            <RelativeLayout
                android:id="@+id/llty_break_alarm"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/bg_main_light_white"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="50dp"
                    android:text="断线报警器"
                    android:textColor="@color/gray_807B7B"
                    android:textSize="@dimen/text_size_15" />

                <TextView
                    android:id="@+id/tv_break_alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="10dp"
                    android:layout_toLeftOf="@id/sb_break_alarm"
                    android:text="常闭"
                    android:textColor="@color/gray_807B7B"
                    android:textSize="@dimen/text_size_15" />

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/sb_break_alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="20dp"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="22dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="22dp" />

            </RelativeLayout>

        </LinearLayout>

        <!--        <View-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="1dp" />-->

        <!--        <include-->
        <!--            android:id="@+id/osmometer_config_layout"-->
        <!--            layout="@layout/device_config_switchview_item4" />-->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <include
            android:id="@+id/general_sensor_param_config_layout"
            layout="@layout/device_config_choose_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RelativeLayout
            android:id="@+id/rl_mqtt_config"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white"
            android:paddingStart="16dp">

            <ImageView
                android:id="@+id/iv_mqtt_config"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_data_center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_toRightOf="@id/iv_mqtt_config"
                android:text="数据中心"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:src="@drawable/icon_right" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RelativeLayout
            android:id="@+id/rl_collector_control"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white"
            android:paddingStart="16dp">

            <ImageView
                android:id="@+id/iv_collector_control"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_collector_control" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_toRightOf="@id/iv_collector_control"
                android:text="采集控制"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:src="@drawable/icon_right" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RelativeLayout
            android:id="@+id/rl_advanced_config"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/bg_main_light_white"
            android:paddingStart="16dp">

            <ImageView
                android:id="@+id/iv_advanced_config"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_advanced_config" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_toRightOf="@id/iv_advanced_config"
                android:text="高级设置"
                android:textColor="@color/gray_807B7B"
                android:textSize="@dimen/text_size_18" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:src="@drawable/icon_right" />

        </RelativeLayout>

    </LinearLayout>

</ScrollView>