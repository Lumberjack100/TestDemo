<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_corner_3dp_gray_f9f9f9"
    android:orientation="vertical"
    tools:context="com.shmedo.mcloudapp.deviceconfig.ui.fragment.usb.Inclinometer_debug_box.dialog.ConfigLinkMacDialogFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@color/title_text_color"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            tools:text="配置连接" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="6dp"
            android:src="@drawable/ic_dispatch_cmd_dialog_close" />

    </RelativeLayout>

    <LinearLayout
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="模数" />

        <TextView
            android:id="@+id/tv_modulus"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="888" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="系数A" />

        <TextView
            android:id="@+id/tv_coefficientA"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="4.210277E-12" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="系数B" />

        <TextView
            android:id="@+id/tv_coefficientB"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="4.210277E-12" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="系数C" />

        <TextView
            android:id="@+id/tv_coefficientC"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="4.210277E-12" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="系数D" />

        <TextView
            android:id="@+id/tv_coefficientD"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="4.210277E-12" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测量数据" />

        <TextView
            android:id="@+id/tv_measurement_data"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="-2.4" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_data_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        android:textColor="@color/text_color_3AD094"
        android:textSize="13sp"
        tools:text="接收时间: 14:08:21" />

    <Button
        android:id="@+id/btn_query_data"
        style="@style/SubmitBordelessButtonStyle"
        android:text="请求数据" />

    <Button
        android:id="@+id/btn_continuous_collection"
        style="@style/SubmitBordelessButtonStyle"
        android:layout_marginTop="0dp"
        android:text="连续采集" />

</LinearLayout>

