<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/poi_detail_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/radius_top_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:layout_marginTop="@dimen/dimen_size_10"
        android:layout_marginRight="@dimen/dimen_size_10"
        android:layout_marginBottom="@dimen/dimen_size_10"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_poi_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@color/poi_detail_title"
                android:textStyle="bold"
                tools:text="我的位置" />

            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="@dimen/dimen_size_24"
                android:layout_height="@dimen/dimen_size_24"
                android:layout_marginLeft="@dimen/dimen_size_15"
                android:background="@drawable/close_selector" />

        </LinearLayout>


        <TextView
            android:id="@+id/tv_poi_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_size_5"
            android:textAppearance="@android:style/TextAppearance.Small"
            android:textColor="@color/poi_detail_loc"
            tools:text="正在获取位置" />

    </LinearLayout>

    <View
        style="@style/DividerCommon"
        android:layout_marginLeft="@dimen/dimen_size_10"
        android:layout_marginRight="@dimen/dimen_size_10" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:drawableLeft="@drawable/ic_poi_share"
            android:gravity="center_vertical"
            android:text="分享"
            android:textAppearance="@android:style/TextAppearance.Small"
            android:textColor="@color/poi_detail_text" />

        <TextView
            android:id="@+id/tv_navigation"
            style="@style/PoiDetailFixedStyle"
            android:background="@drawable/rectangle_corner_selector"
            android:gravity="center"
            android:text="导航"
            android:textColor="@color/poi_navi_text" />

        <TextView
            android:id="@+id/tv_route"
            style="@style/PoiDetailFixedStyle"
            android:background="@drawable/rectangle_blue_selector"
            android:gravity="center"
            android:text="路线"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>