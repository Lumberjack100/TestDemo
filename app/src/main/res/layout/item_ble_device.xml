<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.text.TextUtils" />

        <import type="com.shmedo.lib.device.base.iot_cmd.enums.ProductType" />

        <variable
            name="m"
            type="com.shmedo.lib.ble.scanner.model.DiscoveredBluetoothDevice" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/layer_common_click_item_with_divider2"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dimen_size_20"
        android:paddingVertical="@dimen/dimen_size_10">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_device_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_ble_device" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_dev_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_10"
                    android:singleLine="true"
                    android:text='@{TextUtils.isEmpty(m.name)? "Unknown device":m.name}'
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    tools:text="小泉寺门头沟-E60S0231" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_device_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_device_type_flag"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:singleLine="true"
                    android:textColor="#626366"
                    android:textSize="@dimen/text_size_12"
                    android:visibility="gone"
                    tools:text="ADME" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_mac_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_10"
                    android:singleLine="true"
                    android:text="@{m.address}"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_13"
                    tools:text="0D:00:00:99:88:11" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_rssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_20"
                    android:singleLine="true"
                    android:text='@{m.rssi + " dBm"}'
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_13"
                    tools:text="-91 dBm" />
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_size_15"
            android:src="@drawable/icon_arrow_right" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>