<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.text.TextUtils" />
        <import type="com.shmedo.lib.device.base.iot_cmd.enums.ProductType" />

        <variable
            name="m"
            type="com.shmedo.lib.ble.scanner.model.DiscoveredBluetoothDevice" />
    </data>

    <LinearLayout
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="31dp"
        android:paddingEnd="31dp">

        <ImageView
            android:id="@+id/iv_device_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ble_device" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_dev_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:singleLine="true"
                    android:text='@{TextUtils.isEmpty(m.name)? "Unknown device":m.name}'
                    android:textColor="@color/title_text_color"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="小泉寺门头沟-E60S0231" />

                <!-- visible="@{!TextUtils.isEmpty(m.name)}"-->
                <TextView
                    android:id="@+id/tv_device_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_device_type_flag"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:singleLine="true"
                    android:textColor="#626366"
                    android:textSize="@dimen/text_size_12"
                    android:text="@{ProductType.valueBySuffix(m.name).prefix}"
                    tools:text="ADME"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_mac_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:singleLine="true"
                    android:text="@{m.address}"
                    android:textColor="@color/title_text_color"
                    android:textSize="13sp"
                    tools:text="0D:00:00:99:88:11" />

                <TextView
                    android:id="@+id/tv_rssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:singleLine="true"
                    android:text='@{m.rssi + " dBm"}'
                    android:textColor="@color/title_text_color"
                    android:textSize="13sp"
                    tools:text="-91 dBm" />
            </LinearLayout>


        </LinearLayout>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:src="@drawable/icon_arrow_right" />

    </LinearLayout>
</layout>