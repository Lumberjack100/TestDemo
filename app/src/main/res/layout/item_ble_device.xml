<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:background="@color/white"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:paddingStart="31dp"
    android:paddingEnd="31dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_device_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_ble_device" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_dev_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:singleLine="true"
                android:textColor="@color/title_text_color"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="小泉寺门头沟-E60S0231" />

            <TextView
                android:id="@+id/tv_device_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_device_type_flag"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:singleLine="true"
                android:textColor="#626366"
                android:textSize="@dimen/text_size_12"
                android:visibility="gone"
                tools:text="ADME"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_mac_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:singleLine="true"
            android:textColor="@color/title_text_color"
            android:textSize="13sp"
            tools:text="0D:00:00:99:88:11" />

    </LinearLayout>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:src="@drawable/icon_right" />

</LinearLayout>