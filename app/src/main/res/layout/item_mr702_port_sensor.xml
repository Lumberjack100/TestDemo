<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.device.model.MRSensorItem" />
    </data>

    <FrameLayout
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@{m.isPlugin?@drawable/mr702_port_sensor_item_bright_bg:@drawable/mr702_port_sensor_item_gray_bg}"
        android:minHeight="88dp"
        tools:background="@drawable/mr702_port_sensor_item_bright_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:background="@color/mr_interface_sensor_flag_in_backround"
            android:paddingStart="@dimen/dimen_size_4"
            android:paddingTop="@dimen/dimen_size_2"
            android:paddingEnd="@dimen/dimen_size_4"
            android:paddingBottom="@dimen/dimen_size_2"
            android:text='@{m.isPlugin?"已接入":"未接入"}'
            android:textColor="@color/white"
            android:textSize="12sp"
            app:drawable_radiusLT="@{6}"
            app:drawable_radiusRB="@{6}"
            app:drawable_solidColor='@{m.isPlugin?@color/mr_interface_sensor_flag_in_backround:@color/mr_interface_sensor_flag_out_backround}'
            tools:text="已接入" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dimen_size_5"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@{m.addrDesc}"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="配置地址" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dimen_size_2"
                android:text="@{m.sensorName}"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="雷达水位计" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <ImageView
            android:id="@+id/item_del"
            visible="@{m.isShowDel}"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="end|top"
            android:src="@drawable/item_del_btn2" />

    </FrameLayout>
</layout>