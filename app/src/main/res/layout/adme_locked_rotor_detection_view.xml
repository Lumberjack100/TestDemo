<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <RelativeLayout
        style="@style/SwitchButton_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/SwitchButton_TitleStyle"
            android:text="下放堵转计米检测"
            android:textStyle="bold" />

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/downEnableSBtn"
            style="@style/SwitchButton_ButtonStyle"
            app:kswAnimationDuration="100"
            app:kswBackDrawable="@drawable/sl_switchbutton_back"
            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
            app:kswThumbHeight="28dp"
            app:kswThumbRangeRatio="2"
            app:kswThumbWidth="28dp" />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/downMeterChildLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="单位时间脉冲数(p/s)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_down_pulses_per_unit_time"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="检测判断时间(s)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_down_pulse_detection_time"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="下放加速距离(mm)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_down_slow_start_interval"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number"
                    tools:text="55" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="下放减速距离(mm)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_down_slow_stop_interval"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number"
                    tools:text="55" />

            </LinearLayout>

            <com.jaygoo.widget.RangeSeekBar
                android:id="@+id/seekBar_down_slow_stop_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:rsb_gravity="bottom"
                app:rsb_indicator_background_color="@color/text_color_51B4F8"
                app:rsb_indicator_height="wrap_content"
                app:rsb_indicator_padding_bottom="5dp"
                app:rsb_indicator_padding_left="10dp"
                app:rsb_indicator_padding_right="10dp"
                app:rsb_indicator_padding_top="5dp"
                app:rsb_indicator_radius="3dp"
                app:rsb_indicator_show_mode="alwaysShow"
                app:rsb_indicator_width="wrap_content"
                app:rsb_max="100"
                app:rsb_min="0"
                app:rsb_min_interval="0"
                app:rsb_mode="range"
                app:rsb_progress_color="#EDEDED"
                app:rsb_progress_default_color="@color/text_color_51B4F8"
                app:rsb_thumb_drawable="@drawable/thumb_blue"
                app:rsb_thumb_height="30dp"
                app:rsb_thumb_width="30dp"
                app:rsb_tick_mark_mode="other"
                app:rsb_tick_mark_text_array="@array/seekBar_array"
                app:rsb_tick_mark_text_color="@color/text_color_51B4F8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="堵转检测区间(%)" />

                <TextView
                    android:id="@+id/tv_down_stall_detection_interval"
                    style="@style/Common_EditItem_EditText_Style"
                    android:hint=""
                    tools:text="17%-55%" />

            </LinearLayout>

            <com.jaygoo.widget.RangeSeekBar
                android:id="@+id/seekBar_down_stall_detection_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:rsb_gravity="bottom"
                app:rsb_indicator_background_color="@color/text_color_51B4F8"
                app:rsb_indicator_height="wrap_content"
                app:rsb_indicator_padding_bottom="5dp"
                app:rsb_indicator_padding_left="10dp"
                app:rsb_indicator_padding_right="10dp"
                app:rsb_indicator_padding_top="5dp"
                app:rsb_indicator_radius="3dp"
                app:rsb_indicator_show_mode="alwaysShow"
                app:rsb_indicator_width="wrap_content"
                app:rsb_max="100"
                app:rsb_min="0"
                app:rsb_min_interval="1"
                app:rsb_mode="range"
                app:rsb_progress_color="@color/text_color_51B4F8"
                app:rsb_progress_default_color="#EDEDED"
                app:rsb_thumb_drawable="@drawable/thumb_default"
                app:rsb_thumb_height="30dp"
                app:rsb_thumb_width="30dp"
                app:rsb_tick_mark_mode="other"
                app:rsb_tick_mark_text_array="@array/seekBar_array"
                app:rsb_tick_mark_text_color="@color/text_color_51B4F8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider_line_bg_efefef" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/downMeterChildMaskLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66ffffff"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

        </RelativeLayout>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="5dp" />

    <RelativeLayout
        style="@style/SwitchButton_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/SwitchButton_TitleStyle"
            android:text="下放堵转力矩检测"
            android:textStyle="bold" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/downTorqueChildLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="力矩堵转阈值(A)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_down_torque_stall_threshold"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="numberDecimal" />

        </LinearLayout>

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="力矩检测判断时间(s)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_down_torque_detection_time"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="numberDecimal" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="5dp" />

    <RelativeLayout
        style="@style/SwitchButton_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/SwitchButton_TitleStyle"
            android:text="上拉堵转计米检测"
            android:textStyle="bold" />

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/pullUpEnableSBtn"
            style="@style/SwitchButton_ButtonStyle"
            app:kswAnimationDuration="100"
            app:kswBackDrawable="@drawable/sl_switchbutton_back"
            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
            app:kswThumbHeight="28dp"
            app:kswThumbRangeRatio="2"
            app:kswThumbWidth="28dp" />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/pullUpMeterChildLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="上拉加速距离(mm)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_pull_up_slow_start_interval"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number"
                    tools:text="55" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="上拉减速距离(mm)" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_pull_up_slow_stop_interval"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number"
                    tools:text="55" />

            </LinearLayout>

            <com.jaygoo.widget.RangeSeekBar
                android:id="@+id/seekBar_pull_up_slow_stop_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:rsb_gravity="bottom"
                app:rsb_indicator_background_color="@color/text_color_51B4F8"
                app:rsb_indicator_height="wrap_content"
                app:rsb_indicator_padding_bottom="5dp"
                app:rsb_indicator_padding_left="10dp"
                app:rsb_indicator_padding_right="10dp"
                app:rsb_indicator_padding_top="5dp"
                app:rsb_indicator_radius="3dp"
                app:rsb_indicator_show_mode="alwaysShow"
                app:rsb_indicator_width="wrap_content"
                app:rsb_max="100"
                app:rsb_min="0"
                app:rsb_min_interval="0"
                app:rsb_mode="range"
                app:rsb_progress_color="#EDEDED"
                app:rsb_progress_default_color="@color/text_color_51B4F8"
                app:rsb_thumb_drawable="@drawable/thumb_default"
                app:rsb_thumb_height="30dp"
                app:rsb_thumb_width="30dp"
                app:rsb_tick_mark_mode="other"
                app:rsb_tick_mark_text_array="@array/seekBar_array"
                app:rsb_tick_mark_text_color="@color/text_color_51B4F8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider_line_bg_efefef" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/pullUpMeterChildMaskLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66ffffff"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

        </RelativeLayout>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="5dp" />

    <RelativeLayout
        style="@style/SwitchButton_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/SwitchButton_TitleStyle"
            android:text="上拉堵转力矩检测"
            android:textStyle="bold" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/pullUpTorqueChildLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="力矩堵转阈值(A)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_pull_up_torque_stall_threshold"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="numberDecimal" />

        </LinearLayout>

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="力矩检测判断时间(s)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_pull_up_torque_detection_time"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="numberDecimal" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <Button
        android:id="@+id/btn_confirm"
        style="@style/SubmitBordelessButtonStyle"
        android:text="保存" />

</merge>