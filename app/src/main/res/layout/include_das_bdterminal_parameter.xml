<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.DasTerminalParameterViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.das.fragment.DasTerminalParameterFragment.ClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:background="@color/white">

        <RelativeLayout
            style="@style/SwitchButton_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/SwitchButton_TitleStyle"
                android:text="开关"
                textViewEnabled="@{stateVM.isEditable}" />

            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/bdSB"
                style="@style/SwitchButton_ButtonStyle"
                android:enabled="@{stateVM.isEditable}"
                android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                app:kswAnimationDuration="100"
                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

        </RelativeLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isBdOpened}"
                android:text="目标地址"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isBdOpened}"
                android:hint="请输入"
                android:text="@={stateVM.address}"
                app:inputTypeFilter='@{"number"}'
                app:lengthFilter="@{6}" />

        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_ClickableItem_LayoutStyle"
            onClickWithDebouncing="@{()->click.onBaudRateChooseClick()}"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:enabled="@{stateVM.isEditable &amp;&amp;stateVM.isBdOpened}">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isBdOpened}"
                android:text="波特率(Bps)" />

            <TextView
                style="@style/Common_ClickableItem_ValueStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isBdOpened}"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:text="@{stateVM.baudRate}"
                tools:text="115200" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>