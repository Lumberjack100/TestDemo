<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.shmedo.mcloudapp.model.DeviceStatusEnum" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.CommonDeviceHomeViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.baseclickproxy.BaseClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="@dimen/page_content_item_padding_horizontal_16"
        android:paddingVertical="@dimen/dimen_size_12">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_device_logo"
            imageResId="@{stateVM.productLogoResId}"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/device_logo_gt600" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_size_25"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{stateVM.productName}"
                android:textColor="@color/title_text_color"
                android:textSize="@dimen/text_size_19"
                android:textStyle="bold"
                tools:text="智能遥测终端机" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_product_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_5"
                android:ellipsize="end"
                android:gravity="bottom"
                android:maxLines="1"
                android:text='@{stateVM.productToken+" I "+stateVM.deviceToken}'
                android:textColor="@color/title_text_color_black_90"
                android:textSize="@dimen/text_size_13"
                tools:text="MD-DR030 I 21E118L" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_5">

                <com.google.android.material.textview.MaterialTextView
                    invisible="@{!stateVM.iotPlatformStateText.empty}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background='@{stateVM.iotPlatformStateText.contains("在线")||stateVM.iotPlatformStateText.contains("已连接")?@drawable/bg_label_online_corner_1dp:@drawable/bg_label_offline_corner_1dp}'
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dimen_size_7"
                    android:paddingVertical="@dimen/dimen_size_2"
                    android:text='@{stateVM.iotPlatformStateText}'
                    android:textColor='@{stateVM.iotPlatformStateText.contains("在线")||stateVM.iotPlatformStateText.contains("已连接")?@color/online_colorPrimary:@color/offline_BABABA}'
                    android:textSize="@dimen/text_size_11"
                    tools:background="@drawable/bg_label_online_corner_1dp"
                    tools:text="米度平台在线"
                    tools:textColor="@color/online_colorPrimary" />

                <com.shmedo.mcloudapp.ui.widget.AnimatedTextSwitcher
                    visible="@{stateVM.deviceStatusCode!=DeviceStatusEnum.UNKNOWN.code}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_6"
                    app:animatedText="@{stateVM.warnErrorText}"
                    app:defaultTextSize="@dimen/text_size_11"
                    app:deviceStatusCode="@{stateVM.deviceStatusCode}"
                    app:errorTextColor="@color/error_FF4400"
                    app:maxEms="7"
                    app:needBackground="true" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>