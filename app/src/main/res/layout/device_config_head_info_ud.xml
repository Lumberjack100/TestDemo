<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.CommonDeviceHomeViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.baseclickproxy.BaseClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="@dimen/dimen_size_10">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_device_logo"
            imageResId="@{stateVM.productLogoResId}"
            android:layout_width="100dp"
            android:layout_height="66dp"
            android:layout_marginStart="@dimen/dimen_size_10"
            tools:src="@drawable/device_logo_niweiji" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_size_25"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{stateVM.productName}"
                android:textColor="@color/title_text_color"
                android:textSize="@dimen/text_size_17"
                android:textStyle="bold"
                tools:text="智能遥测终端机" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_product_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_5"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="bottom"
                android:text='@{stateVM.productToken+" I "+stateVM.deviceToken}'
                android:textColor="@color/black_40"
                android:textSize="@dimen/text_size_14"
                tools:text="MD-DR030 I 21E118L" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_platform"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_5"
                android:clipToPadding="false"
                android:splitMotionEvents="false"
                tools:itemCount="2"
                tools:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
                tools:listitem="@layout/item_platform_label" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>