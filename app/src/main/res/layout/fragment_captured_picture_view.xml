<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.CapturedPictureViewViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.u_product.fragment.ud.CapturedPictureViewFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.luck.picture.lib.magical.MagicalView
            android:id="@+id/magical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_size_15"
            android:layout_marginBottom="@dimen/dimen_size_50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_pre_image"
                style="@style/ColorPrimary.FloatingActionButton"
                onClickWithDebouncing="@{()->click.onViewPreImageClick()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:elevation="0dp"
                app:fabSize="mini"
                app:rippleColor="@color/ripple_material_light"
                app:srcCompat="@drawable/ic_pre_image" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                style="@style/ColorPrimary.FloatingActionButton"
                onClickWithDebouncing="@{()->click.onDownloadImageClick()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:elevation="0dp"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_download_media" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_next_iamge"
                style="@style/ColorPrimary.FloatingActionButton"
                onClickWithDebouncing="@{()->click.onViewNextImageClick()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:elevation="0dp"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_next_image" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>