<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="homeVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702InterfaceHomeViewModel" />

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702RS4851InterfaceViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.deviceinterface.MR702RS4851InterfaceFragment.ClickProxy" />
    </data>

    <com.drake.brv.PageRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="60dp"
                android:orientation="vertical">

                <include
                    layout="@layout/include_mr702_interface_common_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_size_8"
                    app:vm="@{homeVM}" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:layout_marginTop="@dimen/dimen_size_15"
                    android:layout_marginBottom="@dimen/dimen_size_15"
                    android:drawablePadding="-80dp"
                    android:text="采集参数"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_mr702_interface_info_collection_param" />

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="采集频率(ms)" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        android:text="@={vm.acquisitionFrequency}"
                        app:isNumberFilter="@{true}"
                        app:lengthFilter="@{5}" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="采集时长(s)" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        android:text="@={vm.collectionDuration}"
                        app:isNumberFilter="@{true}"
                        app:lengthFilter="@{5}" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="采集间隔(ms)" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        android:text="@={vm.collectionInterval}"
                        app:isNumberFilter="@{true}"
                        app:lengthFilter="@{5}" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="无应答次数" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        android:text="@={vm.noResponseTimes}"
                        app:isNumberFilter="@{true}"
                        app:lengthFilter="@{5}" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:layout_marginTop="@dimen/dimen_size_15"
                    android:layout_marginBottom="@dimen/dimen_size_15"
                    android:drawablePadding="-80dp"
                    android:text="传感器配置"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_mr702_interface_info_sensor_config" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:clipToPadding="false"
                    android:padding="@dimen/dimen_size_15"
                    android:splitMotionEvents="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_mr702_interface_sensor_item" />

                <TextView
                    android:id="@+id/btn_confirm"
                    style="@style/SubmitButton_ColorPrimary"
                    onClickWithDebouncing="@{()->click.onSubmitClick()}"
                    visible="@{homeVM.isEditable }"
                    android:layout_marginBottom="15dp"
                    android:text="保存"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/scrollView" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.drake.brv.PageRefreshLayout>
</layout>