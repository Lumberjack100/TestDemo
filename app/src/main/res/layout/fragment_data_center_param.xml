<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.DataCenterParamViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.common.UniversalDataCenterParamFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/page_scroll_content_padding_bottom">

                    <include
                        android:id="@+id/ll_data_center_param_head"
                        layout="@layout/data_center_param_head"
                        app:click="@{click}"
                        app:vm="@{stateVM}" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:text="数据中心地址" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            android:id="@+id/et_data_server_address"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:text="@={stateVM.centerServerAddress}"
                            app:lengthFilter="@{100}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/Common_EditItem_LayoutStyle">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:text="数据中心端口" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            android:id="@+id/et_data_server_port"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:text="@={stateVM.centerServerPort}"
                            android:inputType="number"
                            app:lengthFilter="@{5}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        onClickWithDebouncing="@{()->click.onDataTypeChooseClick()}"
                        visible="@{stateVM.isDataTypeVisible}"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:text="数据类型" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.dataType}"
                            tools:text="NMEA" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        onClickWithDebouncing="@{()->click.onDataProtocolChooseClick()}"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:text="数据协议" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.dataProtocol}"
                            tools:text="MQTT" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        onClickWithDebouncing="@{()->click.onPlatformTypeChooseClick()}"
                        android:enabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:text="平台类型" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.platformType}"
                            tools:text="成都理工平台" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ll_mqtt"
                        visible="@{stateVM.isMqttItemVisible}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:layout_marginTop="@dimen/dimen_size_8"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="产品ID" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.productId}"
                                app:lengthFilter="@{100}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="设备ID" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.deviceId}"
                                app:lengthFilter="@{100}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="设备Key" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.deviceKey}"
                                app:lengthFilter="@{100}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            visible="@{stateVM.isRigisterVisible}"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="设备注册码" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.registerCode}"
                                app:lengthFilter="@{100}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            visible="@{stateVM.isRigisterVisible}"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="设备注册地址" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.registerAddress}"
                                app:lengthFilter="@{100}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            visible="@{stateVM.isRigisterVisible}"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="设备注册端口" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.registerPort}"
                                android:inputType="number"
                                app:lengthFilter="@{5}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ll_sl651"
                        visible="@{stateVM.isSL651ItemVisible}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_ClickableItem_LayoutStyle"
                            onClickWithDebouncing="@{()->click.onStationClassificationChooseClick()}"
                            android:layout_marginTop="@dimen/dimen_size_8"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:enabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="测站分类" />

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_ValueStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:drawableEnd="@drawable/ic_arrow_down"
                                android:text="@{stateVM.stationType}"
                                tools:text="降水" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="中心站地址" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.centerStationAddr}"
                                android:inputType="number"
                                app:lengthFilter="@{3}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="密码" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.password}"
                                android:inputType="number"
                                app:lengthFilter="@{5}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="测站编码" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="@={stateVM.telemetryStationAddr}"
                                app:inputTypeFilter='@{"character"}'
                                app:lengthFilter="@{10}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_ClickableItem_LayoutStyle"
                            onClickWithDebouncing="@{()->click.onToggleAdvancedClick()}"
                            android:layout_marginTop="@dimen/dimen_size_8"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:enabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:text="高级设置" />

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_ValueStyle"
                                android:drawableEnd="@{stateVM.isAdvancedItemVisible ? @drawable/ic_arrow_up_blue : @drawable/ic_arrow_down_blue}"
                                android:text='@{stateVM.isAdvancedItemVisible ? "收起" : "展开"}'
                                android:textColor="@color/colorPrimary"
                                tools:drawableEnd="@drawable/ic_arrow_down_blue"
                                tools:text="展开" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/ll_advanced_items"
                            visible="@{stateVM.isAdvancedItemVisible}"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                android:layout_marginStart="@dimen/dimen_size_16"
                                android:layout_marginTop="@dimen/dimen_size_16"
                                android:text="报文选择" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dimen_size_16"
                                android:padding="@dimen/dimen_size_14"
                                app:drawable_radius="@{4}"
                                app:drawable_solidColor="@{@color/gray_f5f6f8}"
                                tools:background="@color/gray_f5f6f8">

                                <com.google.android.material.checkbox.MaterialCheckBox
                                    android:id="@+id/hourlyReportCheckBox"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:button="@drawable/radiobutton_selector"
                                    android:checked="@={stateVM.hourlyReport}"
                                    android:text="小时报"
                                    android:textColor="@color/title_text_color"
                                    android:textSize="@dimen/text_size_16"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:checked="true" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/dimen_size_16"
                                android:layout_marginEnd="@dimen/dimen_size_16"
                                android:background="@color/divider_line_bg" />

                            <androidx.appcompat.widget.LinearLayoutCompat
                                style="@style/Common_EditItem_LayoutStyle"
                                android:background="@drawable/layer_common_click_item_with_divider">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Common_ClickableItem_TitleStyle"
                                    textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                    android:text="维持上报间隔(秒)" />

                                <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                    style="@style/Common_EditItem_EditText_Style"
                                    textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                    android:text="@={stateVM.maintainReportInterval}"
                                    android:inputType="number"
                                    app:lengthFilter="@{3}" />

                            </androidx.appcompat.widget.LinearLayoutCompat>

                            <androidx.appcompat.widget.LinearLayoutCompat
                                style="@style/Common_EditItem_LayoutStyle"
                                android:background="@drawable/layer_common_click_item_with_divider">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Common_ClickableItem_TitleStyle"
                                    textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                    android:text="数据补发有效时间(日)" />

                                <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                    style="@style/Common_EditItem_EditText_Style"
                                    textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                    android:text="@={stateVM.reissuingDataValidDays}"
                                    android:inputType="number"
                                    app:lengthFilter="@{3}" />

                            </androidx.appcompat.widget.LinearLayoutCompat>

                            <androidx.appcompat.widget.LinearLayoutCompat
                                style="@style/Common_EditItem_LayoutStyle"
                                android:background="@drawable/layer_common_click_item_with_divider">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Common_ClickableItem_TitleStyle"
                                    textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                    android:text="数据补发间隔(分钟)" />

                                <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                    style="@style/Common_EditItem_EditText_Style"
                                    textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isCenterOpened}"
                                    android:text="@={stateVM.reissuingDataInterval}"
                                    android:inputType="number"
                                    app:lengthFilter="@{4}" />

                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onSubmitClick()}"
            visible="@{stateVM.isEditable &amp;&amp; stateVM.isCenterOpened}"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/page_param_content_submit_button_margin_bottom"
            android:text="保存"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
