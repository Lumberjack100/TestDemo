<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            android:id="@+id/tv_trigger_threshold"
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="触发值(单位:mm)" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_trigger_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberSigned|numberDecimal" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="温度修正系数B" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/temperatureCoefficient"
            style="@style/Common_EditItem_EditText_Style" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="灵敏度K" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/sensitivityCoefficient"
            style="@style/Common_EditItem_EditText_Style" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="初始温度T" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/initialTemperature"
            style="@style/Common_EditItem_EditText_Style" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="初始模数F" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/initialModulus"
            style="@style/Common_EditItem_EditText_Style" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="修正值M" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/correctValue"
            style="@style/Common_EditItem_EditText_Style" />

    </LinearLayout>

</LinearLayout>