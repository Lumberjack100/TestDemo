<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_mapTypeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/gray_f2f2f2"
        android:paddingLeft="@dimen/dimen_size_10"
        android:paddingTop="@dimen/dimen_size_5"
        android:paddingRight="@dimen/dimen_size_10"
        android:paddingBottom="@dimen/dimen_size_5"
        android:text="图层选择"
        android:textColor="@color/gray_807B7B"
        android:textSize="@dimen/text_size_16" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_mapTypeTitle"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gray_f2f2f2"
            android:paddingLeft="@dimen/dimen_size_10"
            android:paddingTop="@dimen/dimen_size_5"
            android:paddingRight="@dimen/dimen_size_10"
            android:paddingBottom="@dimen/dimen_size_5"
            android:text="其他"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_16" />

        <RelativeLayout
            android:id="@+id/offlineMapDownloadView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dimen_size_15">

            <ImageView
                android:id="@+id/iv_offlineMap"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_offline_map_down" />

            <TextView
                android:id="@+id/tv_offlineMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dimen_size_10"
                android:layout_toRightOf="@+id/iv_offlineMap"
                android:text="离线地图"
                android:textColor="@color/black_333333"
                android:textSize="@dimen/text_size_16" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_right" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray_f2f2f2" />

        <RelativeLayout
            android:id="@+id/mapSettingView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/dimen_size_15">

            <ImageView
                android:id="@+id/iv_mapSetting"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_map_layer_setting" />

            <TextView
                android:id="@+id/tv_mapSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dimen_size_10"
                android:layout_toRightOf="@+id/iv_mapSetting"
                android:text="地图设置"
                android:textColor="@color/black_333333"
                android:textSize="@dimen/text_size_16" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_right" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>

