<?xml version="1.0" encoding="utf-8"?>
<com.shmedo.mcloudapp.deviceconfig.view.SquareRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_sensor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:src="@drawable/ic_sensor_holder_bright" />

    <ImageView
        android:id="@+id/iv_del"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignTop="@id/iv_sensor"
        android:layout_alignEnd="@id/iv_sensor"
        android:scaleType="centerCrop"
        android:src="@drawable/item_del_btn"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignRight="@id/iv_sensor"
        android:layout_alignBottom="@id/iv_sensor"
        android:layout_marginEnd="3dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="187" />

</com.shmedo.mcloudapp.deviceconfig.view.SquareRelativeLayout>