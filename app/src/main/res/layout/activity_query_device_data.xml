<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar_white_bg" />

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="设备SN号" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/snET"
            style="@style/Common_EditItem_EditText_Style" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_start_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:hint="开始时间"
                android:singleLine="true"
                android:textColor="@color/title_text_color"
                android:textColorHint="@color/text_color_cccccc"
                android:textSize="@dimen/text_size_15" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="12dp"
                android:background="@color/divider_line_bg_efefef"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/blue_52B4F8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_end_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:hint="结束时间"
                android:singleLine="true"
                android:textColor="@color/title_text_color"
                android:textColorHint="@color/text_color_cccccc"
                android:textSize="@dimen/text_size_15" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="12dp"
                android:background="@color/divider_line_bg_efefef"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_search"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_corner_15dp_blue"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_15" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/divider_line_bg_efefef" />

    <LinearLayout
        android:id="@+id/itemCountLayout"
        style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="显示条数" />

        <TextView
            android:id="@+id/tv_item_count"
            style="@style/Common_ClickableItem_ValueStyle"
            android:text="--"
            tools:text="30" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:splitMotionEvents="false" />
</LinearLayout>