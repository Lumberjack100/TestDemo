<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <android.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/syncInstallLocationLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="同步安装位置" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <android.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/customCommandLogPrintLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="指令日志输出" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <android.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/resetLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="恢复出厂设置" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="18dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/workModeLayout"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:visibility="gone">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="工作模式" />

            <TextView
                android:id="@+id/tv_work_mode"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="节能" />

        </LinearLayout>

        <android.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/chongQingTestLayout"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="NBIOT测试" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <android.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/remoteDebuggingLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="远程调试" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <android.widget.Space
            android:layout_width="wrap_content"
            android:layout_height="50dp" />

    </LinearLayout>

</ScrollView>