<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_size_25"
        android:background="@drawable/bg_corner_10dp_white"
        android:orientation="vertical"
       android:padding="@dimen/dimen_size_25">

        <TextView
            android:id="@+id/tv_privacy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/privacy_agreement_title"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_privacy_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dimen_size_20"
            android:layout_marginBottom="@dimen/dimen_size_20"
            android:text="@string/privacy_agreement_desc"
            android:textColor="@color/poi_detail_title"
            android:textSize="@dimen/text_size_15" />

        <Button
            android:id="@+id/btn_agree"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/btn_select"
            android:foreground="?attr/selectableItemBackground"
            android:text="同意"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_18" />

        <TextView
            android:id="@+id/btn_deny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dimen_size_15"
            android:background="@null"
            android:text="拒绝并退出"
            android:textColor="@color/font_main"
            android:textSize="@dimen/text_size_15" />

    </LinearLayout>
</RelativeLayout>