<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.LB20SVolumeSettingsViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.lb20s.fragment.LB20SVolumeSettingsFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_volume_level"
            style="@style/Common_ClickableItem_LayoutStyle"
            onClickWithDebouncing="@{()->click.onVolumeChooseClick()}"
            android:layout_marginTop="@dimen/dimen_size_1"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:enabled="@{stateVM.isEditable }"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable }"
                android:text="音量等级" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Common_ClickableItem_ValueStyle"
                textViewEnabled="@{stateVM.isEditable }"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:text="@{stateVM.volumeLevel}"
                tools:text="410.00MHz" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_reset"
            style="@style/ResetButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onResetClick()}"
            visible="@{stateVM.isEditable }"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="35dp"
            android:text="@string/button_reset_text"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onSubmitButtonClick()}"
            visible="@{stateVM.isEditable }"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="55dp"
            android:text="@string/button_save_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>