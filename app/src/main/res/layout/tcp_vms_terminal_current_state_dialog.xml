<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_corner_5dp_white"
    android:orientation="vertical">

    <include layout="@layout/cmd_response_dialog_title" />

    <LinearLayout
        android:id="@+id/contentView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_dispatch_cmd_respone_small_circle"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:text="上行信号强度"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/tv_uplink_signal_strength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="13dp"
                    android:singleLine="true"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    tools:text="32.5 " />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_dispatch_cmd_respone_small_circle"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:text="下行信号强度"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/tv_downlink_signal_strength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="13dp"
                    android:singleLine="true"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    tools:text="17" />


            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="23dp"
            android:background="#efefef" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_dispatch_cmd_respone_small_circle"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:text="发送数据"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/tv_send_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="13dp"
                    android:singleLine="true"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    tools:text="30" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_dispatch_cmd_respone_small_circle"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:text="接收数据"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/tv_receive_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="13dp"
                    android:singleLine="true"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    tools:text="22" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="23dp"
            android:background="#efefef" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_dispatch_cmd_respone_small_circle"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:text="传感器状态"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/tv_sensor_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="13dp"
                    android:singleLine="true"
                    android:textColor="@color/text_color_3AD094"
                    android:textSize="@dimen/text_size_17"
                    tools:text="正常" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_dispatch_cmd_respone_small_circle"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:text="终端电压"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/tv_power_volt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="13dp"
                    android:singleLine="true"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    tools:text="33.5V" />


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/cmd_response_dialog_footer" />

</LinearLayout>