<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702RS485Port3SensorParamViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.port.MR702RS485Port3SensorParamFragment.ClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:enabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
            android:onClick="@{()->click.onSwitchLedTypeClick()}">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="显示配置" />

            <TextView
                style="@style/Common_ClickableItem_ValueStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:text="@{stateVM.ledType}"
                tools:text="P10类型1" />
        </LinearLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="显示时长(s)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:hint="请输入"
                android:text="@={stateVM.duration}"
                app:isCharacterFilter="@{false}"
                app:isNumberFilter="@{true}"
                app:lengthFilter="@{5}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="更新间隔(s)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:hint="请输入"
                android:text="@={stateVM.interval}"
                app:isCharacterFilter="@{false}"
                app:isNumberFilter="@{true}"
                app:lengthFilter="@{5}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="亮屏时长(s)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:hint="请输入"
                android:text="@={stateVM.screenTime}"
                app:isCharacterFilter="@{false}"
                app:isNumberFilter="@{true}"
                app:lengthFilter="@{5}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>