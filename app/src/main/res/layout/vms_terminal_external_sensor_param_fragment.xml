<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <RelativeLayout style="@style/SwitchButton_LayoutStyle">

            <TextView
                style="@style/SwitchButton_TitleStyle"
                android:text="开启状态" />

            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/sensorEnableSBtn"
                style="@style/SwitchButton_ButtonStyle"
                app:kswAnimationDuration="100"
                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                app:kswThumbHeight="28dp"
                app:kswThumbRangeRatio="2"
                app:kswThumbWidth="28dp" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/calculationLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="计算方式" />

                <TextView
                    android:id="@+id/tv_sensor_calculation"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="多项式" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sensorNameLayout"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="监测类型" />

                <TextView
                    android:id="@+id/tv_monitor_type"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="轴力计" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="传感器序号" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/sensorSerialNumber"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <com.shmedo.mcloudapp.deviceconfig.view.sensor.vms.LinearParamView
                android:id="@+id/linearParamView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.shmedo.mcloudapp.deviceconfig.view.sensor.vms.PolynomialParamView
                android:id="@+id/polynomialParamView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.shmedo.mcloudapp.deviceconfig.view.sensor.vms.ModulusView
                android:id="@+id/modulusView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.shmedo.mcloudapp.deviceconfig.view.sensor.vms.MagnificationView
                android:id="@+id/magnificationView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_confirm"
                style="@style/SubmitBordelessButtonStyle"
                android:text="保存" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>