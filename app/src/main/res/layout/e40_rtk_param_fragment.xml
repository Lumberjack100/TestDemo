<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/ll_rtk_mode"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="RTK模式" />

            <TextView
                android:id="@+id/tv_rtk_mode"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="基站" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_base_station_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/ll_base_mode"
                style="@style/Common_ClickableItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="基准点模式" />

                <TextView
                    android:id="@+id/tv_base_mode"
                    style="@style/Common_ClickableItem_ValueStyle"
                    tools:text="自动模式" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="经度" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_longitude"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="纬度" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_latitude"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="高程" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_elevation"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_confirm"
                style="@style/SubmitBordelessButtonStyle"
                android:text="保存" />

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/maskLayerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
