<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="m"
            type="com.shmedo.mcloudapp.model.DataCenterStatusItem" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        style="@style/Common_ClickableItem_LayoutStyle"
        app:drawable_radius="@{6}"
        app:drawable_solidColor="@{@color/white}"
        tools:background="@color/white">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="@{m.name}"
            android:textSize="17sp"
            tools:text="数据中心01-MQTT" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_dhcp"
            style="@style/Common_ClickableItem_ValueStyle"
            dataCenterStatus='@{m.status}'
            android:textSize="17sp"
            tools:text="已连接" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</layout>
