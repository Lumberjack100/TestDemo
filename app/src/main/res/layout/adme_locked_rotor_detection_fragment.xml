<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/white"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="下放堵转检测"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold" />

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/decentralizedEnableSBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/decentralizedChildLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="单位时间脉冲数(p/s)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_decentralized_pulses_per_unit_time"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="number" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="检测判断时间(s)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_decentralized_pulse_detection_time"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="堵转检测区间(%)" />

                        <TextView
                            android:id="@+id/tv_decentralized_stall_detection_interval"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint=""
                            android:textColor="@color/text_color_51B4F8"
                            tools:text="17%-55%" />

                    </LinearLayout>

                    <com.jaygoo.widget.RangeSeekBar
                        android:id="@+id/seekBar_decentralized_stall_detection_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:rsb_gravity="center"
                        app:rsb_max="100"
                        app:rsb_min="0"
                        app:rsb_mode="range"
                        app:rsb_progress_color="@color/text_color_51B4F8"
                        app:rsb_progress_default_color="#EDEDED"
                        app:rsb_thumb_drawable="@drawable/rsb_thumb_blue_stroke" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_line_bg_efefef" />

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="力矩堵转阈值(A)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_decentralized_torque_stall_threshold"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="力矩检测判断时间(s)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_decentralized_torque_detection_time"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="下放缓停区间(%)"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_decentralized_slow_stop_interval"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint=""
                            android:textColor="@color/text_color_51B4F8"
                            tools:text="17%-55%" />

                    </LinearLayout>

                    <com.jaygoo.widget.RangeSeekBar
                        android:id="@+id/seekBar_decentralized_slow_stop_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:rsb_gravity="center"
                        app:rsb_max="100"
                        app:rsb_min="0"
                        app:rsb_mode="single"
                        app:rsb_progress_color="#EDEDED"
                        app:rsb_progress_default_color="@color/text_color_51B4F8"
                        app:rsb_thumb_drawable="@drawable/rsb_thumb_blue_stroke" />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/decentralizedChildMaskLayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66ffffff"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                </RelativeLayout>

            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/white"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="上拉堵转检测"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold" />

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/pullUpEnableSBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/pullUpChildLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_line_bg_efefef" />

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="力矩堵转阈值(A)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_pull_up_torque_stall_threshold"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="力矩检测判断时间(s)" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_pull_up_torque_detection_time"
                            style="@style/Common_EditItem_EditText_Style"
                            android:inputType="numberDecimal" />

                    </LinearLayout>

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="上拉缓停区间(%)"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_pull_up_slow_stop_interval"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint=""
                            android:textColor="@color/text_color_51B4F8"
                            tools:text="17%-55%" />

                    </LinearLayout>

                    <com.jaygoo.widget.RangeSeekBar
                        android:id="@+id/seekBar_pull_up_slow_stop_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:rsb_gravity="center"
                        app:rsb_max="100"
                        app:rsb_min="0"
                        app:rsb_mode="single"
                        app:rsb_progress_color="#EDEDED"
                        app:rsb_progress_default_color="@color/text_color_51B4F8"
                        app:rsb_thumb_drawable="@drawable/rsb_thumb_blue_stroke" />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/pullUpChildMaskLayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66ffffff"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                </RelativeLayout>

            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <Button
                android:id="@+id/btn_confirm"
                style="@style/SubmitBordelessButtonStyle"
                android:text="保存" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/maskLayerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</androidx.core.widget.NestedScrollView>