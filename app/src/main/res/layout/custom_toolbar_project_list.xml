<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginStart="@dimen/dimen_size_16"
    android:layout_marginEnd="@dimen/dimen_size_16"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_weight="1"
        android:background="@drawable/bg_search_project_white"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="13dp"
            android:src="@drawable/ic_search_project" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="搜索项目"
            android:textColor="#ffb3b3b3"
            android:textSize="@dimen/text_size_13" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_view_in_map"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginStart="31dp"
        android:src="@drawable/ic_project_map" />

    <ImageView
        android:id="@+id/iv_filter"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginStart="27dp"
        android:src="@drawable/ic_filter_project_normal" />

</LinearLayout>

