<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.model.QuickConfigCommandParamEditItem" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        style="@style/Common_EditItem_Layout_Style"
        bgResId="@{m.bgResId}"
        tools:background="@drawable/layer_common_click_item_with_divider">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Common_ClickableItem_Title_Style"
            android:text="@{m.cmdChnName}"
            tools:text="扩展1" />

        <com.shmedo.mcloudapp.ui.widget.ClearEditText
            android:id="@+id/et_value"
            style="@style/Common_EditItem_EditText_Style"
            textViewEnabled="@{m.inputEnable }"
            android:hint='@{m.inputHint}'
            android:text="@={m.value}"
            app:lengthFilter="@{m.inputLengthFilter}"
            tools:hint="请输入" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</layout>