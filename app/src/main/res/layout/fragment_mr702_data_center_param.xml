<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702DataCenterParamViewModel" />

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.MR702DataCenterParamFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dimen_size_25">

                    <include
                        android:id="@+id/ll_data_center_param_head"
                        layout="@layout/data_center_param_head"
                        app:click="@{click}"
                        app:vm="@{stateVM}" />

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="数据中心地址" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/et_data_server_address"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="@={stateVM.centerServerAddress}"
                            app:isCharacterFilter="@{false}"
                            app:isNumberFilter="@{false}"
                            app:lengthFilter="@{100}" />

                    </LinearLayout>

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="数据中心端口" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/et_data_server_port"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:inputType="number"
                            android:text="@={stateVM.centerServerPort}"
                            app:lengthFilter="@{5}" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_ClickableItem_LayoutStyle"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isCenterOpened}"
                        android:onClick="@{()->click.onCommunicateWaySwitchClick()}">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="通信方式" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.communicateWay}"
                            tools:text="无线" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_ClickableItem_LayoutStyle"
                        android:enabled="@{stateVM.isCenterOpened}"
                        android:onClick="@{()->click.onIPTypeSwitchClick()}">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="网络协议" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.ipType}"
                            tools:text="IPV6" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_ClickableItem_LayoutStyle"
                        android:layout_marginTop="@dimen/dimen_size_8"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isCenterOpened}"
                        android:onClick="@{()->click.onTransferProtocolSwitchClick()}">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="传输协议" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.transferProtocol}"
                            tools:text="TCP" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_ClickableItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isCenterOpened}"
                        android:onClick="@{()->click.onDataProtocolSwitchClick()}">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="数据协议" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.dataProtocol}"
                            tools:text="MQTT" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_ClickableItem_LayoutStyle"
                        android:enabled="@{stateVM.isCenterOpened}"
                        android:onClick="@{()->click.onPlatformTypeSwitchClick()}">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:text="平台类型" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isCenterOpened}"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.platformType}"
                            tools:text="成都理工平台" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_mqtt"
                        visible="@{stateVM.isMqttItemVisible}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:layout_marginTop="@dimen/dimen_size_8"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="产品ID" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.productId}"
                                app:lengthFilter="@{100}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="设备ID" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.deviceId}"
                                app:lengthFilter="@{100}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="设备Key" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.deviceKey}"
                                app:lengthFilter="@{100}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="设备注册码" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.registerCode}"
                                app:lengthFilter="@{100}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="设备注册地址" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.registerAddress}"
                                app:lengthFilter="@{100}" />

                        </LinearLayout>

                        <LinearLayout style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="设备注册端口" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:inputType="number"
                                android:text="@={stateVM.registerPort}"
                                app:lengthFilter="@{5}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="心跳间隔(s)" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.maintainReportInterval}"
                                app:isNumberFilter="@{true}"
                                app:lengthFilter="@{4}" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_sl651"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        visible="@{stateVM.isSL651ItemVisible}"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/Common_ClickableItem_LayoutStyle"
                            android:layout_marginTop="@dimen/dimen_size_8"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:enabled="@{stateVM.isCenterOpened}"
                            android:onClick="@{()->click.onStationClassificationSwitchClick()}">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="测站分类" />

                            <TextView
                                style="@style/Common_ClickableItem_ValueStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:drawableEnd="@drawable/ic_arrow_down"
                                android:text="@{stateVM.stationType}"
                                tools:text="降水" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="中心站地址" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.centerStationAddr}"
                                app:isNumberFilter="@{true}"
                                app:lengthFilter="@{3}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="密码" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.password}"
                                app:isNumberFilter="@{true}"
                                app:lengthFilter="@{5}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_EditItem_LayoutStyle"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="测站编码" />

                            <com.shmedo.mcloudapp.common.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="@={stateVM.telemetryStationAddr}"
                                app:isCharacterFilter="@{true}"
                                app:lengthFilter="@{10}" />

                        </LinearLayout>

                        <LinearLayout
                            style="@style/Common_ClickableItem_LayoutStyle"
                            android:layout_marginTop="@dimen/dimen_size_8"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:enabled="@{stateVM.isCenterOpened}"
                            android:onClick="@{()->click.onToggleAdvancedClick()}">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:text="高级设置" />

                            <TextView
                                style="@style/Common_ClickableItem_ValueStyle"
                                android:drawableEnd="@{stateVM.isAdvancedItemVisible ? @drawable/ic_arrow_up_blue : @drawable/ic_arrow_down_blue}"
                                android:text='@{stateVM.isAdvancedItemVisible ? "收起" : "展开"}'
                                android:textColor="@color/colorPrimary"
                                tools:drawableEnd="@drawable/ic_arrow_down_blue"
                                tools:text="展开" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_advanced_items"
                            visible="@{stateVM.isAdvancedItemVisible}"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Common_ClickableItem_TitleStyle"
                                textViewEnabled="@{stateVM.isCenterOpened}"
                                android:layout_marginStart="@dimen/dimen_size_16"
                                android:layout_marginTop="@dimen/dimen_size_16"
                                android:text="报文选择" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dimen_size_16"
                                android:padding="@dimen/dimen_size_14"
                                app:drawable_radius="@{4}"
                                app:drawable_solidColor="@{@color/gray_f5f6f8}"
                                tools:background="@color/gray_f5f6f8">

                                <CheckBox
                                    android:id="@+id/hourlyReportCheckBox"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:button="@drawable/radiobutton_selector"
                                    android:checked="@={stateVM.hourlyReport}"
                                    android:text="小时报"
                                    android:textColor="@color/title_text_color"
                                    android:textSize="@dimen/text_size_16"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:checked="true" />

                                <CheckBox
                                    android:id="@+id/timingReportCheckBox"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/dimen_size_35"
                                    android:button="@drawable/radiobutton_selector"
                                    android:checked="@={stateVM.timingReport}"
                                    android:text="定时报"
                                    android:textColor="@color/title_text_color"
                                    android:textSize="@dimen/text_size_16"
                                    app:layout_constraintStart_toEndOf="@+id/hourlyReportCheckBox"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <CheckBox
                                    android:id="@+id/addReportCheckBox"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/dimen_size_35"
                                    android:button="@drawable/radiobutton_selector"
                                    android:checked="@={stateVM.addReport}"
                                    android:text="加报报"
                                    android:textColor="@color/title_text_color"
                                    android:textSize="@dimen/text_size_16"
                                    app:layout_constraintStart_toEndOf="@+id/timingReportCheckBox"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <CheckBox
                                    android:id="@+id/maintainReportCheckBox"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dimen_size_10"
                                    android:button="@drawable/radiobutton_selector"
                                    android:checked="@={stateVM.maintainReport}"
                                    android:text="维持报"
                                    android:textColor="@color/title_text_color"
                                    android:textSize="@dimen/text_size_16"
                                    app:layout_constraintStart_toStartOf="@+id/hourlyReportCheckBox"
                                    app:layout_constraintTop_toBottomOf="@+id/hourlyReportCheckBox" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/dimen_size_16"
                                android:layout_marginEnd="@dimen/dimen_size_16"
                                android:background="@color/divider_line_bg" />

                            <LinearLayout
                                style="@style/Common_EditItem_LayoutStyle"
                                android:background="@drawable/layer_common_click_item_with_divider">

                                <TextView
                                    style="@style/Common_ClickableItem_TitleStyle"
                                    textViewEnabled="@{stateVM.isCenterOpened}"
                                    android:text="维持上报间隔(s)" />

                                <com.shmedo.mcloudapp.common.widget.ClearEditText
                                    style="@style/Common_EditItem_EditText_Style"
                                    textViewEnabled="@{stateVM.isCenterOpened}"
                                    android:text="@={stateVM.maintainReportInterval}"
                                    app:isNumberFilter="@{true}"
                                    app:lengthFilter="@{3}" />

                            </LinearLayout>

                            <LinearLayout
                                style="@style/Common_EditItem_LayoutStyle"
                                android:background="@drawable/layer_common_click_item_with_divider">

                                <TextView
                                    style="@style/Common_ClickableItem_TitleStyle"
                                    textViewEnabled="@{stateVM.isCenterOpened}"
                                    android:text="数据补发有效时间(日)" />

                                <com.shmedo.mcloudapp.common.widget.ClearEditText
                                    style="@style/Common_EditItem_EditText_Style"
                                    textViewEnabled="@{stateVM.isCenterOpened}"
                                    android:text="@={stateVM.reissuingDataValidDays}"
                                    app:isNumberFilter="@{true}"
                                    app:lengthFilter="@{3}" />

                            </LinearLayout>

                            <LinearLayout
                                style="@style/Common_EditItem_LayoutStyle"
                                android:background="@drawable/layer_common_click_item_with_divider">

                                <TextView
                                    style="@style/Common_ClickableItem_TitleStyle"
                                    textViewEnabled="@{stateVM.isCenterOpened}"
                                    android:text="数据补发间隔(min)" />

                                <com.shmedo.mcloudapp.common.widget.ClearEditText
                                    style="@style/Common_EditItem_EditText_Style"
                                    textViewEnabled="@{stateVM.isCenterOpened}"
                                    android:text="@={stateVM.reissuingDataInterval}"
                                    app:isNumberFilter="@{true}"
                                    app:lengthFilter="@{4}" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </com.drake.brv.PageRefreshLayout>

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onSubmitClick()}"
            visible="@{stateVM.isEditable &amp;&amp; stateVM.isCenterOpened}"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="15dp"
            android:text="保存"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/refreshLayout" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
