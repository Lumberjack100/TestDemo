<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/main_bg_gray"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:id="@+id/channelOneLayout"
        style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="通道1" />

        <TextView
            android:id="@+id/tv_channel_one"
            style="@style/Common_ClickableItem_ValueStyle"
            android:textSize="17sp"
            tools:text="未启用" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:id="@+id/channelTwoLayout"
        style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="通道2" />

        <TextView
            android:id="@+id/tv_channel_two"
            style="@style/Common_ClickableItem_ValueStyle"
            android:textSize="17sp"
            tools:text="未启用" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:id="@+id/channelThreeLayout"
        style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="通道3" />

        <TextView
            android:id="@+id/tv_channel_three"
            style="@style/Common_ClickableItem_ValueStyle"
            android:textSize="17sp"
            tools:text="未启用" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:id="@+id/channelFourLayout"
        style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="通道4" />

        <TextView
            android:id="@+id/tv_channel_four"
            style="@style/Common_ClickableItem_ValueStyle"
            android:textSize="17sp"
            tools:text="未启用" />

    </LinearLayout>

</LinearLayout>