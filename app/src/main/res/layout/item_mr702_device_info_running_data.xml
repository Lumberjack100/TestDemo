<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.model.MRRunningDataItem" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:orientation="vertical"
        android:paddingTop="@dimen/dimen_size_20"
        android:paddingBottom="@dimen/dimen_size_20"
        app:drawable_radiusRT="@{4}"
        app:drawable_solidColor="@{@color/gray_f5f6f8}"
        tools:background="@color/gray_f5f6f8">

        <androidx.appcompat.widget.AppCompatTextView
            visible="@{!m.num1.empty}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/dimen_size_5"
            android:maxLines="2"
            android:text="@{m.num1}"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="32.5%" />

        <androidx.appcompat.widget.AppCompatTextView
            visible="@{!m.num2.empty}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/dimen_size_5"
            android:layout_marginTop="@dimen/dimen_size_4"
            android:maxLines="2"
            android:text="@{m.num2}"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            tools:text="已用5.2GB/16GB" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/dimen_size_5"
            android:layout_marginTop="@dimen/dimen_size_4"
            android:text="@{m.name}"
            android:textColor="@color/text_color_666666"
            android:textSize="15sp"
            tools:text="单次运行时长(小时)" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</layout>