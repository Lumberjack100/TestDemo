<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.MR702RS485Port2SensorParamViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.collector_product.fragment.mr702.port.MR702RS485Port2SensorParamFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/page_content_container_padding_horizontal_12"
                    android:paddingTop="@dimen/page_content_container_padding_top_12"
                    android:paddingBottom="@dimen/page_content_container_padding_bottom_100">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/shape_common_click_item_top_corner_4">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:background="@color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_GroupItem_Title_Style"
                            android:layout_marginStart="@dimen/dimen_size_8"
                            android:text="通道参数" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            android:text="物模型名称" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Value_Style"
                            android:drawableEnd="@null"
                            android:text="@{stateVM.modelName}"
                            tools:text="MODO渗压计" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            android:text="物模型编号" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            android:enabled="@{stateVM.isAdd}"
                            android:hint="请输入"
                            android:inputType="phone"
                            android:text="@={stateVM.modelToken}"
                            app:lengthFilter="@{8}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            android:text="通道编号" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint="数值范围[1-16]"
                            android:inputType="number"
                            android:text="@={stateVM.channelNumber}"
                            app:lengthFilter="@{2}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="水文标识" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:hint="请输入"
                            android:text="@={stateVM.hydrologicalIdentification}"
                            app:lengthFilter="@{6}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ll_advanced_items"
                        visible='@{stateVM.modelToken.contains("10066")}'
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_ClickableItem_Layout_Style"
                            onClickWithDebouncing="@{()->click.onIsCalculateChooseClick()}"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:enabled="@{stateVM.isEditable }">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="是否计算" />

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Value_Style"
                                textViewEnabled="@{stateVM.isEditable }"

                                android:text="@{stateVM.calculate}"
                                tools:text="是" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_ClickableItem_Layout_Style"
                            onClickWithDebouncing="@{()->click.onCalculateFormulaChooseClick()}"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:enabled="@{stateVM.isEditable }">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="计算公式" />

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Value_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="@{stateVM.calculateFormula}"
                                tools:text="直线式" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="灵敏度K值" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.sensitivityK}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="温度修正系数b值" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.temperatureCorrectionCoefficientB}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="初始频率F0值" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.initialFrequencyF0}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="初始温度T0值" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.initialTemperatureT0}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="初始水位值（米）" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.initialWaterLevel}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/shape_common_click_item_bottom_corner_4">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="堰角高度值（米）" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.weirHeight}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:visibility="gone">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="多项式系数 A" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.polyA}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:visibility="gone">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="多项式系数 B" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.polyB}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider"
                            android:visibility="gone">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.isEditable }"
                                android:text="多项式系数 C" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                textViewEnabled="@{stateVM.isEditable}"
                                android:hint="请输入"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLength="17"
                                android:text="@={stateVM.polyC}" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:layout_marginTop="@dimen/page_content_item_margin_top_12"
                        android:background="@drawable/shape_common_click_item_top_corner_4">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:background="@color/black" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_GroupItem_Title_Style"
                            android:layout_marginStart="@dimen/dimen_size_8"
                            android:text="通道采集数据处理" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="滤波次数" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:hint="请输入"
                            android:text="@={stateVM.filterCoefficient}"
                            app:lengthFilter="@{100}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="触发值" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:hint="请输入"
                            android:text="@={stateVM.triggerValue}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="上限值" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:hint="请输入"
                            android:text="@={stateVM.upperLimit}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="下限值" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:hint="请输入"
                            android:text="@={stateVM.lowerLimit}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_Layout_Style"
                        android:background="@drawable/shape_common_click_item_bottom_corner_4">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="修正值" />

                        <com.shmedo.mcloudapp.ui.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:hint="请输入"
                            android:text="@={stateVM.correctValue}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.button.MaterialButton
                        style="@style/SubmitButton_Style"
                        onClickWithDebouncing="@{()->click.onSubmitButtonClick()}"
                        android:layout_marginTop="@dimen/reset_button_margin_top_50"
                        android:text="@string/button_save_text" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>