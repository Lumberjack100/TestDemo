<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:id="@+id/ll_reporting_method"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据上报方式" />

            <TextView
                android:id="@+id/tv_reporting_method"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp"
                tools:text="网关召测" />

        </LinearLayout>

        <LinearLayout style="@style/Common_EditItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据上报间隔(s)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_reporting_interval"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <LinearLayout
            android:id="@+id/ll_aisle_address"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="通道网络号" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_network_number"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_channel_number"
            style="@style/Common_EditItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="通道信道号" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_channel_number"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <LinearLayout
            android:id="@+id/ll_air_speed"
            style="@style/Common_EditItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="空中波特率" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_air_baud_rate"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_confirm"
            style="@style/SubmitBordelessButtonStyle"
            android:text="保存" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>