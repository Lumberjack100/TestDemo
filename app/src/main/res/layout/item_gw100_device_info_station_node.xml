<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.model.DeviceStatusInfoBasicItem" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        style="@style/DeviceCurrentState_Item_Layout_Style"
        android:background="@drawable/layer_common_click_item_with_divider">

        <com.google.android.material.textview.MaterialTextView
            style="@style/DeviceCurrentState_Item_Title_Style"
            android:maxLines="1"
            android:text="@{m.name}"
            tools:text="设备SN" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/DeviceCurrentState_Item_Value_Style"
            android:text="@{m.value}"
            tools:text="modo-1819929190" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>