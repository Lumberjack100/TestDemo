<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            android:id="@+id/tv_trigger_threshold"
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="触发值(单位:mm)" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_trigger_threshold"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberSigned|numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/correction_layout"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            android:id="@+id/tv_correctValue"
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="修正值(单位:m)" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_correctValue"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberSigned|numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/extension_layout1"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_extension1"
            style="@style/Common_ClickableItem_TitleStyle"
            tools:text="扩展1" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_extension1"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberSigned|numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/extension_layout2"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_extension2"
            style="@style/Common_ClickableItem_TitleStyle"
            tools:text="扩展2" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_extension2"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberSigned|numberDecimal" />

    </LinearLayout>


</LinearLayout>