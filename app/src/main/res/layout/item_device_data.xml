<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.core.model.CloudDeviceData" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dimen_size_10"
        android:paddingEnd="@dimen/dimen_size_10"
        android:paddingBottom="@dimen/dimen_size_10">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_data_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@{m.timeStr}"
            android:textColor="@color/title_text_color"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="2020.07.18 17:23:32" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_data_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/title_text_color"
            android:textSize="15sp"
            tools:text="//_string : 加密之后的偏移量
//ip : 服务器ip
//port : 服务器端口
//random_base : 保存加密基数
//return : 返回0代表成功,-1代表失败
int offset_encrypt(char *_string, const char *ip, const int port, int random_base);" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>
