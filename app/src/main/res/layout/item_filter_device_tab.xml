<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.model.FilterDeviceTabItem" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dimen_size_5"
        app:drawable_radius="@{20}"
        app:drawable_solidColor="@{@color/gray_f5f6f8}"
        tools:background="@color/gray_f5f6f8">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimen_size_5"
            android:text="@{m.value}"
            android:textColor="@color/title_text_color"
            android:textSize="@dimen/text_size_13"
            tools:text="定时定点上报" />

        <androidx.appcompat.widget.AppCompatImageView
            visible="@{m.showDropDown}"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="@dimen/dimen_size_5"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_arrow_down" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>