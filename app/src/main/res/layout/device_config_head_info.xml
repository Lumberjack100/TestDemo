<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="18dp">

        <ImageView
            android:id="@+id/iv_device_logo"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/ic_device_logo_def" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxEms="8"
                    android:singleLine="true"
                    android:textColor="@color/text_color_1f1f1f"
                    android:textSize="@dimen/text_size_16"
                    tools:text="物联网数据采集器凤飞飞方法旺旺sss" />

                <TextView
                    android:id="@+id/tv_device_state_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_device_offline_state_flag"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:singleLine="true"
                    android:textSize="@dimen/text_size_10"
                    android:text="已断开"
                    android:textColor="@color/sub_title_text_color" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_device_sn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="设备编号：183123R" />

            <TextView
                android:id="@+id/tv_product_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="产品型号：DAS" />

            <TextView
                android:id="@+id/tv_time_or_sub_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="采集器型号：裂缝采集器凤飞飞方法旺旺sss" />

            <TextView
                android:id="@+id/tv_platform_communication_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="米度平台连接状态：在线" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_device_connect_operate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:singleLine="true"
            android:textColor="@color/text_color_b3b3b3"
            android:textSize="@dimen/text_size_13"
            android:visibility="invisible"
            tools:text="断开连接"
            tools:visibility="visible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider_line_bg_efefef" />

</LinearLayout>