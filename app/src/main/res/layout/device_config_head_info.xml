<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vm"
            type="com.shmedo.mcloudapp.device.viewmodel.state.CommonDeviceHomeViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/iv_device_logo"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:src="@drawable/ic_device_logo_def" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text_color_1f1f1f"
                        android:textSize="@dimen/text_size_15"
                        android:text="@{vm.deviceName}"
                        tools:text="DAS-RDS" />

                    <TextView
                        android:id="@+id/tv_device_state_flag"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginStart="5dp"
                        android:background="@{vm.isOnline()?@drawable/bg_device_online_state_flag:@drawable/bg_device_offline_state_flag}"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:singleLine="true"
                        android:text="@{vm.onlineStatus}"
                        android:textColor="@{vm.isOnline()?@color/text_color_50E9B9:@color/sub_title_text_color}"
                        tools:text="已断开"
                        tools:textColor="@color/sub_title_text_color"
                        tools:background="@drawable/bg_device_offline_state_flag"
                        android:textSize="@dimen/text_size_10" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_device_sn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:singleLine="true"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13"
                    android:text="@{vm.deviceToken}"
                    tools:text="设备SN号：21E118L" />

                <TextView
                    android:id="@+id/tv_product_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13"
                    android:text="@{vm.productName}"
                    tools:text="所属产品：DAS-V1.5-雷达物位采集器" />

                <TextView
                    android:id="@+id/tv_firmware_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13"
                    android:text="@{vm.firmwareVersion}"
                    tools:text="固件版本：3.1.10_Q12" />

                <TextView
                    android:id="@+id/tv_extended_field3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13"
                    android:text="@{vm.extendedField3}"
                    tools:text="运行状态：等待"
                    visible="@{vm.isExtendedField3Visible}"/>

                <TextView
                    android:id="@+id/tv_platform_communication_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:textColor="@color/sub_title_text_color"
                    android:textSize="@dimen/text_size_13"
                    android:text="@{vm.platformConnectionState}"
                    tools:text="米度平台连接状态：在线"
                    visible="@{vm.isPlatformConnectionStateVisible}"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_device_connect_operate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:singleLine="true"
                android:textColor="@color/text_color_b3b3b3"
                android:textSize="@dimen/text_size_13"
                android:text="@{vm.connectOperate}"
                tools:text="断开连接"
                tools:visibility="visible"
                visible="@{vm.isConnectOperateVisible}"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider_line_bg_efefef" />

    </LinearLayout>
</layout>