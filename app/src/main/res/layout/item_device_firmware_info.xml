<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.device.model.FirmWareInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="@dimen/dimen_size_15"
        android:paddingEnd="@dimen/dimen_size_15"
        android:paddingTop="@dimen/dimen_size_8"
        android:paddingBottom="@dimen/dimen_size_8">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/title_text_color"
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:text="@{m.fwName}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="灾害类型-改变林地用途滥盗滥伐破坏林业设施非法采药" />

        <TextView
            android:id="@+id/tv_firmware_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text='@{`版本号：`+m.fwVersion}'
            android:textColor="@color/text_color_666666"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"
            tools:text="版本号：4.1.10" />

        <TextView
            android:id="@+id/tv_upload_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text='@{`上传时间：`+m.uploadTime}'
            android:textColor="@color/text_color_666666"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_firmware_version"
            tools:text="上传时间：2022-12-04 12:23:53" />

        <TextView
            android:id="@+id/tv_firmware_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{m.fwStatus==0?`固件环境：测试`:`固件环境：运营`}"
            android:textColor="@color/text_color_666666"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_upload_time"
            tools:text="固件环境：测试" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>