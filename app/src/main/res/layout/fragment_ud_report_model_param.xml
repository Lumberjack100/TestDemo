<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.UDReportModelParamViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.u_product.fragment.ud.UDReportModelParamFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/page_content_container_padding_horizontal_12"
                    android:paddingTop="@dimen/page_content_container_padding_top_12"
                    android:paddingBottom="@dimen/page_content_container_padding_bottom_100">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_Layout_Style"
                        android:background="@drawable/layer_common_click_item_top_corner_4_with_divider"
                        android:onClick="@{()->click.onModelChooseClick()}">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Title_Style"
                            android:text="上报模式" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Common_ClickableItem_Value_Style"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.reportModel}"
                            tools:text="自动" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        visible='@{stateVM.reportModel == "自动"}'
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            style="@style/SwitchButton_Item_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/SwitchButton_Item_Title_Style"
                                android:text="四级报警启用" />

                            <com.kyleduo.switchbutton.SwitchButton
                                style="@style/SwitchButton_Item_Button_Style"
                                android:checked="@={stateVM.alarmEnable}"
                                app:kswAnimationDuration="100"
                                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                        </RelativeLayout>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.firstAlarmThresholdTitle}"
                                tools:text="一级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                enabledTextColor="@{@color/sub_title_text_color_black_60}"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:text="@={stateVM.firstAlarmThreshold}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.secondAlarmThresholdTitle}"
                                tools:text="二级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                enabledTextColor="@{@color/sub_title_text_color_black_60}"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:text="@={stateVM.secondAlarmThreshold}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/layer_common_click_item_with_divider">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.thirdAlarmThresholdTitle}"
                                tools:text="三级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                enabledTextColor="@{@color/sub_title_text_color_black_60}"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:text="@={stateVM.thirdAlarmThreshold}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_EditItem_Layout_Style"
                            android:background="@drawable/shape_common_click_item_bottom_corner_4">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                textViewEnabled="@{stateVM.alarmEnable}"
                                android:text="@{stateVM.fourthAlarmThresholdTitle}"
                                tools:text="四级报警阈值(毫米)" />

                            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                                style="@style/Common_EditItem_EditText_Style"
                                enabledTextColor="@{@color/sub_title_text_color_black_60}"
                                textViewEnabled="@{stateVM.alarmEnable }"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:maxLength="6"
                                android:text="@={stateVM.fourthAlarmThreshold}" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        visible='@{stateVM.reportModel == "手动"}'
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        tools:visibility="gone">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            style="@style/Common_ClickableItem_Layout_Style"
                            android:background="@drawable/shape_common_click_item_bottom_corner_4"
                            android:onClick="@{()->click.onReportFrequencyChooseClick()}">

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Title_Style"
                                android:text="上报频率" />

                            <com.google.android.material.textview.MaterialTextView
                                style="@style/Common_ClickableItem_Value_Style"
                                android:drawableEnd="@drawable/ic_arrow_down"
                                android:text="@{stateVM.reportFrequency}"
                                tools:text="自动" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset"
                        style="@style/ResetButton_Style2"
                        android:layout_marginTop="@dimen/reset_button_margin_top_50"
                        android:onClick="@{()->click.onResetClick()}"
                        android:text="@string/button_reset_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirm"
                        style="@style/SubmitButton_Style2"
                        onClickWithDebouncing="@{()->click.onSubmitButtonClick()}"
                        android:layout_marginTop="@dimen/summit_button_margin_top_20"
                        android:text="@string/button_save_text" />

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>