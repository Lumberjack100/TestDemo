<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.NetDeviceListViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.NetDeviceListFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/search_placeholder"
            layout="@layout/search_device_placeholder_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:click="@{click}"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/ll_statistics"
            layout="@layout/include_net_device_list_statistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/search_placeholder"
            app:vm="@{stateVM}" />

        <View
            android:id="@+id/head_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_statistics" />

        <FrameLayout
            android:id="@+id/fl_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingTop="@dimen/dimen_size_3"
            android:paddingBottom="@dimen/dimen_size_3"
            app:layout_constraintTop_toBottomOf="@+id/head_line">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dimen_size_16"
                android:layout_marginEnd="@dimen/dimen_size_20"
                app:tabGravity="start"
                app:tabIndicatorHeight="0dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="@dimen/dimen_size_8"
                app:tabPaddingStart="0dp"
                app:tabRippleColor="@null" />

            <ImageView
                android:id="@+id/iv_select_product"
                android:layout_width="33dp"
                android:layout_height="56dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/dimen_size_10"
                onClickWithDebouncing="@{() -> click.onShowSelectProductPopup()}"
                android:src="@drawable/all_img" />

        </FrameLayout>

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_tab">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_device"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/dimen_size_10"
                android:paddingTop="10dp"
                android:paddingRight="@dimen/dimen_size_10"
                android:paddingBottom="@dimen/dimen_size_10"
                android:splitMotionEvents="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/item_device_info" />

        </com.drake.brv.PageRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>