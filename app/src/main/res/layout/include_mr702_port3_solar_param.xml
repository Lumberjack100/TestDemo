<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702RS485Port3SensorParamViewModel" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="太阳能板电压(V)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:hint="请输入"
                android:text="@={stateVM.solarVoltage}"
                app:isCharacterFilter="@{false}"
                app:isNumberFilter="@{false}"
                app:lengthFilter="@{4}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="电池电压(V)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:hint="请输入"
                android:text="@={stateVM.batteryVoltage}"
                app:isCharacterFilter="@{false}"
                app:isNumberFilter="@{false}"
                app:lengthFilter="@{4}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="太阳能板功率(W)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:hint="请输入"
                android:text="@={stateVM.solarPower}"
                app:isCharacterFilter="@{false}"
                app:isNumberFilter="@{false}"
                app:lengthFilter="@{4}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:text="负载功率(W)"
                tools:textColor="@color/title_text_color" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                android:hint="请输入"
                android:text="@={stateVM.loadPower}"
                app:isCharacterFilter="@{false}"
                app:isNumberFilter="@{false}"
                app:lengthFilter="@{4}" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>