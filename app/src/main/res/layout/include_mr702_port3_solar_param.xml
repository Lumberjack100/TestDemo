<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702RS485Port3SensorParamViewModel" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="太阳能板电压(V)" />

            <TextView
                style="@style/Common_ClickableItem_ValueStyle"
                android:drawableEnd="@null"
                android:text="@{stateVM.solarVoltage}"
                android:textSize="17sp"
                tools:text="已接入" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="电池电压(V)" />

            <TextView
                style="@style/Common_ClickableItem_ValueStyle"
                android:drawableEnd="@null"
                android:text="@{stateVM.batteryVoltage}"
                android:textSize="17sp"
                tools:text="已接入" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="太阳能板功率(W)" />

            <TextView
                style="@style/Common_ClickableItem_ValueStyle"
                android:drawableEnd="@null"
                android:text="@{stateVM.solarPower}"
                android:textSize="17sp"
                tools:text="已接入" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="负载功率(W)" />

            <TextView
                style="@style/Common_ClickableItem_ValueStyle"
                android:drawableEnd="@null"
                android:text="@{stateVM.loadPower}"
                android:textSize="17sp"
                tools:text="已接入" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>