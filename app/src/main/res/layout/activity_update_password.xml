<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_f2f2f2"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar_primary_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="@dimen/dimen_size_15"
        android:layout_marginTop="@dimen/dimen_size_30"
        android:layout_marginEnd="@dimen/dimen_size_15"
        android:background="@drawable/update_password_edittext_shape"
        android:gravity="center_vertical">

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/newPasswordET"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:hint="请输入新密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/title_text_color"
            android:textColorHint="@color/text_color_cccccc"
            android:textSize="@dimen/text_size_16" />

        <ImageView
            android:id="@+id/iv_eye_new_password"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="25dp"
            android:src="@drawable/icon_eye_close" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="@dimen/dimen_size_15"
        android:layout_marginTop="@dimen/dimen_size_10"
        android:layout_marginEnd="@dimen/dimen_size_15"
        android:background="@drawable/update_password_edittext_shape"
        android:gravity="center_vertical">

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/confirmNewPasswordET"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:hint="请输入确认密码"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/title_text_color"
            android:textColorHint="@color/text_color_cccccc"
            android:textSize="@dimen/text_size_16" />

        <ImageView
            android:id="@+id/iv_eye_confirm_password"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="25dp"
            android:src="@drawable/icon_eye_close" />

    </LinearLayout>


    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_select"
        android:foreground="?attr/selectableItemBackground"
        android:text="完成"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_20" />

</LinearLayout>

