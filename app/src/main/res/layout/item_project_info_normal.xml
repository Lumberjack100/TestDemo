<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_corner_6dp_white"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_marginLeft="@dimen/card_item_side_margin"
        android:layout_marginRight="@dimen/card_item_side_margin">

        <ImageView
            android:id="@+id/iv_outdate_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:src="@drawable/ic_expired_project" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/card_item_padding_left"
            android:paddingTop="@dimen/card_item_padding_top"
            android:paddingEnd="@dimen/card_item_padding_right"
            android:paddingBottom="@dimen/card_item_padding_bottom">

            <ImageView
                android:id="@+id/ic_thumbnail"
                android:layout_width="@dimen/project_info_icon_size"
                android:layout_height="@dimen/project_info_icon_size"
                android:layout_alignParentStart="true"
                tools:src="@drawable/ic_project_default" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@+id/ic_thumbnail"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_project_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold"
                    tools:text="云南德宏州S318芒那线公路边坡监测系统xxx第三期中标" />

                <TextView
                    android:id="@+id/tv_company_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_color_9a9a9a"
                    android:textSize="@dimen/text_size_13"
                    tools:text="惠山区洛社镇XX社区" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp">

                    <TextView
                        android:id="@+id/tv_create_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text_color_9a9a9a"
                        android:textSize="@dimen/text_size_13"
                        tools:text="2018.11.16 09:38" />

                    <TextView
                        android:id="@+id/tv_top_flag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_corner_2dp_f6f6f6"
                        android:paddingStart="5dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="5dp"
                        android:paddingBottom="3dp"
                        android:text="已置顶"
                        android:textColor="#ffa6a6a6"
                        android:textSize="@dimen/text_size_11"
                        android:visibility="gone" />

                </RelativeLayout>

            </LinearLayout>

        </RelativeLayout>

    </FrameLayout>


</LinearLayout>

