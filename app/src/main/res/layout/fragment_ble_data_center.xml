<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingStart="16.5dp"
            android:text="通用设置"
            android:textColor="@color/sub_title_text_color"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/communicationMethodLayout"
                style="@style/Common_ClickableItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="通讯方式" />

                <TextView
                    android:id="@+id/tv_communication_method"
                    style="@style/Common_ClickableItem_ValueStyle"
                    android:textSize="17sp"
                    tools:text="4g" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上报间隔(min)"
                    android:textColor="@color/text_color_343434"
                    android:textSize="@dimen/text_size_17" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/reportingIntervalET"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dimen_size_25"
                    android:layout_weight="1"
                    android:background="@null"
                    android:drawablePadding="@dimen/dimen_size_15"
                    android:gravity="center_vertical|right"
                    android:hint="请输入"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/text_color_666666"
                    android:textColorHint="@color/text_color_cccccc"
                    android:textSize="@dimen/text_size_17" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="北斗目标卡号"
                    android:textColor="@color/text_color_343434"
                    android:textSize="@dimen/text_size_17" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/bdCardNumberET"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dimen_size_25"
                    android:layout_weight="1"
                    android:background="@null"
                    android:drawablePadding="@dimen/dimen_size_15"
                    android:gravity="center_vertical|right"
                    android:hint="请输入"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/text_color_666666"
                    android:textColorHint="@color/text_color_cccccc"
                    android:textSize="@dimen/text_size_17" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/white"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="中心1配置"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_15" />


                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/linkOneSBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_link_one_child"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout
                    android:id="@+id/linkOneCommunicationProtocolLayout"
                    style="@style/Common_ClickableItem_LayoutStyle">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="通讯协议" />

                    <TextView
                        android:id="@+id/tv_link_one_communication_protocol"
                        style="@style/Common_ClickableItem_ValueStyle"
                        android:textSize="17sp"
                        tools:text="4g" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="数据服务器地址"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/link_one_service_addressET"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/dimen_size_25"
                        android:layout_weight="1"
                        android:background="@null"
                        android:drawablePadding="@dimen/dimen_size_15"
                        android:gravity="center_vertical|right"
                        android:hint="请输入"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_color_666666"
                        android:textColorHint="@color/text_color_cccccc"
                        android:textSize="@dimen/text_size_17" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/white"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="中心2配置"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_15" />


                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/linkTwoSBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_link_two_child"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout
                    android:id="@+id/linkTwoCommunicationProtocolLayout"
                    style="@style/Common_ClickableItem_LayoutStyle">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="通讯协议" />

                    <TextView
                        android:id="@+id/tv_link_two_communication_protocol"
                        style="@style/Common_ClickableItem_ValueStyle"
                        android:textSize="17sp"
                        tools:text="4g" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="数据服务器地址"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/link_two_service_addressET"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/dimen_size_25"
                        android:layout_weight="1"
                        android:background="@null"
                        android:drawablePadding="@dimen/dimen_size_15"
                        android:gravity="center_vertical|right"
                        android:hint="请输入"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_color_666666"
                        android:textColorHint="@color/text_color_cccccc"
                        android:textSize="@dimen/text_size_17" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>