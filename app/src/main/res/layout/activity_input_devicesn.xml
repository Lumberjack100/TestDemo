<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg2_light_white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="vertical"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="输入设备SN号"
        android:textSize="26dp"
        android:textColor="@color/black_text"
        android:textStyle="bold"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SN号一般位于设备正面、底部标签位置"
        android:textSize="14sp"
        android:layout_marginTop="15dp"
        />
        <com.shmedo.mcloudapp.views.ClearEditText
            android:id="@+id/input_sn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入设备SN号"
            android:layout_marginTop="60dp"
            android:paddingLeft="10dp"
            />
        <Button
            android:id="@+id/add_device"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="立即添加"
            android:background="@drawable/scan_add_selector"
            android:textColor="@color/white"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            />
    </LinearLayout>
</LinearLayout>