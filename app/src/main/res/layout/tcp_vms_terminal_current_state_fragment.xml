<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/main_bg_gray"
            android:padding="16dp"
            android:text="基本信息"
            android:textColor="@color/sub_title_text_color"
            android:textSize="15sp" />

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备 SN 号"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_device_sn"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                android:textColor="@color/text_color_3AD094"
                tools:text="19F00L" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网络号"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_net_id"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="19902102313" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="地址"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_address"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="1001" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通讯信道"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_channel"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="01" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="注册时间"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_register_time"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="2020.10.21 13:22:34" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新时间"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_update_time"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="2020.10.21 13:22:34" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/main_bg_gray"
            android:padding="16dp"
            android:text="通讯状态"
            android:textColor="@color/sub_title_text_color"
            android:textSize="15sp" />

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上行信号强度"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_uplink_signal_strength"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="-89" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下行信号强度"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_downlink_signal_strength"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="-98" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发送数据"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_send_data"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="23" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="接收数据"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_receive_data"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="11" />

        </LinearLayout>

        <LinearLayout style="@style/DeviceCurrentState_SingleItem_Style">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="终端电压"
                android:textColor="@color/title_text_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_power_volt"
                style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                tools:text="22.5V" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/main_bg_gray"
            android:padding="16dp"
            android:text="传感器状态"
            android:textColor="@color/sub_title_text_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_corner_3dp_gray_f5f6f8"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="中心1"
                android:textColor="@color/sub_title_text_color"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#E5E5E5" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_link_one_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/title_text_color"
                        android:textSize="17sp"
                        tools:text="良好" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="状态"
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_link_one_send_data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/title_text_color"
                        android:textSize="17sp"
                        tools:text="878" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="已发送"
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_link_one_unsend_data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/title_text_color"
                        android:textSize="17sp"
                        tools:text="21" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="未发送"
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_link_one_online_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/title_text_color"
                        android:textSize="17sp"
                        tools:text="87%" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="在线率"
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sensor_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:splitMotionEvents="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>