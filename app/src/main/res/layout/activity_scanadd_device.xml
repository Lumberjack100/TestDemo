<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main_light_white"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="欢迎使用米易通"
            android:textSize="26dp"
            android:textColor="@color/black_333333"
            android:textStyle="bold"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="规范配置，爱惜设备"
            android:textSize="14sp"
            android:layout_marginTop="15dp"
            />
        <Button
            android:id="@+id/scan_config"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="扫码配置"
            android:background="@drawable/scan_add_selector"
            android:textColor="@color/white"
            android:layout_marginTop="40dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            />
        <Button
            android:id="@+id/input_config"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="手动输入设备SN号"
            android:background="@drawable/scan_selector"
            android:textColor="@color/font_main"
            android:layout_margin="20dp"
            />
    </LinearLayout>

</LinearLayout>