<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702HomeViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.common.BaseClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="@dimen/dimen_size_10"
        android:paddingEnd="@dimen/dimen_size_10">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_size_5"
            android:paddingTop="@dimen/dimen_size_10"
            android:paddingBottom="@dimen/dimen_size_10">

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{vm.productName}"
                android:textColor="@color/title_text_color"
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="智能遥测终端机" />

            <TextView
                android:id="@+id/tv_device_state_flag"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:background="@{vm.isDeviceStateTagHighLight()?@drawable/bg_device_online_state_flag:@drawable/bg_device_offline_state_flag}"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@{vm.deviceStateTagText}"
                android:textColor="@{vm.isDeviceStateTagHighLight()?@color/device_online_foreground:@color/device_offline_foreground}"
                android:textSize="@dimen/text_size_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_product_name"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="@drawable/bg_device_offline_state_flag"
                tools:text="已断开"
                tools:textColor="@color/device_offline_foreground" />

            <TextView
                android:id="@+id/tv_device_connect_operate"
                visible="@{vm.isConnectOperateVisible}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@{!vm.isDeviceStateTagHighLight()?@drawable/ic_ble_connect:@drawable/ic_ble_disconnect}"
                android:drawablePadding="@dimen/dimen_size_4"
                onClickWithDebouncing="@{()->click.onConnectOperateClick()}"
                android:text="@{vm.connectOperateText}"
                android:textColor="@{!vm.isDeviceStateTagHighLight()?@color/connect_ble_foreground:@color/disconnect_ble_foreground}"
                android:textSize="@dimen/text_size_13"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:drawableStartCompat="@drawable/ic_ble_connect"
                tools:text="蓝牙连接"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/dimen_size_5"
            android:background="@color/divider_line_bg" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/dimen_size_8"
            android:paddingBottom="@dimen/dimen_size_8">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_device_logo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_mr702"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_size_5"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_device_logo"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ll_device_sn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_device_sn_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设备编号："
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="@dimen/text_size_13" />

                    <TextView
                        android:id="@+id/tv_device_sn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{vm.deviceToken}"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_13"
                        tools:text="21E118L" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ll_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="产品型号："
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="@dimen/text_size_13" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{vm.deviceName}"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_13"
                        tools:text="21E118L" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ll_running_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_running_status_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="运行状态："
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="@dimen/text_size_13" />

                    <TextView
                        android:id="@+id/tv_running_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{vm.runningStateText}"
                        android:textColor="@{!vm.isRunningStateNormal()?@color/device_online_platform:@color/device_offline_platform}"
                        android:textSize="@dimen/text_size_13"
                        tools:text="正常"
                        tools:textColor="@color/device_online_platform" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ll_platform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_platform_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="连接平台："
                        android:textColor="@color/sub_title_text_color"
                        android:textSize="@dimen/text_size_13" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_platform"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:splitMotionEvents="false"
                        tools:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
                        tools:listitem="@layout/item_platform_label" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>