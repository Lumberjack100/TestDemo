<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_corner_3dp_gray_f9f9f9"
    android:orientation="vertical"
    tools:context="com.shmedo.mcloudapp.deviceconfig.ui.fragment.usb.Inclinometer_debug_box.dialog.ConfigLinkMacDialogFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@color/title_text_color"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            tools:text="配置连接" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="6dp"
            android:src="@drawable/ic_dispatch_cmd_dialog_close" />

    </RelativeLayout>

    <LinearLayout style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="连接状态" />

        <TextView
            android:id="@+id/tv_link_status"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="offline" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="MAC 地址" />

        <TextView
            android:id="@+id/tv_mac_address"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="9CA525B50DE5" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="信号强度" />

        <TextView
            android:id="@+id/tv_rssi"
            style="@style/Common_ClickableItem_ValueStyle"
            android:drawableEnd="@null"
            android:textSize="17sp"
            tools:text="-60dBm" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_query_link"
        style="@style/SubmitBordelessButtonStyle"
        android:text="查询连接" />

</LinearLayout>

