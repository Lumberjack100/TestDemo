<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:id="@+id/ll_mac_address"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测斜仪Mac地址" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_mac_address"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="textCapCharacters" />

    </LinearLayout>

    <LinearLayout
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="孔号" />

        <cn.refactor.kmpautotextview.KMPAutoComplTextView
            android:id="@+id/et_hole_num"
            style="@style/Common_EditItem_EditText_Style"
            android:layout_marginStart="150dp"
            android:layout_marginEnd="10dp"
            android:completionThreshold="1"
            android:inputType="number"
            android:hint="1-99"
            app:completionHighlightColor="@color/colorPrimary"
            app:completionIgnoreCase="true"
            app:completionTextColor="@color/title_text_color"
            app:completionTextSize="16sp" />

