<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:id="@+id/normalView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/search_placeholder"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_search_project_device_gray"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="13dp"
                    android:src="@drawable/ic_search_project" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="搜索设备"
                    android:textColor="#ffb3b3b3"
                    android:textSize="@dimen/text_size_13" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_project_device_gray"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="13dp"
                        android:src="@drawable/ic_search_project" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_keywords"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="搜索设备"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"
                        android:textColor="@color/search_input_text_color"
                        android:textColorHint="@color/search_hint_text_color"
                        android:textSize="@dimen/text_size_13" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_cancel"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="13dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="取消"
                    android:textColor="@color/blue_52B4F8"
                    android:textSize="@dimen/text_size_15" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/ll_refresh"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已搜索到设备"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_15" />

            <TextView
                android:id="@+id/tv_wifi_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:layout_weight="1"
                android:textColor="@color/text_color_b3b3b3"
                android:textSize="@dimen/text_size_15"
                tools:text="(100)" />

            <LinearLayout
                android:id="@+id/ll_scan_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/iv_refresh_scan"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_ble_scan_refresh" />

                <TextView
                    android:id="@+id/tv_scan_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/blue_52B4F8"
                    android:textSize="@dimen/text_size_15"
                    tools:text="重新搜索" />

            </LinearLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="25dp"
            android:splitMotionEvents="false" />

    </LinearLayout>

    <include android:id="@+id/wifiDisabledView"
        android:visibility="gone"
        layout="@layout/wifi_disabled_view" />

</FrameLayout>