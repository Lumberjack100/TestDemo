<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.AdmeMeasuringHoleDepthViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.adme.fragment.AdmeMeasuringHoleDepthFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray"
        android:keepScreenOn="true">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_run"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dimen_size_25">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        onClickWithDebouncing="@{()->click.onMeasureModeClick()}"
                        android:layout_marginTop="@dimen/dimen_size_1"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isEditable }">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="测量孔深模式" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.measureWay }"
                            tools:text="手动测孔深" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <RelativeLayout
                        style="@style/SwitchButton_LayoutStyle"
                        visible="@{!stateVM.isAutoMode}"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/SwitchButton_TitleStyle"
                            android:text="下放堵转检测"
                            android:textColor="@{stateVM.isEditable?@color/title_text_color:@color/sub_title_text_color}" />

                        <com.kyleduo.switchbutton.SwitchButton
                            android:id="@+id/downEnableSBtn"
                            style="@style/SwitchButton_ButtonStyle"
                            checkedImmediatelyNoEvent="@{stateVM.downEnable}"
                            android:enabled="@{stateVM.isEditable}"
                            android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                            app:kswAnimationDuration="100"
                            app:kswBackDrawable="@drawable/sl_switchbutton_back"
                            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                    </RelativeLayout>

                    <RelativeLayout
                        style="@style/SwitchButton_LayoutStyle"
                        visible="@{stateVM.isAutoMode}"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/SwitchButton_TitleStyle"
                            android:text="正反测使能"
                            android:textColor="@{stateVM.isEditable?@color/title_text_color:@color/sub_title_text_color}" />

                        <com.kyleduo.switchbutton.SwitchButton
                            android:id="@+id/positiveAndNegativeSB"
                            style="@style/SwitchButton_ButtonStyle"
                            checkedImmediatelyNoEvent="@{stateVM.positiveAndNegativeTest}"
                            android:enabled="@{stateVM.isEditable}"
                            android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                            app:kswAnimationDuration="100"
                            app:kswBackDrawable="@drawable/sl_switchbutton_back"
                            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                    </RelativeLayout>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:text="电机速度(r/min)" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            android:id="@+id/et_motor_speed"
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:hint="数值范围[1-100]"
                            android:text="@={stateVM.speed}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{3}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        visible="@{stateVM.isAutoMode}"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="实测测斜管孔深(米)" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:drawableEnd="@null"
                            android:text="@{stateVM.realHoleDepth }"
                            tools:text="10" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        visible="@{stateVM.isAutoMode}"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="推荐测斜管孔深(米)" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:drawableEnd="@null"
                            android:text="@{stateVM.recommendHoleDepth }"
                            tools:text="12" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        onClickWithDebouncing="@{()->click.onMotionTypeClick()}"
                        visible="@{!stateVM.isAutoMode}"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isEditable }">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="运动方式" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.motionType }"
                            tools:text="上拉" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        visible="@{!stateVM.isAutoMode}"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isEditable}"
                            android:text="运动距离(米)" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isEditable }"
                            android:text="@={stateVM.distanceGoal}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{12}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>

        <TextView
            android:id="@+id/btn_run"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onRunClick()}"
            visible="@{stateVM.isEditable }"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/dimen_size_30"
            android:text="运行"
            app:layout_constraintBottom_toTopOf="@+id/fl_clear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/refreshLayout" />

        <FrameLayout
            android:id="@+id/fl_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_run">

            <LinearLayout
                android:id="@+id/ll_clear_motion_data"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                visible="@{stateVM.isClearMotionDataVisible &amp;&amp; stateVM.isEditable}"
                onClickWithDebouncing="@{()->click.onClearDataClick()}"
                android:background="@drawable/bg_clear_motion_data"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_clear_motion_data"
                    android:drawablePadding="10dp"
                    android:text="清空数据"
                    android:textColor="@color/text_color_666666"
                    android:textSize="@dimen/text_size_15" />

            </LinearLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_motion_data_clear_complete"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                visible="@{!stateVM.isClearMotionDataVisible &amp;&amp; stateVM.isEditable}"
                android:background="@drawable/bg_motion_data_clear_complete"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_motion_data_clear_complete"
                    android:drawablePadding="10dp"
                    android:text="已清空数据"
                    android:textColor="@color/text_color_666666"
                    android:textSize="@dimen/text_size_15" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>