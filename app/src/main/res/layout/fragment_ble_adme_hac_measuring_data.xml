<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/ll_mac_address"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="测斜仪Mac地址" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_mac_address"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="textCapCharacters" />

        </LinearLayout>

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="孔号" />

            <LinearLayout
                android:id="@+id/layoutNewLine"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="150dp"
                android:layout_weight="1"
                android:background="@drawable/bg_corner_3dp_gray_stroke"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:dropDownVerticalOffset="40dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:clickable="false">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="区号" />

            <TextView
                android:id="@+id/tv_area_num"
                style="@style/Common_ClickableItem_ValueStyle"
                android:drawableEnd="@null"
                android:textSize="17sp"
                tools:text="10" />

        </LinearLayout>

        <LinearLayout
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:clickable="false">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="测得孔深(m)" />

            <TextView
                android:id="@+id/tv_hole_depth"
                style="@style/Common_ClickableItem_ValueStyle"
                android:drawableEnd="@null"
                android:textSize="17sp"
                tools:text="10" />

        </LinearLayout>

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="测量孔深(m)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_meas_depth"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="numberDecimal" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_decentralization_waiting_time"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="下放等待时间(min)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_decentralization_waiting_time"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_data_settlement_method"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据解算方式" />

            <TextView
                android:id="@+id/tv_data_settlement_method"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="顶部固定法" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/ll_decentralized"
            style="@style/SwitchButton_LayoutStyle"
            android:layout_marginTop="10dp"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/SwitchButton_TitleStyle"
                android:text="仅用单向测量" />

            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/singleWayTestEnableSBtn"
                style="@style/SwitchButton_ButtonStyle"
                app:kswAnimationDuration="100"
                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                app:kswThumbHeight="28dp"
                app:kswThumbRangeRatio="2"
                app:kswThumbWidth="28dp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/ll_check_reverse"
            style="@style/SwitchButton_LayoutStyle"
            android:layout_marginTop="10dp"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/SwitchButton_TitleStyle"
                android:text="测斜仪反转自检" />

            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/checkReverseEnableSBtn"
                style="@style/SwitchButton_ButtonStyle"
                app:kswAnimationDuration="100"
                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                app:kswThumbHeight="28dp"
                app:kswThumbRangeRatio="2"
                app:kswThumbWidth="28dp" />

        </RelativeLayout>

        <Button
            android:id="@+id/btn_run"
            style="@style/SubmitBordelessButtonStyle"
            android:layout_marginStart="100dp"
            android:layout_marginEnd="100dp"
            android:text="正向测量" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/maskLayerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
