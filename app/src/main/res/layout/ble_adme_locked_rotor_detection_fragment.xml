<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/white"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textStyle="bold"
                    android:text="下放堵转缓停"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17" />

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/decentralizedEnableSBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/decentralizedChildLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="单位时间脉冲数(p/s)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_decentralized_pulses_per_unit_time"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入"
                        android:inputType="number" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检测判断时间(s)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_decentralized_pulse_detection_time"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入"
                        android:inputType="numberDecimal" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="堵转检测区间(%)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <TextView
                        android:id="@+id/tv_decentralized_stall_detection_interval"
                        style="@style/DataCenter_EditText_Style"
                        android:hint=""
                        android:textColor="@color/text_color_51B4F8"
                        tools:text="17%-55%" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="15dp">

                    <com.guyj.BidirectionalSeekBar
                        android:id="@+id/bSeekBar_decentralized_stall_detection_interval"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        app:ball_left_solid_color="@android:color/white"
                        app:ball_left_stroke_color="@color/text_color_51B4F8"
                        app:ball_radius_size="13dp"
                        app:ball_right_solid_color="@android:color/white"
                        app:ball_right_stroke_color="@color/text_color_51B4F8"
                        app:ball_stroke_size="4dp"
                        app:pb_within_color="@color/text_color_51B4F8"
                        app:pb_without_color="#EDEDED"
                        app:text_left_num="0"
                        app:text_min_unit="1"
                        app:text_right_num="100" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="力矩堵转阈值(mA)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_decentralized_torque_stall_threshold"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入"
                        android:inputType="number" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="力矩检测判断时间"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_decentralized_torque_detection_time"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入"
                        android:inputType="numberDecimal" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="缓停区间(%)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <TextView
                        android:id="@+id/tv_decentralized_slow_stop_interval"
                        style="@style/DataCenter_EditText_Style"
                        android:textColor="@color/text_color_51B4F8"
                        android:hint=""
                        tools:text="17%-55%" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="15dp">

                    <com.guyj.BidirectionalSeekBar
                        android:id="@+id/bSeekBar_decentralized_slow_stop_interval"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        app:ball_left_solid_color="@android:color/white"
                        app:ball_left_stroke_color="@color/text_color_51B4F8"
                        app:ball_radius_size="13dp"
                        app:ball_right_solid_color="@android:color/white"
                        app:ball_right_stroke_color="@color/text_color_51B4F8"
                        app:ball_stroke_size="4dp"
                        app:pb_within_color="@color/text_color_51B4F8"
                        app:pb_without_color="#EDEDED"
                        app:text_left_num="0"
                        app:text_min_unit="1"
                        app:text_right_num="100" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/white"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textStyle="bold"
                    android:text="上拉堵转缓停"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17" />

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/pullUpEnableSBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/pullUpChildLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="力矩堵转阈值(mA)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_pull_up_torque_stall_threshold"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入"
                        android:inputType="number" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="力矩检测判断时间"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_pull_up_torque_detection_time"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入"
                        android:inputType="numberDecimal" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="缓停区间(%)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <TextView
                        android:id="@+id/tv_pull_up_slow_stop_interval"
                        style="@style/DataCenter_EditText_Style"
                        android:hint=""
                        android:textColor="@color/text_color_51B4F8"
                        tools:text="17%-55%" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="15dp">

                    <com.guyj.BidirectionalSeekBar
                        android:id="@+id/bSeekBar_pull_up_slow_stop_interval"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        app:ball_left_solid_color="@android:color/white"
                        app:ball_left_stroke_color="@color/text_color_51B4F8"
                        app:ball_radius_size="13dp"
                        app:ball_right_solid_color="@android:color/white"
                        app:ball_right_stroke_color="@color/text_color_51B4F8"
                        app:ball_stroke_size="4dp"
                        app:pb_within_color="@color/text_color_51B4F8"
                        app:pb_without_color="#EDEDED"
                        app:text_left_num="0"
                        app:text_min_unit="1"
                        app:text_right_num="100" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/btn_select"
                android:gravity="center"
                android:text="保存"
                android:textColor="@color/white"
                android:textSize="17sp" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/maskLayerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</androidx.core.widget.NestedScrollView>