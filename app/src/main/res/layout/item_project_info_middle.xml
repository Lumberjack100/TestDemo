<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_item_side_margin"
    android:layout_marginEnd="@dimen/card_item_side_margin"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:foreground="?android:attr/selectableItemBackground"
        android:paddingStart="@dimen/card_item_padding_left"
        android:paddingTop="@dimen/card_item_padding_top"
        android:paddingEnd="@dimen/card_item_padding_right"
        android:paddingBottom="@dimen/card_item_padding_bottom">

        <ImageView
            android:id="@+id/ic_thumbnail"
            android:layout_width="@dimen/project_info_icon_size"
            android:layout_height="@dimen/project_info_icon_size"
            android:layout_alignParentStart="true"
            tools:src="@drawable/ic_project_default" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@+id/ic_thumbnail"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_project_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/title_text_color"
                android:textSize="@dimen/text_size_18"
                android:textStyle="bold"
                tools:text="云南德宏州S318芒那线公路边坡监测系统xxx第三期中标" />

            <TextView
                android:id="@+id/tv_company_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="惠山区洛社镇XX社区" />

            <TextView
                android:id="@+id/tv_create_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="@dimen/text_size_13"
                tools:text="2018.11.16 09:38" />

        </LinearLayout>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="@dimen/card_item_padding_left"
        android:layout_marginEnd="@dimen/card_item_padding_left"
        android:background="@color/gray_efefef" />

</LinearLayout>

