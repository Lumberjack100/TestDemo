<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main_light_white"
    android:orientation="vertical">

    <include layout="@layout/dialog_sensorconfig_header_layout"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:fadingEdge="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/LinearLayout_Sensor_Config_Item">

                    <TextView
                        style="@style/TextView_Sensor_Config_Item"
                        android:drawableLeft="@drawable/ic_required"
                        android:text="传感器类型:" />

                    <Spinner
                        android:id="@+id/spinnerType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:background="@drawable/icon_dialog_switch"
                        android:paddingLeft="10dp"
                        android:singleLine="true" />

                </LinearLayout>

                <LinearLayout style="@style/LinearLayout_Sensor_Config_Item"
                    android:layout_marginTop="5dp">

                    <TextView
                        style="@style/TextView_Sensor_Config_Item"
                        android:drawableLeft="@drawable/ic_required"
                        android:text="通道:" />

                    <Spinner
                        android:id="@+id/spinnerWay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:background="@drawable/icon_dialog_switch"
                        android:paddingLeft="10dp"
                        android:singleLine="true" />

                </LinearLayout>

                <com.shmedo.mcloudapp.deviceconfig.ui.view.sensor.SensorBGK4500View
                    android:id="@+id/sensorBGK4500View"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.shmedo.mcloudapp.deviceconfig.ui.view.sensor.SensorVWP03View
                    android:id="@+id/sensorVWP03View"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.shmedo.mcloudapp.deviceconfig.ui.view.sensor.SensorZLJ300tView
                    android:id="@+id/sensorZLJ300tView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </ScrollView>

        <RelativeLayout
            android:id="@+id/rl_scan_config"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/btn_select"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/img_scan"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:layout_toStartOf="@+id/tv_scan"
                android:src="@drawable/ic_camera" />

            <TextView
                android:id="@+id/tv_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="扫码配置"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>