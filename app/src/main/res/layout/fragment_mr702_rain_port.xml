<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="homeVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702PortHomeViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702RainPortViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.port.MR702RainPortFragment.ClickProxy" />
    </data>

    <com.drake.brv.PageRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="60dp"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_size_8"
                    android:background="@color/main_bg_gray" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_ClickableItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="状态" />

                    <TextView
                        style="@style/Common_ClickableItem_ValueStyle"
                        android:drawableEnd="@null"
                        android:text="@{stateVM.status}"
                        android:textSize="17sp"
                        tools:text="已接入" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <RelativeLayout style="@style/SwitchButton_LayoutStyle">

                    <TextView
                        style="@style/SwitchButton_TitleStyle"
                        android:text="雨量计"
                        android:textColor="@{homeVM.isEditable?@color/title_text_color:@color/sub_title_text_color}"
                        android:textStyle="bold" />

                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/sensorSB"
                        style="@style/SwitchButton_ButtonStyle"
                        android:enabled="@{homeVM.isEditable}"
                        android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                        app:kswAnimationDuration="100"
                        app:kswBackDrawable="@drawable/sl_switchbutton_back"
                        app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dimen_size_10"
                    android:layout_marginBottom="@dimen/dimen_size_20"
                    android:src="@{stateVM.isOpened?@drawable/ic_mr702_rain_gauge_bright:@drawable/ic_mr702_rain_gauge_gray}"
                    tools:src="@drawable/ic_mr702_rain_gauge_bright" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_ClickableItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider"
                    android:enabled="@{homeVM.isEditable &amp;&amp;stateVM.isOpened}"
                    onClickWithDebouncing="@{()->click.onChooseResolutionClick()}">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:text="分辨率" />

                    <TextView
                        style="@style/Common_ClickableItem_ValueStyle"
                        textViewEnabled="@{homeVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:text="@{stateVM.rainResolution}"
                        tools:text="0.2" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:text="消抖系数(秒/次)"
                        tools:textColor="@color/title_text_color" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{homeVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:hint="请输入"
                        android:text="@={stateVM.debounceCoefficient}"
                        app:inputTypeFilter='@{"number"}'
                        app:lengthFilter="@{6}" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <TextView
                    android:id="@+id/btn_confirm"
                    style="@style/SubmitButton_ColorPrimary"
                    onClickWithDebouncing="@{()->click.onSubmitClick()}"
                    visible="@{homeVM.isEditable &amp;&amp;stateVM.isOpened}"
                    android:layout_marginTop="150dp"
                    android:layout_marginBottom="15dp"
                    android:text="保存" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </com.drake.brv.PageRefreshLayout>
</layout>
