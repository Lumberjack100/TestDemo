<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.DeviceSelectViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.baseclickproxy.BaseClickProxy" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_search_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/page_content_item_padding_horizontal_16"
            android:paddingVertical="@dimen/dimen_size_12"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                android:id="@+id/et_keywords"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_project_device_gray"
                android:drawablePadding="@dimen/dimen_size_10"
                android:gravity="center_vertical|left"
                android:hint="设备SN搜索"
                android:paddingHorizontal="@dimen/dimen_size_15"
                android:singleLine="true"
                android:text="@={stateVM.deviceToken}"
                android:textColor="@color/title_text_color"
                android:textColorHint="@color/text_color_B3B3B3"
                android:textSize="@dimen/text_size_13"
                app:lengthFilter="@{25}" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                style="@style/Common_MaterialButton_Style"
                onClickWithDebouncing="@{()->click.onGoToSearch()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_size_25"
                android:enabled="@{!stateVM.deviceToken.empty}"
                android:paddingHorizontal="@dimen/dimen_size_10"
                android:paddingVertical="@dimen/dimen_size_5"
                android:text="查询"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_13"
                app:backgroundTint="@drawable/submit_button_background_tint"
                app:cornerRadius="@dimen/dimen_size_3" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_search_layout">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_device"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/dimen_size_10"
                android:splitMotionEvents="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/item_device_info" />

        </com.drake.brv.PageRefreshLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>