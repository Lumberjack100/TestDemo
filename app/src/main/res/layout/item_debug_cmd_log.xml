<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.lib.core.base.model.DebugCmdLogInfo" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_log_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{m.logTime+">"}'
            android:textColor="@color/sub_title_text_color"
            android:textSize="@dimen/text_size_13"
            tools:text="11:23:34.942" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_log_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_size_10"
            android:layout_marginBottom="@dimen/dimen_size_5"
            android:layout_weight="1"
            android:text='@{"["+m.byteCount +"字节]"+ m.content}'
            android:textColor="@{m.colorRes==0?@color/title_text_color:m.colorRes}"
            android:textSize="@dimen/text_size_13"
            tools:text="$cmd=md_getequipmentbasis&amp;sn=/&amp;productid=&amp;equimodel=0&amp;monionstate=0&amp;apikey=c1094e6a-e3a0-41a9-a0c7-5bf6ba288ea8&amp;msgid=decd71&amp;&amp;"
            tools:textColor="@color/title_text_color" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>
