<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <include layout="@layout/activity_device_toolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg2_light_white"
        android:gravity="center"
        android:layout_marginTop="5dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="当前注册期限"
            android:gravity="center_vertical|center_horizontal"
            android:textSize="14sp"
            android:layout_marginLeft="55dp"

            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/icon_product_date"
            android:layout_toLeftOf="@id/tv_date"
            android:gravity="center_vertical|center_horizontal"
            />
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="2020年12月31日"
            android:gravity="center_vertical|center_horizontal"
            android:textSize="14sp"
            android:layout_marginRight="50dp"
            android:layout_alignParentRight="true"
            android:paddingLeft="15dp"
            />
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/bg2_light_white"
        android:layout_marginTop="1dp"
        >
        <ImageView
            android:id="@+id/iv_question"
            android:layout_width="20dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_queste"
            android:layout_marginLeft="15dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:text="原授权码"
            android:layout_gravity="center_vertical"
            android:textSize="14sp"
            android:layout_marginLeft="20dp"
            />
        <EditText
            android:id="@+id/et_origin_author"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="wrap_content"

            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/bg2_light_white"
        android:layout_marginTop="1dp"
        >
        <ImageView
            android:layout_width="20dp"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:text="新的授权码"
            android:layout_gravity="center_vertical"
            android:textSize="14sp"
            android:layout_marginLeft="20dp"
            />
        <EditText
            android:id="@+id/et_new_author"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="wrap_content"
            android:hint=""
            />
    </LinearLayout>
    <Button
        android:id="@+id/btn_confirm_registered"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="注册"
        android:background="@drawable/scan_add_selector"
        android:textColor="@color/white"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        />
</LinearLayout>