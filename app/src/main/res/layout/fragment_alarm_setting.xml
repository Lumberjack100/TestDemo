<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.AlarmSettingViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.common.AlarmSettingFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_reset"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/dimen_size_25">

                    <TextView
                        style="@style/Common_GroupName_Style"
                        android:text="报警信息" />

                    <RelativeLayout
                        style="@style/SwitchButton_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/SwitchButton_TitleStyle"
                            android:text="报警启用" />

                        <com.kyleduo.switchbutton.SwitchButton
                            style="@style/SwitchButton_ButtonStyle"
                            checkedImmediatelyNoEvent="@{stateVM.isOpened}"
                            android:onCheckedChanged="@{(button, checked)->click.onCheckedChanged(button, checked)}"
                            app:kswAnimationDuration="100"
                            app:kswBackDrawable="@drawable/sl_switchbutton_back"
                            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                    </RelativeLayout>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_ClickableItem_LayoutStyle"
                        onClickWithDebouncing="@{()->click.onMonitorPointChooseClick()}"
                        android:layout_marginTop="@dimen/dimen_size_1"
                        android:background="@drawable/layer_common_click_item_with_divider"
                        android:enabled="@{stateVM.isOpened }">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:text="监测点编号" />

                        <TextView
                            style="@style/Common_ClickableItem_ValueStyle"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:drawableEnd="@drawable/ic_arrow_down"
                            android:text="@{stateVM.monitorPoint}"
                            tools:text="1" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="播报次数" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="数值范围[0-255]"
                            android:text="@={stateVM.broadcastTimes}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{3}" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="一级报警语音编号" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="数值范围[1-255]"
                            android:text="@={stateVM.firstAlarmVoice}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{3}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="二级报警语音编号" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="数值范围[1-255]"
                            android:text="@={stateVM.secondAlarmVoice}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{3}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="三级报警语音编号" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="数值范围[1-255]"
                            android:text="@={stateVM.thirdAlarmVoice}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{3}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="四级报警语音编号" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="数值范围[1-255]"
                            android:text="@={stateVM.fourthAlarmVoice}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{3}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <TextView
                        style="@style/Common_GroupName_Style"
                        android:text="报警阈值" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="一级报警阈值" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.firstAlarmDisplacementThreshold}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="二级报警阈值" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.secondAlarmDisplacementThreshold}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="三级报警阈值" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.thirdAlarmDisplacementThreshold}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="四级报警阈值" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.fourthAlarmDisplacementThreshold}"
                            app:inputTypeFilter='@{"numberDecimal"}'
                            app:lengthFilter="@{10}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <TextView
                        style="@style/Common_GroupName_Style"
                        android:text="报警间隔" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="一级报警间隔(秒)" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.firstAlarmReportInterval}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{4}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="二级报警间隔(秒)" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.secondAlarmReportInterval}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{4}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="三级报警间隔(秒)" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.thirdAlarmReportInterval}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{4}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="四级报警间隔(秒)" />

                        <com.shmedo.mcloudapp.common.widget.ClearEditText
                            style="@style/Common_EditItem_EditText_Style"
                            textViewEnabled="@{stateVM.isOpened }"
                            android:hint="请输入"
                            android:text="@={stateVM.fourthAlarmReportInterval}"
                            app:inputTypeFilter='@{"number"}'
                            app:lengthFilter="@{4}" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <TextView
                        style="@style/Common_GroupName_Style"
                        android:text="报警测试" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            enabledTextColor="@{@color/colorPrimary}"
                            onClickWithDebouncing="@{()->click.onTestFirstAlarmClick()}"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="一级报警测试"
                            android:textStyle="bold"
                            tools:textColor="@color/colorPrimary" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            enabledTextColor="@{@color/colorPrimary}"
                            onClickWithDebouncing="@{()->click.onTestSecondAlarmClick()}"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="二级报警测试"
                            android:textStyle="bold"
                            tools:textColor="@color/colorPrimary" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            enabledTextColor="@{@color/colorPrimary}"
                            onClickWithDebouncing="@{()->click.onTestThirdAlarmClick()}"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="三级报警测试"
                            android:textStyle="bold"
                            tools:textColor="@color/colorPrimary" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            enabledTextColor="@{@color/colorPrimary}"
                            onClickWithDebouncing="@{()->click.onTestFourthAlarmClick()}"
                            textViewEnabled="@{stateVM.isOpened}"
                            android:text="四级报警测试"
                            android:textStyle="bold"
                            tools:textColor="@color/colorPrimary" />

                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </com.drake.brv.PageRefreshLayout>

        <TextView
            android:id="@+id/btn_reset"
            style="@style/ResetButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onResetClick()}"
            visible="@{stateVM.isOpened }"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="35dp"
            android:text="@string/button_reset_text"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/refreshLayout" />

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onSubmitButtonClick()}"
            visible="@{stateVM.isOpened }"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="55dp"
            android:text="@string/button_save_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_reset" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>