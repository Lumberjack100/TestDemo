<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <include layout="@layout/activity_device_toolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/data_model_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/message_model_ll"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="left|center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发送："
                    android:textColor="@color/colorPrimary"/>

                <RadioGroup
                    android:id="@+id/send_rg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/send_ascii_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="ASCII"
                        />
                    <RadioButton
                        android:id="@+id/send_hex_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEX"
                        />


                </RadioGroup>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/receive_data_model_ll"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="left|center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="接收："
                    android:textColor="@color/colorPrimary"/>

                <RadioGroup
                    android:id="@+id/receive_rg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/receive_ascii_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="ASCII"
                        />
                    <RadioButton
                        android:id="@+id/receive_hex_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEX"
                        />


                </RadioGroup>

            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/use_btn_ll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="right"
            android:layout_below="@+id/data_model_ll"
            android:layout_margin="2dp"
            android:orientation="horizontal">

            <!-- <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="常用指令："
                 android:textColor="@color/colorPrimary"/>-->
            <Button
                android:id="@+id/setSysTimeBT"
                android:text="系统授时"
                android:textColor="@color/white"
                android:background="@drawable/btn_blue_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/getDataBt"
                android:text="获取数据"
                android:textColor="@color/white"
                android:layout_marginLeft="5dp"
                android:background="@drawable/btn_blue_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


        </LinearLayout>

        <jp.bassaer.chatmessageview.views.ChatView
            android:id="@+id/chat_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/use_btn_ll"/>

    </RelativeLayout>
</LinearLayout>