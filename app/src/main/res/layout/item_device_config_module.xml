<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_corner_3dp_white"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="17dp"
    android:paddingEnd="15dp"
    android:paddingBottom="18dp">

    <ImageView
        android:id="@+id/iv_config_logo"
        android:layout_width="27dp"
        android:layout_height="27dp"
        tools:src="@drawable/ic_device_current_state" />

    <TextView
        android:id="@+id/tv_config_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/title_text_color"
        android:textSize="17sp"
        tools:text="状态" />

    <TextView
        android:id="@+id/tv_config_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/sub_title_text_color"
        android:textSize="13sp"
        tools:text="获取当前设备状态" />

</LinearLayout>