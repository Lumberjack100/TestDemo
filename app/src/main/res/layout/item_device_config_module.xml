<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.device.model.ConfigModule" />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:focusable="true"
        android:foreground="?android:selectableItemBackground"
        app:cardCornerRadius="3dp"
        app:cardElevation="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_config_logo"
                imageResId="@{m.configModule.iconResId}"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="@{m.configModule.connected ? @color/colorPrimary : @color/sub_title_text_color}"
                tools:src="@drawable/ic_device_current_state" />

            <TextView
                android:id="@+id/tv_config_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@{m.configModule.name}"
                android:textColor="@{m.configModule.connected ? @color/title_text_color : @color/sub_title_text_color}"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="关于设备" />

            <TextView
                android:id="@+id/tv_config_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@{m.configModule.desc}"
                android:textColor="@color/sub_title_text_color"
                android:textSize="11sp"
                tools:text="配置测斜仪工作模式" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>
</layout>