<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.device.model.ConfigModule" />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:focusable="true"
        android:foreground="?android:selectableItemBackground"
        app:cardCornerRadius="3dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="17dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="18dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_config_logo"
                android:layout_width="27dp"
                android:layout_height="27dp"
                imageResId="@{m.iconResId}"
                tools:src="@drawable/ic_device_current_state" />

            <TextView
                android:id="@+id/tv_config_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@{m.name}"
                android:textColor="@color/title_text_color"
                android:textSize="17sp"
                tools:text="状态" />

            <TextView
                android:id="@+id/tv_config_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/sub_title_text_color"
                android:textSize="13sp"
                android:text="@{m.desc}"
                tools:text="配置测斜仪工作模式" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>