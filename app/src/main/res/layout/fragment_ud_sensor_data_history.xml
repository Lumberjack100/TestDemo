<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.UDSensorDataHistoryViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.u_product.fragment.ud.UDSensorDataHistoryFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_content_container_padding_horizontal_12"
            android:layout_marginTop="@dimen/page_content_container_padding_top_12"
            android:background="@drawable/shape_common_click_item_top_corner_4"
            android:paddingHorizontal="@dimen/dimen_size_10"
            android:paddingVertical="@dimen/dimen_size_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:onClick="@{() -> click.onChooseTimeClick()}"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_size_25"
                android:background="@drawable/bg_label_blue_corner_15dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dimen_size_12">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{stateVM.periodDate}"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_12"
                    tools:text="一周内" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="@dimen/dimen_size_5"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_arrow_down" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:onClick="@{() -> click.onModelChooseClick()}"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_size_25"
                android:layout_marginStart="@dimen/dimen_size_20"
                android:background="@drawable/bg_label_blue_corner_15dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dimen_size_12">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{stateVM.modelName}"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_12"
                    tools:text="液面高程" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="@dimen/dimen_size_5"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_arrow_down" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/page_content_container_padding_horizontal_12"
            android:layout_marginBottom="@dimen/dimen_size_20"
            android:background="@drawable/shape_common_click_item_bottom_corner_4"
            android:paddingHorizontal="@dimen/dimen_size_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_filter">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:splitMotionEvents="false"
                tools:itemCount="30"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_ud_sensor_data" />

        </com.drake.brv.PageRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>