<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.MR702ReservoirCapacityViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.mr702.fragment.MR702ReservoirCapacityFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/dimen_size_25">

                <RelativeLayout
                    style="@style/SwitchButton_Item_Layout_Style"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SwitchButton_Item_Title_Style"
                        android:text="功能开关"
                        android:textColor="@{!stateVM.isOpened&amp;&amp; stateVM.isEditable?@color/title_text_color:@color/sub_title_text_color}" />

                    <com.kyleduo.switchbutton.SwitchButton
                        android:id="@+id/mobileCommunicationSB"
                        style="@style/SwitchButton_Item_Button_Style"
                        checkedImmediatelyNoEvent="@{stateVM.isOpened}"
                        android:enabled="@{!stateVM.isOpened &amp;&amp; stateVM.isEditable}"
                        app:kswAnimationDuration="100"
                        app:kswBackDrawable="@drawable/sl_switchbutton_back"
                        app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                </RelativeLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_Layout_Style"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_ClickableItem_Title_Style"
                        textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:text="坐标点数量"
                        tools:textColor="@color/title_text_color" />

                    <com.shmedo.mcloudapp.ui.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:hint="[3,50]"
                        android:inputType="number"
                        android:maxLength="2"
                        android:text="@={stateVM.pointCount}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_Layout_Style"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_ClickableItem_Title_Style"
                        textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:text="x1坐标值（米）" />

                    <com.shmedo.mcloudapp.ui.widget.ClearEditText
                        android:id="@+id/userNameET"
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:hint="请输入"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:text="@={stateVM.x1}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_Layout_Style"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_ClickableItem_Title_Style"
                        textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:text="y1坐标值（米）" />

                    <com.shmedo.mcloudapp.ui.widget.ClearEditText
                        android:id="@+id/pwdET"
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{stateVM.isEditable &amp;&amp;stateVM.isOpened}"
                        android:hint="请输入"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:text="@={stateVM.y1}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_Style"
            onClickWithDebouncing="@{()->click.onSubmitClick()}"
            visible="@{stateVM.isEditable}"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="15dp"
            android:text="保存"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollView" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>