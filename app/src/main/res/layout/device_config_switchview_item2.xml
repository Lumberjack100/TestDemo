<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:background="@color/bg_main_light_white"
    android:gravity="center_vertical"
    android:paddingLeft="15dp"
    android:paddingRight="15dp">

    <ImageView
        android:id="@+id/itemTipIV"
        android:layout_width="20dp"
        android:layout_height="40dp"
        android:src="@drawable/icon_queste" />

    <TextView
        android:id="@+id/itemNameTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="3"
        android:textColor="@color/gray_807B7B"
        android:textSize="@dimen/text_size_14"
        tools:text="解算时间(单位：秒)" />

    <TextView
        android:id="@+id/tv_switch_state"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="10dp"
        android:gravity="center"
        tools:text="已激活"
        android:textColor="@color/colorPrimary" />

    <ch.ielse.view.SwitchView
        android:id="@+id/switchview"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        app:primaryColor="@color/colorPrimary" />

</LinearLayout>