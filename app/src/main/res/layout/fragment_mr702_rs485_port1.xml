<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="homeVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702PortHomeViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702RS485Port1ViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.port.MR702RS485Port1Fragment.ClickProxy" />
    </data>

    <com.drake.brv.PageRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="60dp"
                android:orientation="vertical">

                <include
                    layout="@layout/include_mr702_port_common_head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_size_1"
                    app:vm="@{homeVM}" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:layout_marginTop="@dimen/dimen_size_15"
                    android:layout_marginBottom="@dimen/dimen_size_15"
                    android:drawablePadding="-80dp"
                    android:text="采集参数"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_mr702_interface_info_collection_param" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="采集频率(毫秒)" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="@={stateVM.acquisitionFrequency}"
                        app:inputTypeFilter='@{"number"}'
                        app:lengthFilter="@{5}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="采集周期(分钟)" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="@={stateVM.collectionDuration}"
                        app:inputTypeFilter='@{"number"}'
                        app:lengthFilter="@{5}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="采集次数(N)" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="@={stateVM.collectionTimes}"
                        app:inputTypeFilter='@{"number"}'
                        app:lengthFilter="@{5}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="无应答次数" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="@={stateVM.noResponseTimes}"
                        app:inputTypeFilter='@{"number"}'
                        app:lengthFilter="@{5}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="延时时间(秒)" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="@={stateVM.delayDuration}"
                        app:inputTypeFilter='@{"number"}'
                        app:lengthFilter="@{5}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="阈值次数" />

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{homeVM.isEditable }"
                        android:text="@={stateVM.ngateval}"
                        app:inputTypeFilter='@{"number"}'
                        app:lengthFilter="@{5}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_size_15"
                    android:layout_marginTop="@dimen/dimen_size_15"
                    android:layout_marginBottom="@dimen/dimen_size_15"
                    android:drawablePadding="-80dp"
                    android:text="传感器配置"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_mr702_interface_info_sensor_config" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:clipToPadding="false"
                    android:padding="@dimen/dimen_size_15"
                    android:splitMotionEvents="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_mr702_port_sensor" />

                <TextView
                    android:id="@+id/btn_confirm"
                    style="@style/SubmitButton_ColorPrimary"
                    onClickWithDebouncing="@{()->click.onSubmitClick()}"
                    visible="@{homeVM.isEditable }"
                    android:layout_marginBottom="15dp"
                    android:text="保存" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </com.drake.brv.PageRefreshLayout>
</layout>