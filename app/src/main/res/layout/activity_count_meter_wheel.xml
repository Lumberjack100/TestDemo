<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/toolbar_para_config" />

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_main_light_white"
        android:gravity="center_vertical"
        android:paddingLeft="30dp"
        android:paddingRight="70dp">

        <TextView
            android:id="@+id/itemNameTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_14"
            android:text="脉冲数：" />

        <EditText
            android:id="@+id/et_pulses_number"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="3"
            android:background="@drawable/shape_edittext_bg_white"
            android:paddingStart="10dp"
            android:singleLine="true"
            android:textColor="@color/gray_807B7B"
            android:textColorHint="@color/gray_807B7B"
            android:textSize="@dimen/text_size_14" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_main_light_white"
        android:gravity="center_vertical"
        android:paddingLeft="30dp"
        android:paddingRight="70dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/gray_807B7B"
            android:textSize="@dimen/text_size_14"
            android:text="轮直径：" />

        <EditText
            android:id="@+id/et_wheel_diameter"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="3"
            android:background="@drawable/shape_edittext_bg_white"
            android:paddingStart="10dp"
            android:singleLine="true"
            android:textColor="@color/gray_807B7B"
            android:textColorHint="@color/gray_807B7B"
            android:textSize="@dimen/text_size_14" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_confirm_complete"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/btn_select"
        android:text="确定"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_16" />

</LinearLayout>