<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.scwang.smart.refresh.header.ClassicsHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                style="@style/SwitchButton_LayoutStyle">

                <TextView
                    style="@style/SwitchButton_TitleStyle"
                    android:text="中心配置"/>

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/centerEnableSBtn"
                    style="@style/SwitchButton_ButtonStyle"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/ll_child_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/communicationProtocolLayout"
                    style="@style/Common_ClickableItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="通讯协议" />

                    <TextView
                        android:id="@+id/tv_communication_protocol"
                        style="@style/Common_ClickableItem_ValueStyle"
                        tools:text="MDM协议" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="数据中心地址" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_data_server_address"
                        style="@style/Common_EditItem_EditText_Style" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="数据中心端口" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_data_server_port"
                        style="@style/Common_EditItem_EditText_Style"
                        android:inputType="number" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_register_platform"
                    style="@style/Common_ClickableItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="平台类型" />

                    <TextView
                        android:id="@+id/tv_register_platform"
                        style="@style/Common_ClickableItem_ValueStyle"
                        tools:text="地大平台" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_app_key"
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="AppKey" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/appKeyET"
                        style="@style/Common_EditItem_EditText_Style"
                        android:hint="请输入App密钥" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_register_platform_address"
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="注册平台地址" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_register_platform_address"
                        style="@style/Common_EditItem_EditText_Style"
                        android:hint="服务器地址 端口" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_keep_alive"
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="KeepAlive值(s)" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_keep_alive"
                        style="@style/Common_EditItem_EditText_Style"
                        android:hint="默认120s"
                        android:inputType="number" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_auto_register_special_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="设备SN号" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_device_sn"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint="请输入设备SN号" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="产品ID" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_product_id"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint="请输入产品ID" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="注册码" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_register_code"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint="请输入注册码" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_manual_register_special_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="MQTT设备ID" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_mqtt_device_id"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint="请输入Client ID" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Common_EditItem_LayoutStyle"
                        android:background="@drawable/layer_common_click_item_with_divider">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="MQTT用户名" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_mqtt_username"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint="请输入project ID" />

                    </LinearLayout>

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            style="@style/Common_ClickableItem_TitleStyle"
                            android:text="MQTT密码" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_mqtt_password"
                            style="@style/Common_EditItem_EditText_Style"
                            android:hint="请输入APIKey" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btn_confirm"
                style="@style/SubmitBordelessButtonStyle"
                android:text="保存" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.scwang.smart.refresh.footer.ClassicsFooter
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</com.scwang.smart.refresh.layout.SmartRefreshLayout>