<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.device.viewmodel.state.QueryDeviceDataViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.QueryDeviceDataFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_sn"
            style="@style/Common_EditItem_LayoutStyle"
            android:layout_marginTop="0.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="设备SN号" />

            <com.shmedo.mcloudapp.common.widget.ClearEditText
                android:id="@+id/snET"
                style="@style/Common_EditItem_EditText_Style" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_time"
            style="@style/Common_EditItem_LayoutStyle"
            android:layout_marginTop="0.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_sn">

            <TextView
                android:id="@+id/tv_start_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="开始时间"
                android:onClick="@{()->click.onStartTimeClick()}"
                android:singleLine="true"
                android:text="@{stateVM.startTime}"
                android:textColor="@color/title_text_color"
                android:textColorHint="@color/text_color_cccccc"
                android:textSize="@dimen/text_size_15" />

            <View
                android:layout_width="12dp"
                android:layout_height="2dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_end_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="结束时间"
                android:onClick="@{()->click.onEndTimeClick()}"
                android:text="@{stateVM.endTime}"
                android:singleLine="true"
                android:textColor="@color/title_text_color"
                android:textColorHint="@color/text_color_cccccc"
                android:textSize="@dimen/text_size_15" />

            <TextView
                android:id="@+id/tv_search"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:onClick="@{()->click.onSearchClick()}"
                android:text="搜索"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_15"
                app:drawable_radius="@{20}"
                app:drawable_solidColor="@{@color/colorPrimary}"
                tools:background="@color/colorPrimary" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/itemCountLayout"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:layout_marginTop="@dimen/dimen_size_8"
            android:onClick="@{()->click.onChooseItemCountClick()}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_time">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="显示条数" />

            <TextView
                android:id="@+id/tv_item_count"
                style="@style/Common_ClickableItem_ValueStyle"
                android:text="@{stateVM.itemCount}"
                tools:text="30" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_module"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="@dimen/dimen_size_15"
            android:splitMotionEvents="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemCountLayout"
            tools:listitem="@layout/item_device_config_module" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>