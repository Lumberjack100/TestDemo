<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar_white_bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="传感器地址"
            android:textColor="@color/text_color_343434"
            android:textSize="@dimen/text_size_17" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_modbus_address"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dimen_size_25"
            android:layout_weight="1"
            android:background="@null"
            android:drawablePadding="@dimen/dimen_size_15"
            android:gravity="center_vertical|right"
            android:hint="请输入"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="@color/text_color_666666"
            android:textColorHint="@color/text_color_cccccc"
            android:textSize="@dimen/text_size_17" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout style="@style/Common_EditItem_LayoutStyle">

            <TextView
                android:id="@+id/tv_triggerThreshold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_343434"
                android:textSize="@dimen/text_size_17"
                tools:text="报警值(mm)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_trigger_threshold"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dimen_size_25"
                android:layout_weight="1"
                android:background="@null"
                android:drawablePadding="@dimen/dimen_size_15"
                android:gravity="center_vertical|right"
                android:hint="请输入"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/text_color_666666"
                android:textColorHint="@color/text_color_cccccc"
                android:textSize="@dimen/text_size_17" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout style="@style/Common_EditItem_LayoutStyle">

            <TextView
                android:id="@+id/tv_correctionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_343434"
                android:textSize="@dimen/text_size_17"
                tools:text="修正值" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_revised"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dimen_size_25"
                android:layout_weight="1"
                android:background="@null"
                android:drawablePadding="@dimen/dimen_size_15"
                android:gravity="center_vertical|right"
                android:hint="请输入"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textColor="@color/text_color_666666"
                android:textColorHint="@color/text_color_cccccc"
                android:textSize="@dimen/text_size_17" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/measure_long_layout"
            style="@style/Common_EditItem_LayoutStyle">

            <TextView
                android:id="@+id/tv_measure_long"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_343434"
                android:textSize="@dimen/text_size_17"
                tools:text="测段长" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_measure_long"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dimen_size_25"
                android:layout_weight="1"
                android:background="@null"
                android:drawablePadding="@dimen/dimen_size_15"
                android:gravity="center_vertical|right"
                android:hint="请输入"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textColor="@color/text_color_666666"
                android:textColorHint="@color/text_color_cccccc"
                android:textSize="@dimen/text_size_17" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_confirm"
        style="@style/SubmitBordelessButtonStyle"
        android:text="确认" />

</LinearLayout>