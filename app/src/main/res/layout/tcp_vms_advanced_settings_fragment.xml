<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingStart="16.5dp"
            android:text="数据中心设置"
            android:textColor="@color/sub_title_text_color"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:id="@+id/dataCenterOneLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据中心1" />

            <TextView
                android:id="@+id/tv_data_center_one"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp"
                tools:text="未启用" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/dataCenterTwoLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据中心2" />

            <TextView
                android:id="@+id/tv_data_center_two"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp"
                tools:text="4g" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/dataCenterThreeLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据中心3" />

            <TextView
                android:id="@+id/tv_data_center_three"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp"
                tools:text="4g" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/dataCenterFourLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据中心4" />

            <TextView
                android:id="@+id/tv_data_center_four"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp"
                tools:text="4g" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingStart="16.5dp"
            android:text="通道设置"
            android:textColor="@color/sub_title_text_color"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:id="@+id/vmsAisleOneLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="通道1" />

            <TextView
                android:id="@+id/tv_vms_aisle_one"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/vmsAisleTwoLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="通道2" />

            <TextView
                android:id="@+id/tv_vms_aisle_two"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/vmsAisleThreeLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="通道3" />

            <TextView
                android:id="@+id/tv_vms_aisle_three"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingStart="16.5dp"
            android:text="系统设置"
            android:textColor="@color/sub_title_text_color"
            android:textSize="@dimen/text_size_15" />

        <LinearLayout
            android:id="@+id/vmsResetLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="恢复出厂设置" />

            <TextView
                android:id="@+id/tv_vms_reset"
                style="@style/Common_ClickableItem_ValueStyle"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>