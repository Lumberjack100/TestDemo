<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="homeVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.MR702PortHomeViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.MR702PlusePortViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.collector_product.fragment.mr702.port.MR702PlusePortFragment.ClickProxy" />
    </data>

    <com.drake.brv.PageRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/page_content_container_padding_horizontal_12"
                android:paddingTop="@dimen/page_content_container_padding_top_12"
                android:paddingBottom="@dimen/page_content_container_padding_bottom_100">

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_Layout_Style"
                    android:layout_marginTop="@dimen/page_content_item_margin_top_12"
                    android:background="@drawable/shape_common_click_item_top_corner_4">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:background="@color/black" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_GroupItem_Title_Style2"
                        android:layout_marginStart="@dimen/dimen_size_8"
                        android:text="脉冲参数" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <RelativeLayout style="@style/SwitchButton_Item_Layout_Style">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/SwitchButton_Item_Title_Style"
                        android:text="功能开关"
                        android:textStyle="bold" />

                    <com.kyleduo.switchbutton.SwitchButton
                        style="@style/SwitchButton_Item_Button_Style"
                        android:checked="@={stateVM.isOpened}"
                        app:kswAnimationDuration="100"
                        app:kswBackDrawable="@drawable/sl_switchbutton_back"
                        app:kswThumbDrawable="@drawable/shape_switchbutton_thumb" />

                </RelativeLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_ClickableItem_Layout_Style"
                    onClickWithDebouncing="@{()->click.onChooseModeClick()}"
                    android:background="@drawable/layer_common_click_item_with_divider"
                    android:enabled="@{stateVM.isOpened}">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_ClickableItem_Title_Style"
                        textViewEnabled="@{stateVM.isOpened}"
                        android:text="功能选择" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_ClickableItem_Value_Style"
                        textViewEnabled="@{stateVM.isOpened}"
                        android:text="@{stateVM.workMode}"
                        tools:text="计数" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_Layout_Style"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_ClickableItem_Title_Style"
                        textViewEnabled="@{stateVM.isOpened}"
                        android:text="脉冲分辨率"
                        tools:textColor="@color/title_text_color" />

                    <com.shmedo.mcloudapp.ui.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{stateVM.isOpened}"
                        android:hint="数值范围[1-9999]"
                        android:inputType="number"
                        android:maxLength="4"
                        android:text="@={stateVM.pulseResolution}" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/Common_EditItem_Layout_Style"
                    android:background="@drawable/shape_common_click_item_bottom_corner_4">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Common_ClickableItem_Title_Style"
                        textViewEnabled="@{stateVM.isOpened}"
                        android:text="消抖系数（秒/次）"
                        tools:textColor="@color/title_text_color" />

                    <com.shmedo.mcloudapp.ui.widget.ClearEditText
                        style="@style/Common_EditItem_EditText_Style"
                        textViewEnabled="@{stateVM.isOpened}"
                        android:hint="数值范围[5-60]"
                        android:inputType="number"
                        android:maxLength="2"
                        android:text="@={stateVM.debounceCoefficient}" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset"
                    style="@style/ResetButton_Style2"
                    android:layout_marginTop="@dimen/reset_button_margin_top_50"
                    android:onClick="@{()->click.onResetClick()}"
                    android:text="@string/button_reset_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm"
                    style="@style/SubmitButton_Style2"
                    onClickWithDebouncing="@{()->click.onSubmitButtonClick()}"
                    android:layout_marginTop="@dimen/summit_button_margin_top_20"
                    android:enabled="@{stateVM.isDataModified}"
                    android:text="@string/button_save_text" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </com.drake.brv.PageRefreshLayout>
</layout>