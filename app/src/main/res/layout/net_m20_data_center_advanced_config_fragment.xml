<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/white"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="开启状态"
                android:textColor="@color/title_text_color"
                android:textSize="@dimen/text_size_17" />


            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/centerEnableSBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:kswAnimationDuration="100"
                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                app:kswThumbHeight="28dp"
                app:kswThumbRangeRatio="2"
                app:kswThumbWidth="28dp" />

        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/contentLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="数据中心地址"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_data_server_address"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="数据中心端口"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_17" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/et_data_server_port"
                        style="@style/DataCenter_EditText_Style"
                        android:hint="请输入"
                        android:inputType="number" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <LinearLayout
                    android:id="@+id/ll_transfer_protocol"
                    style="@style/Common_ClickableItem_LayoutStyle">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="传输协议" />

                    <TextView
                        android:id="@+id/tv_transfer_protocol"
                        style="@style/Common_ClickableItem_ValueStyle"
                        android:textSize="17sp"
                        tools:text="MQTT" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <LinearLayout
                    android:id="@+id/ll_data_protocol"
                    style="@style/Common_ClickableItem_LayoutStyle">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="数据协议" />

                    <TextView
                        android:id="@+id/tv_data_protocol"
                        style="@style/Common_ClickableItem_ValueStyle"
                        android:textSize="17sp"
                        tools:text="RES_OUT" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_mqtt_child_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp" />

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="产品ID"
                            android:textColor="@color/text_color_343434"
                            android:textSize="@dimen/text_size_17" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_product_id"
                            style="@style/DataCenter_EditText_Style"
                            android:hint="请输入" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_line_bg_efefef" />

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备ID"
                            android:textColor="@color/text_color_343434"
                            android:textSize="@dimen/text_size_17" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_device_id"
                            style="@style/DataCenter_EditText_Style"
                            android:hint="请输入" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_line_bg_efefef" />

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备Key"
                            android:textColor="@color/text_color_343434"
                            android:textSize="@dimen/text_size_17" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_device_key"
                            style="@style/DataCenter_EditText_Style"
                            android:hint="请输入" />

                    </LinearLayout>

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备注册地址"
                            android:textColor="@color/text_color_343434"
                            android:textSize="@dimen/text_size_17" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_device_register_address"
                            style="@style/DataCenter_EditText_Style"
                            android:hint="请输入" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_line_bg_efefef" />

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备注册端口"
                            android:textColor="@color/text_color_343434"
                            android:textSize="@dimen/text_size_17" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_device_register_port"
                            style="@style/DataCenter_EditText_Style"
                            android:hint="请输入"
                            android:inputType="number" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider_line_bg_efefef" />

                    <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设备注册码"
                            android:textColor="@color/text_color_343434"
                            android:textSize="@dimen/text_size_17" />

                        <com.shmedo.mcloudapp.common.view.ClearEditText
                            android:id="@+id/et_device_register_code"
                            style="@style/DataCenter_EditText_Style"
                            android:hint="请输入" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="34dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="20dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:background="@drawable/btn_select"
                    android:gravity="center"
                    android:text="保存"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/maskLayerChild"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#ccffffff"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                tools:visibility="visible">

            </RelativeLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>