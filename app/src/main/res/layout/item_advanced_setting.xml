<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.model.AdvancedSettingItem" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        style="@style/Common_ClickableItem_Layout_Style"
        tools:background="@drawable/layer_common_click_item_with_divider">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Common_ClickableItem_Title_Style"
            android:text='@{m.name}'
            tools:text="固件升级" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>