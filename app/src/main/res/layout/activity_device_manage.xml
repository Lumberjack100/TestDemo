<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg2_light_white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/search_edittext_shape"
        android:orientation="horizontal">
        <com.shmedo.mcloudapp.views.ClearEditText
            android:id="@+id/ce_search"
            android:layout_weight="8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingLeft="9dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:focusable="false"
            android:hint="请输入设备号"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="5dp"
         >

        <android.support.v7.widget.RecyclerView
            android:id="@+id/recycler_system"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@color/app_color_blue_2">
        <TextView
            android:layout_weight="2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="设备号"
            android:textColor="@color/white"
            android:gravity="center_vertical|center_horizontal"/>
        <TextView
            android:layout_weight="3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="传感器类型"
            android:textColor="@color/white"
            android:gravity="center_vertical|center_horizontal"/>
        <TextView
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="电量"
            android:textColor="@color/white"
            android:gravity="center_vertical|center_horizontal"/>
        <TextView
            android:layout_weight="2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="数据量"
            android:textColor="@color/white"
            android:gravity="center_vertical|center_horizontal"/>
        <TextView
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="信号"
            android:textColor="@color/white"
            android:gravity="center_vertical|center_horizontal"/>
    </LinearLayout>
    <com.shmedo.mcloudapp.views.EmptyDataView
        android:id="@+id/empty_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
         android:layout_gravity="center_vertical"
        android:visibility="gone"
        />
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/smartRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableScrollContentWhenLoaded="true"
        app:srlEnableFooterFollowWhenLoadFinished="true"
        >
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycler_device"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
        <!--<com.scwang.smartrefresh.layout.footer.ClassicsFooter
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:srlFinishDuration="10000"
            app:srlClassicsSpinnerStyle="Translate"/>-->
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
</LinearLayout>