<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.FirmwareUpgradeViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.common.FirmwareUpgradeFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:vm="@{toolbarVM}" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_firmware_status"
            style="@style/Common_ClickableItem_Layout_Style"
            onClickWithDebouncing="@{()->click.onFirmwareStatusChooseClick()}"
            android:layout_marginTop="@dimen/dimen_size_1"
            android:background="@drawable/layer_common_click_item_with_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_ClickableItem_Title_Style"
                android:text="固件环境" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_ClickableItem_Value_Style"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:text="@{stateVM.firmwareStatus }"
                tools:text="测试环境" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_filter_regexp"
            style="@style/Common_EditItem_Layout_Style"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_firmware_status">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_ClickableItem_Title_Style"
                android:text="过滤内容" />

            <com.shmedo.mcloudapp.ui.widget.ClearEditText
                style="@style/Common_EditItem_EditText_Style"
                android:gravity="center_vertical|start"
                android:hint="固件名称或版本号"
                android:text="@={stateVM.searchText}" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_search"
                onClickWithDebouncing="@{()->click.onSearchClick()}"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:text="搜索"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_14"
                app:drawable_radius="@{20}"
                app:drawable_solidColor="@{@color/colorPrimary}"
                tools:background="@color/colorPrimary" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.drake.brv.PageRefreshLayout
            android:id="@+id/refreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dimen_size_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_filter_regexp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:splitMotionEvents="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_device_firmware_info" />

        </com.drake.brv.PageRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>