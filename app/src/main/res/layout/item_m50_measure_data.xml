<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.model.M50MeasureDataItem" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.baseclickproxy.BaseClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_content_item_padding_horizontal_16"
        app:drawable_radius="@{4}"
        app:drawable_solidColor="@{@color/white}"
        tools:background="@color/white">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <View
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:background="@color/black" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/Common_GroupItem_Title_Style2"
                android:layout_marginStart="@dimen/dimen_size_8"
                android:text="测量数据" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 主要内容区域：4行布局结构 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_size_8"
            android:orientation="vertical">

            <!-- 第一行：初始化完成时间标题 -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="初始化完成时间："
                android:textColor="@color/title_text_color_black_90"
                android:textSize="@dimen/measure_data_item_text_size_12" />

            <!-- 第二行：时间值 | 东向位移量 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_4"
                android:orientation="horizontal">

                <!-- 左侧：初始化完成时间值 -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="@dimen/dimen_size_8"
                    android:text="@{m.initCompletionTime}"
                    android:textColor="@color/title_text_color_black_90"
                    android:textSize="@dimen/measure_data_item_text_size_12"
                    tools:text="2025-06-10 15:00:00" />

                <!-- 中间分割线 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dimen_size_2"
                    android:background="@color/divider_line_bg2" />

                <!-- 右侧：东向位移量 -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/dimen_size_8"
                    android:text='@{"东向位移量："+m.xDisplacement}'
                    android:textColor="@color/title_text_color_black_90"
                    android:textSize="@dimen/measure_data_item_text_size_12"
                    tools:text="东向位移量：-0.24mm" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 第三行：最新数据时间标题 | 北向位移量 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_5"
                android:orientation="horizontal">

                <!-- 左侧：最新数据时间标题 -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="@dimen/dimen_size_8"
                    android:text="最新数据时间："
                    android:textColor="@color/title_text_color_black_90"
                    android:textSize="@dimen/measure_data_item_text_size_12" />

                <!-- 中间分割线 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dimen_size_2"
                    android:background="@color/divider_line_bg2" />

                <!-- 右侧：北向位移量 -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/dimen_size_8"
                    android:text='@{"北向位移量："+m.yDisplacement}'
                    android:textColor="@color/title_text_color_black_90"
                    android:textSize="@dimen/measure_data_item_text_size_12"
                    tools:text="北向位移量：4.23mm" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- 第四行：最新数据时间值 | 垂直位移量 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_size_4"
                android:orientation="horizontal">

                <!-- 左侧：最新数据时间值 -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="@dimen/dimen_size_8"
                    android:text="@{m.latestDataTime}"
                    android:textColor="@color/title_text_color_black_90"
                    android:textSize="@dimen/measure_data_item_text_size_12"
                    tools:text="2025-06-10 17:00:00" />

                <!-- 中间分割线 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="@dimen/dimen_size_2"
                    android:background="@color/divider_line_bg2" />

                <!-- 右侧：垂直位移量 -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/dimen_size_8"
                    android:text='@{"垂直位移量："+m.zDisplacement}'
                    android:textColor="@color/title_text_color_black_90"
                    android:textSize="@dimen/measure_data_item_text_size_12"
                    tools:text="垂直位移量：7.88mm" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_size_10">

            <com.google.android.material.button.MaterialButton
                style="@style/MeasureData_Button_Style"
                android:onClick="@{()->click.onGotoLocationClick()}"
                android:text='位置'
                app:icon="@drawable/ic_module_location_info" />

            <com.google.android.material.button.MaterialButton
                style="@style/MeasureData_Button_Style"
                android:layout_marginStart="@dimen/dimen_size_10"
                android:enabled="false"
                android:onClick="@{()->click.onTakePhotoClick()}"
                android:text='拍照'
                app:icon="@drawable/ic_device_take_photo" />

            <com.google.android.material.button.MaterialButton
                style="@style/MeasureData_Button_Style"
                android:layout_marginStart="@dimen/dimen_size_10"
                android:onClick="@{()->click.onGoToSensorDataHistoryClick()}"
                android:text='历史'
                app:icon="@drawable/ic_device_sensor_data_history" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout> 