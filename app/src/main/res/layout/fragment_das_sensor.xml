<?xml version="1.0" encoding="utf-8"?>
<com.scwang.smart.refresh.layout.SmartRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/refreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.scwang.smart.refresh.header.ClassicsHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <RelativeLayout
                style="@style/SwitchButton_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/SwitchButton_TitleStyle"
                    android:text="开关量类型传感器" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/switchSensorChildsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_close_switch_sensor"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="16dp"
                    android:button="@drawable/switch_sensor_radio_selector"
                    android:text="关闭"
                    android:textColor="@color/text_color_343434"
                    android:textSize="@dimen/text_size_16" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_line_bg_efefef" />

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <RadioButton
                        android:id="@+id/radio_rain_gauge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@drawable/switch_sensor_radio_selector"
                        android:text="雨量计精度(mm)"
                        android:textColor="@color/text_color_343434"
                        android:textSize="@dimen/text_size_16" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/rainPrecisionLayout"
                        android:layout_width="90dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="5dp"
                        android:visibility="invisible">

                        <cn.wandersnail.widget.textview.RoundTextView
                            android:id="@+id/tvPrecision"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="start|center"
                            android:paddingStart="4dp"
                            android:paddingEnd="18dp"
                            android:textColor="@color/text_color_666666"
                            android:textSize="17sp"
                            app:wswCornerRadius="0dp"
                            app:wswNormalFillColor="@color/transparent"
                            app:wswNormalStrokeColor="@color/gray_808080"
                            app:wswStrokeWidth="1dp"
                            tools:text="0.2" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="end|center"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_expand_more_black_24dp"
                            app:tint="@color/gray_808080" />

                    </FrameLayout>

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radio_break_alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="16dp"
                    android:button="@drawable/switch_sensor_radio_selector"
                    android:text="断线报警器"
                    android:textColor="@color/text_color_343434"
                    android:textSize="@dimen/text_size_16" />

                <RadioGroup
                    android:id="@+id/rg_break_alarm_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal"
                    android:paddingStart="43dp"
                    android:paddingEnd="16dp">

                    <RadioButton
                        android:id="@+id/radio_break_alarm_open"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/break_alarm_radio_selector"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:text="常开"
                        android:textColor="@color/break_alarm_radio_text" />

                    <RadioButton
                        android:id="@+id/radio_break_alarm_close"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/break_alarm_radio_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="常闭"
                        android:textColor="@color/break_alarm_radio_text" />

                </RadioGroup>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <RelativeLayout
                style="@style/SwitchButton_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/SwitchButton_TitleStyle"
                    android:text="数字水位计" />

                <com.kyleduo.switchbutton.SwitchButton
                    android:id="@+id/digitalOsmometerEnableSBtn"
                    style="@style/SwitchButton_ButtonStyle"
                    app:kswAnimationDuration="100"
                    app:kswBackDrawable="@drawable/sl_switchbutton_back"
                    app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                    app:kswThumbHeight="28dp"
                    app:kswThumbRangeRatio="2"
                    app:kswThumbWidth="28dp" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/digitalOsmometerChildsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="水位计地址" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/osmometerAddressEt"
                        style="@style/Common_EditItem_EditText_Style"
                        android:inputType="number" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="水位报警值(mm)" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/waterAlarmValueEt"
                        style="@style/Common_EditItem_EditText_Style"
                        android:inputType="number" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="水深修正值(m)" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/waterRevisedEt"
                        style="@style/Common_EditItem_EditText_Style"
                        android:inputType="numberSigned|numberDecimal" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="水位计绳长(m)" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/osmometerCordEt"
                        style="@style/Common_EditItem_EditText_Style"
                        android:inputType="numberDecimal" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Common_EditItem_LayoutStyle"
                    android:background="@drawable/layer_common_click_item_with_divider">

                    <TextView
                        style="@style/Common_ClickableItem_TitleStyle"
                        android:text="安装高程值(m)" />

                    <com.shmedo.mcloudapp.common.view.ClearEditText
                        android:id="@+id/nozzelHeightEt"
                        style="@style/Common_EditItem_EditText_Style"
                        android:inputType="numberDecimal" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/extendSensorLayout"
                style="@style/Common_ClickableItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="扩展传感器配置" />

                <TextView style="@style/Common_ClickableItem_ValueStyle" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <Button
                android:id="@+id/btn_confirm"
                style="@style/SubmitBordelessButtonStyle"
                android:text="保存"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.scwang.smart.refresh.footer.ClassicsFooter
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</com.scwang.smart.refresh.layout.SmartRefreshLayout>