<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:id="@+id/modelSwitchLayout"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_model_switch_title"
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="模型切换" />

            <TextView
                android:id="@+id/tv_model_switch"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="坐标模型" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/childSensorTypeLayout"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_child_sensor_title"
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="传感器类型" />

            <TextView
                android:id="@+id/tv_child_sensor_type"
                style="@style/Common_ClickableItem_ValueStyle"
                tools:text="雷达物位计" />

        </LinearLayout>

        <LinearLayout style="@style/Common_EditItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="传感器地址" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_modbus_address"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                android:id="@+id/tv_triggerThreshold"
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="触发值" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_trigger_threshold"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="text"
                android:digits="0123456789-." />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/correction_layout"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                android:id="@+id/tv_correctionValue"
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="修正值" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_revised"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="text"
                android:digits="0123456789-." />

            <ImageView
                android:id="@+id/iv_correction"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="@dimen/dimen_size_15"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_userinfo_about"
                android:visibility="gone"
                app:tint="@color/red"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/extension_layout1"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_extension1"
                style="@style/Common_ClickableItem_TitleStyle"
                tools:text="扩展1" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_extension1"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="text"
                android:digits="0123456789-." />

            <ImageView
                android:id="@+id/iv_extension1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="@dimen/dimen_size_15"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_userinfo_about"
                android:visibility="gone"
                app:tint="@color/red"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/extension_layout2"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_extension2"
                style="@style/Common_ClickableItem_TitleStyle"
                tools:text="扩展2" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_extension2"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="text"
                android:digits="0123456789-." />

            <ImageView
                android:id="@+id/iv_extension2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="@dimen/dimen_size_15"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_userinfo_about"
                android:visibility="gone"
                app:tint="@color/red"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/extension_layout3"
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_extension3"
                style="@style/Common_ClickableItem_TitleStyle"
                tools:text="扩展3" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_extension3"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="text"
                android:digits="0123456789-." />

            <ImageView
                android:id="@+id/iv_extension3"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="@dimen/dimen_size_15"
                android:scaleType="centerCrop"
                android:src="@drawable/icon_userinfo_about"
                android:visibility="gone"
                app:tint="@color/red"
                tools:visibility="visible" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_confirm"
            style="@style/SubmitBordelessButtonStyle"
            android:text="确认" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
