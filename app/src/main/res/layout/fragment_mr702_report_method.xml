<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.shmedo.mcloudapp.device.viewmodel.state.MR702ReportMethodViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.device.ui.mr702.fragment.MR702ReportMethodFragment.ClickProxy" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="100dp"
                android:orientation="vertical"
                android:paddingStart="@dimen/text_size_15"
                android:paddingTop="@dimen/dimen_size_20"
                android:paddingEnd="@dimen/text_size_15"
                tools:background="@color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="-80dp"
                    android:text="上报方式"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    app:drawableStartCompat="@drawable/ic_mr702_report_method" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/MR702_Terminal_Param_LinearLayoutStyle"
                    android:layout_marginTop="@dimen/dimen_size_14"
                    app:drawable_radius="@{4}"
                    app:drawable_solidColor="@{@color/gray_f5f6f8}"
                    tools:background="@color/gray_f5f6f8">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="上报方式"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_17" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/dimen_size_8"
                        android:onClick="@{()->click.onReportingMethodClick()}"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_arrow_down" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_size_20"
                    android:drawablePadding="-120dp"
                    android:text="上报起始时间"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    app:drawableStartCompat="@drawable/ic_mr702_report_start_time" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/MR702_Terminal_Param_LinearLayoutStyle"
                    android:layout_marginTop="@dimen/dimen_size_14"
                    app:drawable_radius="@{4}"
                    app:drawable_solidColor="@{@color/gray_f5f6f8}"
                    tools:background="@color/gray_f5f6f8">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="请选择时间"
                        android:text=""
                        android:textColor="@color/title_text_color"
                        android:textColorHint="@color/text_color_hint"
                        android:textSize="@dimen/text_size_17" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/dimen_size_8"
                        android:onClick="@{()->click.onReportingStartTimeClick()}"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_arrow_down" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/text_size_20"
                    android:drawablePadding="-120dp"
                    android:text="上报时间间隔"
                    android:textColor="@color/title_text_color"
                    android:textSize="@dimen/text_size_17"
                    app:drawableStartCompat="@drawable/ic_mr702_report_time_interval" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    style="@style/MR702_Terminal_Param_LinearLayoutStyle"
                    android:layout_marginTop="@dimen/dimen_size_14"
                    app:drawable_radius="@{4}"
                    app:drawable_solidColor="@{@color/gray_f5f6f8}"
                    tools:background="@color/gray_f5f6f8">

                    <com.shmedo.mcloudapp.common.widget.ClearEditText
                        android:id="@+id/ipET"
                        style="@style/MR702_Terminal_Param_EditText_Style"
                        android:text=""
                        app:isCharacterFilter="@{false}"
                        app:isNumberFilter="@{false}"
                        app:lengthFilter="@{4}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="秒"
                        android:textColor="@color/title_text_color"
                        android:textSize="@dimen/text_size_17" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/SubmitButton_ColorPrimary"
            onClickWithDebouncing="@{()->click.onSubmitClick()}"
            visible="@{vm.isEditable }"
            android:layout_marginBottom="15dp"
            android:text="保存"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>