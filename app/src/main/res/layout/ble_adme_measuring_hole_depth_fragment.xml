<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <LinearLayout
        android:id="@+id/ll_measure_mode"
        style="@style/Common_ClickableItem_LayoutStyle">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测量模式" />

        <TextView
            android:id="@+id/tv_measure_mode"
            style="@style/Common_ClickableItem_ValueStyle"
            android:text="手动测孔深模式" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:paddingStart="18dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="下放堵转检测"
            android:textColor="@color/title_text_color"
            android:textSize="@dimen/text_size_17" />

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/decentralizedEnableSBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:kswAnimationDuration="100"
            app:kswBackDrawable="@drawable/sl_switchbutton_back"
            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
            app:kswThumbHeight="28dp"
            app:kswThumbRangeRatio="2"
            app:kswThumbWidth="28dp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_manual_measure_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ll_motion_type"
            style="@style/Common_ClickableItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="运动方式" />

            <TextView
                android:id="@+id/tv_motion_way"
                style="@style/Common_ClickableItem_ValueStyle"
                android:text="上拉" />

        </LinearLayout>

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="电机速度(r/min)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_motor_movement_speed"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <RadioButton
                    android:id="@+id/radio_auto_control"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/switch_sensor_radio_selector"
                    android:text="运动距离(m)"
                    android:textColor="@color/text_color_343434"
                    android:textSize="@dimen/text_size_17" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/motionDistanceEt"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/radio_manual_control"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="16dp"
                android:button="@drawable/switch_sensor_radio_selector"
                android:text="手动模式"
                android:textColor="@color/text_color_343434"
                android:textSize="@dimen/text_size_17" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_auto_measure_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="下放速度(r/min)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_down_speed"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="number" />

        </LinearLayout>

        <LinearLayout
            style="@style/Common_EditItem_LayoutStyle"
            android:background="@drawable/layer_common_click_item_with_divider">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="安全距离补偿(m)" />

            <com.shmedo.mcloudapp.common.view.ClearEditText
                android:id="@+id/et_safe_distance"
                style="@style/Common_EditItem_EditText_Style"
                android:inputType="numberDecimal" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btn_run"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_select"
        android:gravity="center"
        android:text="运行"
        android:textColor="@color/white"
        android:textSize="17sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp">

        <LinearLayout
            android:id="@+id/ll_clear_motion_data"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_clear_motion_data"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_clear_motion_data"
                android:drawablePadding="10dp"
                android:text="清空数据"
                android:textColor="@color/text_color_666666"
                android:textSize="@dimen/text_size_15" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_motion_data_clear_complete"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_motion_data_clear_complete"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_motion_data_clear_complete"
                android:drawablePadding="10dp"
                android:text="已清空数据"
                android:textColor="@color/text_color_666666"
                android:textSize="@dimen/text_size_15" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
