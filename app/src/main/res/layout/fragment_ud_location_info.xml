<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="toolbarVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.ToolbarViewModel" />

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.UDLocationInfoViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.u_product.fragment.deviceinfo.UDLocationInfoFragment.ClickProxy" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray"
        android:orientation="vertical">

        <include
            android:id="@+id/ll_toolbar"
            layout="@layout/include_device_config_toolbar_white"
            app:click="@{click}"
            app:vm="@{toolbarVM}" />

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/DeviceCurrentState_Item_Layout_Style2"
            android:layout_marginHorizontal="@dimen/page_content_margin_horizontal_12"
            android:layout_marginTop="@dimen/page_content_padding_top_12"
            android:background="@drawable/shape_common_click_item_top_corner_4"
            android:paddingTop="@dimen/page_content_margin_top_12">

            <com.google.android.material.textview.MaterialTextView
                style="@style/DeviceCurrentState_Item_Title_Style2"
                onClickWithDebouncing="@{()->click.refreshLocation()}"
                android:text="位置更新"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/DeviceCurrentState_Item_Layout_Style2"
            android:layout_marginHorizontal="@dimen/page_content_margin_horizontal_12"
            android:background="@drawable/layer_common_click_item_with_divider">

            <com.google.android.material.textview.MaterialTextView
                style="@style/DeviceCurrentState_Item_Title_Style2"
                android:text="UTC时间" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/DeviceCurrentState_ClickableItem_Value_Style2"
                android:drawableEnd="@null"
                android:text="@{stateVM.utcTime}"
                tools:text="2024.01.05 04:34:45" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/DeviceCurrentState_Item_Layout_Style2"
            android:layout_marginHorizontal="@dimen/page_content_margin_horizontal_12"
            android:background="@drawable/layer_common_click_item_with_divider">

            <com.google.android.material.textview.MaterialTextView
                style="@style/DeviceCurrentState_Item_Title_Style2"
                android:text="经度" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/DeviceCurrentState_ClickableItem_Value_Style2"
                android:drawableEnd="@null"
                android:text="@{stateVM.longitude}"
                tools:text="121.5983860" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/DeviceCurrentState_Item_Layout_Style2"
            android:layout_marginHorizontal="@dimen/page_content_margin_horizontal_12"
            android:background="@drawable/shape_common_click_item_bottom_corner_4">

            <com.google.android.material.textview.MaterialTextView
                style="@style/DeviceCurrentState_Item_Title_Style2"
                android:text="纬度" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/DeviceCurrentState_ClickableItem_Value_Style2"
                android:drawableEnd="@null"
                android:text="@{stateVM.latitude}"
                tools:text="1.210353" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/page_content_margin_horizontal_12"
            android:layout_weight="1">

            <com.amap.api.maps.TextureMapView
                android:id="@+id/textureMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/dimen_size_10"
                android:layout_marginEnd="@dimen/dimen_size_10"
                android:onClick="@{()->click.backLocation()}"
                app:backgroundTint="@color/white"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_map_locate"
                app:tint="@color/black" />

        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>