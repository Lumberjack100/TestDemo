<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="stateVM"
            type="com.shmedo.mcloudapp.ui.viewmodel.state.UDLocationInfoViewModel" />

        <variable
            name="click"
            type="com.shmedo.mcloudapp.ui.page.device.u_product.fragment.deviceinfo.UDLocationInfoFragment.ClickProxy" />
    </data>

    <com.shmedo.mcloudapp.ui.widget.CustomNestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/DeviceCurrentState_SingleItem_Style"
                android:background="@drawable/layer_common_click_item_with_divider">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DeviceCurrentState_SingleItem_NameStyle"
                    onClickWithDebouncing="@{()->click.refreshLocation()}"
                    android:text="位置更新"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/DeviceCurrentState_SingleItem_Style"
                android:background="@drawable/layer_common_click_item_with_divider">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DeviceCurrentState_SingleItem_NameStyle"
                    android:text="UTC时间" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                    android:text="@{stateVM.utcTime}"
                    tools:text="2024.01.05 04:34:45" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/DeviceCurrentState_SingleItem_Style"
                android:background="@drawable/layer_common_click_item_with_divider">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DeviceCurrentState_SingleItem_NameStyle"
                    android:text="经度" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                    android:text="@{stateVM.longitude}"
                    tools:text="121.5983860" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                style="@style/DeviceCurrentState_SingleItem_Style"
                android:background="@drawable/layer_common_click_item_with_divider">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DeviceCurrentState_SingleItem_NameStyle"
                    android:text="纬度" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/DeviceCurrentState_SingleItem_ValueStyle"
                    android:text="@{stateVM.latitude}"
                    tools:text="1.210353" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.amap.api.maps.TextureMapView
                android:id="@+id/textureMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_size_10" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.shmedo.mcloudapp.ui.widget.CustomNestedScrollView>
</layout>