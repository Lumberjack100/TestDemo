<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/activity_device_toolbar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <include
        android:id="@+id/collector_address_layout"
        layout="@layout/sensor_config_item_with_edittext"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <include
        android:id="@+id/collector_collect_interval_layout"
        layout="@layout/sensor_config_item_with_edittext"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <include
        android:id="@+id/collector_solution_interval_layout"
        layout="@layout/sensor_config_item_with_edittext"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <include
        android:id="@+id/communication_module_sleep_interval_layout"
        layout="@layout/sensor_config_item_with_edittext"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <include
        android:id="@+id/sensor_type_layout"
        layout="@layout/sensor_config_item_with_edittext"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <include
        android:id="@+id/sensor_address_layout"
        layout="@layout/sensor_config_item_with_edittext"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <include
        android:id="@+id/sensor_correction_value_layout"
        layout="@layout/sensor_config_item_with_edittext"/>


    <Button
        android:id="@+id/btn_confirm_complete"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/btn_select"
        android:text="完成"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_16"/>


</LinearLayout>