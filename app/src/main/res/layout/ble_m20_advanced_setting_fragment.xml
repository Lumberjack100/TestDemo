<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Space
            android:layout_width="wrap_content"
            android:layout_height="20dp" />

        <LinearLayout
            android:id="@+id/dataCenterConfigLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="数据中心高级配置" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="14dp" />

        <LinearLayout
            android:id="@+id/cmdDebugLogLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="指令日志输出" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="18dp"
            android:background="@color/divider_line_bg_efefef" />

        <LinearLayout
            android:id="@+id/firmwareUpgradeLayout"
            android:visibility="gone"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="固件升级" />

            <TextView style="@style/Common_ClickableItem_ValueStyle" />

        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="14dp" />

        <LinearLayout
            android:id="@+id/horizontalInitializationLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="水平初始化" />

        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="14dp" />

        <LinearLayout
            android:id="@+id/rebootLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="设备重启" />

        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="14dp" />

        <LinearLayout
            android:id="@+id/resetLayout"
            style="@style/Common_ClickableItem_LayoutStyle">

            <TextView
                style="@style/Common_ClickableItem_TitleStyle"
                android:text="恢复出厂设置" />

        </LinearLayout>


    </LinearLayout>

</ScrollView>