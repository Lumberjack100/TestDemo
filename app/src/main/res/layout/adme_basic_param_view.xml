<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:id="@+id/ll_mac_address"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:visibility="gone">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="Mac地址" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_mac_address"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="textCapCharacters" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_measure_method"
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测量方式" />

        <TextView
            android:id="@+id/tv_measure_method"
            style="@style/Common_ClickableItem_ValueStyle"
            tools:text="实时测量" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_waiting_interval_per_round"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:visibility="gone">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="每轮等待时间(min)" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_waiting_interval_per_round"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="number" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_measurement_interval_per_round"
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:visibility="visible">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="每轮测量间隔(h)" />

        <TextView
            android:id="@+id/tv_measurement_interval_per_round"
            style="@style/Common_ClickableItem_ValueStyle"
            android:text="1" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_start_time_per_round"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider"
        android:visibility="gone">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="每轮测量开始时间" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:clipToPadding="false"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:splitMotionEvents="false"
        android:visibility="gone"
        tools:itemCount="4"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_time"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ll_inclination_tube_hole_depth"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="测斜管孔深(m)" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_inclination_tube_hole_depth"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="numberDecimal" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_decentralization_speed"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="下放速度(r/min)" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_decentralization_speed"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="number" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_decentralization_waiting_time"
        style="@style/Common_EditItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="下放等待时间(min)" />

        <com.shmedo.mcloudapp.common.view.ClearEditText
            android:id="@+id/et_decentralization_waiting_time"
            style="@style/Common_EditItem_EditText_Style"
            android:inputType="number" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_data_settlement_method"
        style="@style/Common_ClickableItem_LayoutStyle"
        android:background="@drawable/layer_common_click_item_with_divider">

        <TextView
            style="@style/Common_ClickableItem_TitleStyle"
            android:text="数据解算方式" />

        <TextView
            android:id="@+id/tv_data_settlement_method"
            style="@style/Common_ClickableItem_ValueStyle"
            tools:text="顶部固定法" />

    </LinearLayout>

    <RelativeLayout style="@style/SwitchButton_LayoutStyle">

        <TextView
            style="@style/SwitchButton_TitleStyle"
            android:text="下放堵转检测" />

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/decentralizedEnableSBtn"
            style="@style/SwitchButton_ButtonStyle"
            app:kswAnimationDuration="100"
            app:kswBackDrawable="@drawable/sl_switchbutton_back"
            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
            app:kswThumbHeight="28dp"
            app:kswThumbRangeRatio="2"
            app:kswThumbWidth="28dp" />

    </RelativeLayout>

    <RelativeLayout style="@style/SwitchButton_LayoutStyle">

        <TextView
            style="@style/SwitchButton_TitleStyle"
            android:text="正反测使能" />

        <com.kyleduo.switchbutton.SwitchButton
            android:id="@+id/positiveAndNegativeEnableSBtn"
            style="@style/SwitchButton_ButtonStyle"
            app:kswAnimationDuration="100"
            app:kswBackDrawable="@drawable/sl_switchbutton_back"
            app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
            app:kswThumbHeight="28dp"
            app:kswThumbRangeRatio="2"
            app:kswThumbWidth="28dp" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <Button
        android:id="@+id/btn_confirm"
        style="@style/SubmitBordelessButtonStyle"
        android:text="保存" />

</LinearLayout>