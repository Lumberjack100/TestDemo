<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="m"
            type="com.shmedo.mcloudapp.device.model.DeviceStatusInfoBasicItem" />

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/item"
        style="@style/DeviceCurrentState_SingleItem_Style"
        android:background="@drawable/layer_common_click_item_with_divider">

        <com.google.android.material.textview.MaterialTextView
            style="@style/DeviceCurrentState_SingleItem_NameStyle"
            android:text='@{m.name}'
            tools:text="固件版本" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/DeviceCurrentState_SingleItem_ValueStyle"
            android:text="@{m.value}"
            android:textColor="@{m.colorRes==0?@color/title_text_color:m.colorRes}"
            tools:text="1212" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>