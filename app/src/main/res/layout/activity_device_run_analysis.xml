<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_f2f2f2"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar_white_bg" />

    <include layout="@layout/device_config_head_info_new" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Space
                android:layout_width="wrap_content"
                android:layout_height="14dp" />

            <LinearLayout
                android:id="@+id/iotCardLayout"
                style="@style/Device_RunAnalysis_LinearLayoutStyle">

                <TextView
                    style="@style/Device_RunAnalysis_TitleTextView_Style"
                    android:text="物联网卡" />

                <TextView
                    android:id="@+id/tv_iot_card_number"
                    style="@style/Device_RunAnalysis_ValueTextView_Style"
                    tools:text="430023489" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="18dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout
                android:id="@+id/signalLayout"
                style="@style/Device_RunAnalysis_LinearLayoutStyle">

                <TextView
                    style="@style/Device_RunAnalysis_TitleTextView_Style"
                    android:text="4g信号" />

                <TextView
                    android:id="@+id/tv_4g_signal"
                    style="@style/Device_RunAnalysis_ValueTextView_Style"
                    tools:text="强" />

            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="14dp" />

            <LinearLayout
                android:id="@+id/powerLayout"
                style="@style/Device_RunAnalysis_LinearLayoutStyle">

                <TextView
                    style="@style/Device_RunAnalysis_TitleTextView_Style"
                    android:text="设备电量" />

                <TextView
                    android:id="@+id/tv_power"
                    style="@style/Device_RunAnalysis_ValueTextView_Style"
                    tools:text="69%" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="18dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout
                android:id="@+id/externalVoltageLayout"
                style="@style/Device_RunAnalysis_LinearLayoutStyle">

                <TextView
                    style="@style/Device_RunAnalysis_TitleTextView_Style"
                    android:text="外部电压" />

                <TextView
                    android:id="@+id/tv_external_voltage"
                    style="@style/Device_RunAnalysis_ValueTextView_Style"
                    tools:text="28.4V" />

            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="14dp" />

            <LinearLayout
                android:id="@+id/firmwareVersionLayout"
                style="@style/Device_RunAnalysis_LinearLayoutStyle">

                <TextView
                    style="@style/Device_RunAnalysis_TitleTextView_Style"
                    android:text="固件版本" />

                <TextView
                    android:id="@+id/tv_firmware_version"
                    style="@style/Device_RunAnalysis_ValueTextView_Style"
                    tools:text="01.3.10" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="18dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout
                android:id="@+id/locationLayout"
                style="@style/Device_RunAnalysis_LinearLayoutStyle">

                <TextView
                    style="@style/Device_RunAnalysis_TitleTextView_Style"
                    android:text="位置信息" />

                <TextView
                    android:id="@+id/tv_location"
                    style="@style/Device_RunAnalysis_ValueTextView_Style"
                    tools:text="106.71，26.57" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="18dp"
                android:background="@color/divider_line_bg_efefef" />

            <LinearLayout
                android:id="@+id/sensorStatusLayout"
                style="@style/Device_RunAnalysis_LinearLayoutStyle">

                <TextView
                    style="@style/Device_RunAnalysis_TitleTextView_Style"
                    android:text="传感器状态" />

                <TextView
                    android:id="@+id/tv_sensor_status"
                    style="@style/Device_RunAnalysis_ValueTextView_Style"
                    tools:text="解析中..." />

            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="50dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>