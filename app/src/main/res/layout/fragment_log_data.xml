<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>


    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_bg_gray">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_scrollFlags="scroll|enterAlways"
            app:navigationIcon="@drawable/ic_navigation_black2"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            app:subtitleTextAppearance="@style/Toolbar_SubTitleText"
            app:subtitleTextColor="@color/sub_title_text_color"
            app:titleTextAppearance="@style/Toolbar_TitleText"
            app:titleTextColor="@color/title_text_color"
            tools:title="消息" />

        <com.drake.statelayout.StateLayout
            android:id="@+id/stateLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">

            <com.l4digital.fastscroll.FastScrollRecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:handleColor="@color/fastscroll_handle"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:showBubble="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_common_log" />
        </com.drake.statelayout.StateLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>