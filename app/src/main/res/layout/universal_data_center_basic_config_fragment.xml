<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <RelativeLayout style="@style/SwitchButton_LayoutStyle">

            <TextView
                style="@style/SwitchButton_TitleStyle"
                android:text="开启状态" />

            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/centerEnableSBtn"
                style="@style/SwitchButton_ButtonStyle"
                app:kswAnimationDuration="100"
                app:kswBackDrawable="@drawable/sl_switchbutton_back"
                app:kswThumbDrawable="@drawable/shape_switchbutton_thumb"
                app:kswThumbHeight="28dp"
                app:kswThumbRangeRatio="2"
                app:kswThumbWidth="28dp" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                style="@style/Common_EditItem_LayoutStyle"
                android:background="@drawable/layer_common_click_item_with_divider">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="数据中心地址" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_data_server_address"
                    style="@style/Common_EditItem_EditText_Style" />

            </LinearLayout>

            <LinearLayout style="@style/Common_EditItem_LayoutStyle">

                <TextView
                    style="@style/Common_ClickableItem_TitleStyle"
                    android:text="数据中心端口" />

                <com.shmedo.mcloudapp.common.view.ClearEditText
                    android:id="@+id/et_data_server_port"
                    style="@style/Common_EditItem_EditText_Style"
                    android:inputType="number" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_confirm"
                style="@style/SubmitBordelessButtonStyle"
                android:text="保存" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>