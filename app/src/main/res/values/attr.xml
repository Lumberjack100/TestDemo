<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="BaseIconView">
        <!--IconView最外面背景图片，可以是单个图片或者selector-->
        <attr name="biv_background" format="reference|color" />
        <!--IconView最背里面景图片，可以是单个图片或者selector-->
        <attr name="biv_icon" format="reference|color" />
    </declare-styleable>

    <!--自定义圆圈扩散View-->
    <declare-styleable name="DiffuseView">
        <!--扩散圆颜色-->
        <attr name="diffuse_color" format="color"/>
        <!--中心圆颜色-->
        <attr name="diffuse_coreColor" format="color"/>
        <!--中心圆图片-->
        <attr name="diffuse_coreImage" format="reference"/>
        <!--中心圆半径-->
        <attr name="diffuse_coreRadius" format="float"/>
        <!--扩散圆宽度,值越小越宽-->
        <attr name="diffuse_width" format="integer"/>
        <!--最大扩散宽度-->
        <attr name="diffuse_maxWidth" format="integer"/>
        <!--扩散速度，值越大越快-->
        <attr name="diffuse_speed" format="integer"/>
    </declare-styleable>

    <!-- 自定义环形进度条的属性-->
    <declare-styleable name="RingProgressView">
        <attr name="ringColor" format="color"/>
        <attr name="ringProgressColor" format="color"/>
        <attr name="ringWidth" format="dimension"/>
        <attr name="textSize" format="dimension"/>
        <attr name="textColor" format="color"/>
        <attr name="currentProgress" format="integer"/>
        <attr name="maxProgress" format="integer"/>
    </declare-styleable>

</resources>