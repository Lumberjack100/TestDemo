<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="app_primary_color" format="color"/> <!-- topbar -->
    <attr name="app_content_bg_color" format="color"/> <!-- content-->

    <!--EditSpinner控件-->
    <declare-styleable name="EditSpinner">
        <attr name="hint" format="string"/>
        <attr name="rightImage" format="reference"/>
        <attr name="Background" format="reference"/>
        <attr name="maxLine" format="integer"/>
    </declare-styleable>


    <declare-styleable name="PlayPauseView">
        <attr name="bg_color" format="color"/>
        <attr name="btn_color" format="color"/>
        <attr name="gap_width" format="dimension|reference"/>
        <attr name="space_padding" format="dimension|reference"/>
        <attr name="anim_duration" format="integer"/>
        <attr name="anim_direction">
            <enum name="positive" value="1"/>
            <enum name="negative" value="2"/>
        </attr>
    </declare-styleable>

    <declare-styleable name="BaseIconView">
        <!--IconView最外面背景图片，可以是单个图片或者selector-->
        <attr name="biv_background" format="reference|color" />
        <!--IconView最背里面景图片，可以是单个图片或者selector-->
        <attr name="biv_icon" format="reference|color" />
    </declare-styleable>


    <!--自定义圆圈扩散View-->
    <declare-styleable name="DiffuseView">
        <!--扩散圆颜色-->
        <attr name="diffuse_color" format="color"/>
        <!--中心圆颜色-->
        <attr name="diffuse_coreColor" format="color"/>
        <!--中心圆图片-->
        <attr name="diffuse_coreImage" format="reference"/>
        <!--中心圆半径-->
        <attr name="diffuse_coreRadius" format="float"/>
        <!--扩散圆宽度,值越小越宽-->
        <attr name="diffuse_width" format="integer"/>
        <!--最大扩散宽度-->
        <attr name="diffuse_maxWidth" format="integer"/>
        <!--扩散速度，值越大越快-->
        <attr name="diffuse_speed" format="integer"/>
    </declare-styleable>

    <!-- 自定义环形进度条的属性-->
    <declare-styleable name="RingProgressView">
        <attr name="ringColor" format="color"/>
        <attr name="ringProgressColor" format="color"/>
        <attr name="ringWidth" format="dimension"/>
        <attr name="textSize" format="dimension"/>
        <attr name="textColor" format="color"/>
        <attr name="currentProgress" format="integer"/>
        <attr name="maxProgress" format="integer"/>
    </declare-styleable>

</resources>