<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--自定义圆圈扩散View-->
    <declare-styleable name="DiffuseView">
        <!--扩散圆颜色-->
        <attr name="diffuse_color" format="color" />
        <!--中心圆颜色-->
        <attr name="diffuse_coreColor" format="color" />
        <!--中心圆图片-->
        <attr name="diffuse_coreImage" format="reference" />
        <!--中心圆半径-->
        <attr name="diffuse_coreRadius" format="float" />
        <!--扩散圆宽度,值越小越宽-->
        <attr name="diffuse_width" format="integer" />
        <!--最大扩散宽度-->
        <attr name="diffuse_maxWidth" format="integer" />
        <!--扩散速度，值越大越快-->
        <attr name="diffuse_speed" format="integer" />
    </declare-styleable>

    <!-- 自定义环形进度条的属性-->
    <declare-styleable name="RingProgressView">
        <attr name="ringColor" format="color" />
        <attr name="ringProgressColor" format="color" />
        <attr name="ringWidth" format="dimension" />
        <attr name="textSize" format="dimension" />
        <attr name="textColor" format="color" />
        <attr name="currentProgress" format="integer" />
        <attr name="maxProgress" format="integer" />
    </declare-styleable>

    <!--自定义信号强度的属性-->
    <declare-styleable name="SignalView">
        <attr name="signal_maximum" format="reference|integer" /><!--信号柱数量-->
        <attr name="signal_level" format="integer" /><!--信号等级-->
        <attr name="primary_color" format="reference|color" /><!--无信号颜色-->
        <attr name="level_color" format="reference|color" /><!--有信号颜色-->
        <attr name="spacing" format="integer" /><!--间隙-->
        <attr name="unit_width" format="integer" /><!--信号柱宽度-->
        <attr name="connected" format="boolean" /><!--链接状态-->
        <attr name="shadow_color" format="reference|color" /><!--阴影颜色-->
        <attr name="shadow_open" format="boolean" /><!--打开阴影-->
    </declare-styleable>

    <!--自定义电池电量的属性-->
    <declare-styleable name="BatteryView">
        <attr name="batteryOrientation">
            <enum name="horizontal" value="0" />
            <enum name="vertical" value="1" />
        </attr>
        <attr name="batteryColor" format="color" />
        <attr name="borderColor" format="color" />
        <attr name="batteryPower" format="integer" />
    </declare-styleable>

    <!--de.hdodenhof:circleimageview 的属性-->
    <declare-styleable name="CircleImageView">
        <attr name="civ_border_width" format="dimension" />
        <attr name="civ_border_color" format="color" />
        <attr name="civ_border_overlay" format="boolean" />
        <attr name="civ_circle_background_color" format="color" />
    </declare-styleable>


    <!-- 在 attrs.xml 中修改 AnimatedTextSwitcher 的属性定义 -->
    <declare-styleable name="AnimatedTextSwitcher">
        <attr name="defaultTextSize" format="dimension" />
        <attr name="defaultTextColor" format="color" />
        <attr name="errorTextColor" format="color" />
        <attr name="warnTextColor" format="color" />
        <attr name="textGravity">
            <flag name="center" value="17" />
            <flag name="center_horizontal" value="1" />
            <flag name="center_vertical" value="16" />
            <flag name="start" value="8388611" />
            <flag name="end" value="8388613" />
        </attr>
        <attr name="needBackground" format="boolean" />
        <attr name="defaultBackground" format="reference" />
        <attr name="errorBackground" format="reference" />
        <attr name="warnBackground" format="reference" />
        <attr name="paddingHorizontal" format="dimension" />
        <attr name="paddingVertical" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CustomMaterialAutoComplete">
        <attr name="ignoreCase" format="boolean" />
        <attr name="maxSuggestions" format="integer" />
        <attr name="minCharacters" format="integer" />
    </declare-styleable>

</resources>