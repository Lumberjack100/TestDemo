<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- actionbar颜色-->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- 状态栏颜色-->
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <!--设置窗体无主题-->
        <item name="windowNoTitle">true</item>
        <!--设置窗体切换动画-->
        <item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
    </style>

    <!-- 闪屏页主题 -->
    <style name="MCloud.WelcomeActivity" parent="AppTheme">
        <!--Android冷启动白屏解析http://blog.csdn.net/guolin_blog/article/details/51019856-->
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="MCloud.MapActivity" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <style name="MCloud.SpeedTestResultActivity" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <!-- actionbar颜色-->
        <item name="colorPrimary">#61a9fc</item>
        <!-- 状态栏颜色-->
        <item name="colorPrimaryDark">#61a9fc</item>
    </style>

    <style name="LightStatusBarActivity" parent="Theme.MaterialComponents.Light.Bridge">
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>


    <style name="CropImageActivity" parent="Base.Theme.AppCompat" />

    <!--Activity进入和退出动画-->
    <!-- animation 样式 -->
    <style name="ActivityAnimation" parent="@android:style/Animation.Activity">
        <!--打开新的activity时新的activity动画-->
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <!--打开新的activity时旧的activity动画-->
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <!--退出activity时新的activity动画-->
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <!--退出activity时旧的activity动画-->
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <style name="DialogFragmentAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!--顶部弹出Dialog动画-->
    <style name="TopAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/anim_top_in</item>
        <item name="android:windowExitAnimation">@anim/anim_top_out</item>
    </style>

    <!--自定义Dialog样式-->
    <style name="MyDialogFragment" parent="AlertDialog.AppCompat">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>


    <!--EditSpinner控件样式-->
    <style name="edit_main_bg">
        <item name="android:background">@null</item>
        <item name="android:textColor">@color/gray_807B7B</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">5dp</item>
    </style>

    <!--地图工具控件样式-->
    <style name="MapToolIconView">
        <item name="android:layout_width">35dp</item>
        <item name="android:layout_height">45dp</item>
    </style>

    <style name="DividerLineView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1px</item>
        <item name="android:background">@color/gray_f2f2f2</item>
    </style>

    <!--地图顶部定位坐标、海拔等 TextView 样式-->
    <style name="LocationTitle_TextViewStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:textColor">@color/gray_807B7B</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <!--固定在底部的布局样式-->
    <style name="PoiDetailFixedStyle">
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:textColor">@color/poi_detail_loc</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>


    <style name="TextView_SearchInputBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawableLeft">@drawable/ic_search_24dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--TextView相关样式-->
    <style name="BaseTextTheme">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="NormalTextTheme.BaseTextTheme" parent="BaseTextTheme">
        <item name="android:textSize" tools:ignore="SpUsage">16sp</item>
    </style>

    <style name="SmallTextTheme.BaseTextTheme" parent="BaseTextTheme">
        <item name="android:textSize" tools:ignore="SpUsage">14sp</item>
    </style>


    <!--ToolView 下ConstraintLayoutStyl的样式-->
    <style name="NaviToolView_ConstraintLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingLeft">@dimen/dimen_size_10</item>
        <item name="android:paddingRight">@dimen/dimen_size_10</item>
        <item name="android:paddingTop">@dimen/dimen_size_15</item>
        <item name="android:paddingBottom">@dimen/dimen_size_15</item>
    </style>

    <style name="UserInfo_LinearLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">@dimen/dimen_size_20</item>
        <item name="android:paddingRight">@dimen/dimen_size_20</item>
        <item name="android:paddingTop">@dimen/dimen_size_15</item>
        <item name="android:paddingBottom">@dimen/dimen_size_15</item>
    </style>

    <style name="Common_EditItem_LayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="Common_EditItem_EditText_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawablePadding">15dp</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:singleLine">true</item>
        <item name="android:hint">请输入</item>
        <item name="android:textColorHint">@color/text_color_cccccc</item>
        <item name="android:textColor">@color/text_color_666666</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Common_ClickableItem_LayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="Common_ClickableItem_TitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Common_ClickableItem_ValueStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawableEnd">@drawable/icon_arrow_right</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">right</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColorHint">@color/text_color_cccccc</item>
        <item name="android:textColor">@color/text_color_666666</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Button 样式-->
    <style name="SubmitBordelessButtonStyle" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/ripple_button_with_corner</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">25dp</item>

    </style>

    <!--设备当前运行状态分组标题样式-->
    <style name="DeviceCurrentState_Group_TitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/main_bg_gray</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/sub_title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--设备当前运行状态单条基本信息样式-->
    <style name="DeviceCurrentState_SingleItem_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/white</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <!--设备当前运行状态单条项目标题样式-->
    <style name="DeviceCurrentState_SingleItem_NameStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--设备当前运行状态单条项目值样式-->
    <style name="DeviceCurrentState_SingleItem_ValueStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:gravity">right</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_color_666666</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="bg_empty_view">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/main_bg_gray</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="empty_img">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>


</resources>
