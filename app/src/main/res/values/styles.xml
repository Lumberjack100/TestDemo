<resources xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.Bridge">
        <!-- actionbar颜色-->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- 状态栏颜色-->
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorAccent">@color/storage_ring_progress_abnormal</item>
        <!--设置窗体切换动画-->
        <item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="LightStatusBarActivity" parent="Theme.MaterialComponents.Light.Bridge">
        <!-- actionbar颜色-->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- 状态栏颜色-->
        <item name="colorPrimaryDark">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Toolbar_TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_16</item>
    </style>

    <style name="Toolbar_SubTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/text_size_14</item>
    </style>

    <!--Activity进入和退出动画-->
    <!-- animation 样式 -->
    <style name="ActivityAnimation" parent="@android:style/Animation.Activity">
        <!--打开新的activity时新的activity动画-->
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <!--打开新的activity时旧的activity动画-->
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <!--退出activity时新的activity动画-->
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <!--退出activity时旧的activity动画-->
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!--通用分组标题样式-->
    <style name="Common_GroupName_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- 通用编辑项单条目样式 -->
    <style name="Common_EditItem_LayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <!-- 通用编辑项单条目中 EditText 样式 -->
    <style name="Common_EditItem_EditText_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawablePadding">15dp</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:singleLine">true</item>
        <item name="android:hint">请输入</item>
        <item name="android:textColorHint">@color/text_color_hint</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- 通用选择项条目样式 -->
    <style name="Common_ClickableItem_LayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <!-- 通用选择项单条目中 Title TextView 样式 -->
    <style name="Common_ClickableItem_TitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- 通用选择项单条目中 Value TextView 样式 -->
    <style name="Common_ClickableItem_ValueStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawableEnd">@drawable/icon_arrow_right</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColorHint">@color/text_color_hint</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 通用提交 Button 样式-->
    <style name="SubmitButton_ColorPrimary" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginStart">15dp</item>
        <item name="android:layout_marginEnd">15dp</item>
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:layout_marginBottom">25dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@drawable/ripple_button_with_corner</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--通用开关项单条目样式 SwitchButton 样式-->
    <style name="SwitchButton_LayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <!--通用开关项单条目中 Title TextView 样式-->
    <style name="SwitchButton_TitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">@dimen/dimen_size_16</item>
    </style>
    <!--通用开关项单条目中 SwitchButton 样式-->
    <style name="SwitchButton_ButtonStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="kswThumbHeight">@dimen/dimen_size_18</item>
        <item name="kswThumbWidth">@dimen/dimen_size_18</item>
        <item name="kswThumbRangeRatio">2.3</item>
    </style>

    <!--设备运行状态分组标题样式-->
    <style name="DeviceCurrentState_GroupName_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/main_bg_gray</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/sub_title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--设备运行状态单条基本信息样式-->
    <style name="DeviceCurrentState_SingleItem_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/white</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <!--设备运行状态单条项目标题样式-->
    <style name="DeviceCurrentState_SingleItem_NameStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--设备运行状态单条项目值样式-->
    <style name="DeviceCurrentState_SingleItem_ValueStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:gravity">right</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--MR702 终端参数页面单条项目值样式-->
    <style name="MR702_Terminal_Param_LinearLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <!--MR702 终端参数页面单条项目中 EditText 样式-->
    <style name="MR702_Terminal_Param_EditText_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">15dp</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical|left</item>
        <item name="android:maxLines">1</item>
        <item name="android:hint">请输入</item>
        <item name="android:textColorHint">@color/text_color_hint</item>
        <item name="android:textColor">@color/title_text_color</item>
        <item name="android:textSize">17sp</item>
    </style>

</resources>
