<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.mCloudApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>  <!-- actionbar颜色-->
        <item name="colorPrimaryDark">@color/colorPrimary</item>  <!-- 状态栏颜色-->
        <item name="colorAccent">@color/colorPrimary</item>
        <!--设置窗体切换动画-->
        <item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
    </style>

<!--    <style name="LightStatusBarActivity" parent="Theme.mCloudApp">-->
<!--        <item name="android:windowLightStatusBar">true</item>-->
<!--        <item name="android:statusBarColor">@color/white</item>-->
<!--        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>-->
<!--        <item name="android:navigationBarColor">@color/white</item>-->
<!--    </style>-->

    <style name="LightStatusBarActivity" parent="Theme.mCloudApp">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>

        <!-- 透明系统栏，真正的留白交给 EdgeToEdge Insets 分发 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- 自定义 MaterialToolbar 样式 -->
    <style name="Widget.MyApp.MaterialToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextAppearance">@style/Toolbar_TitleText</item>
        <item name="subtitleTextAppearance">@style/Toolbar_SubTitleText</item>
        <item name="popupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
    </style>

    <!-- 自定义标题文本样式 -->
    <style name="Toolbar_TitleText" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_16</item>
    </style>

    <!-- 自定义子标题文本样式 -->
    <style name="Toolbar_SubTitleText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_size_14</item>
    </style>

    <!--Activity进入和退出动画-->
    <!-- animation 样式 -->
    <style name="ActivityAnimation" parent="@android:style/Animation.Activity">
        <!--打开新的activity时新的activity动画-->
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <!--打开新的activity时旧的activity动画-->
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <!--退出activity时新的activity动画-->
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <!--退出activity时旧的activity动画-->
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!-- res/values/styles.xml -->
    <style name="TransparentLoadingDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/LoadingDialogAnimation</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="LoadingDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <!--通用分组标题样式-->
    <style name="Common_GroupItem_Title_Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/title_text_color_black_90</item>
        <item name="android:textSize">@dimen/text_size_15</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 通用编辑项单条目样式 -->
    <style name="Common_EditItem_Layout_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">
            @dimen/page_content_item_padding_horizontal_16
        </item>
    </style>

    <!-- 通用编辑项单条目中 EditText 样式 -->
    <style name="Common_EditItem_EditText_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:singleLine">true</item>
        <item name="android:hint">请输入</item>
        <item name="android:textColorHint">@color/text_color_hint</item>
        <item name="android:textColor">@color/sub_title_text_color_black_60</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <!-- 通用选择项条目样式 -->
    <style name="Common_ClickableItem_Layout_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">
            @dimen/page_content_item_padding_horizontal_16
        </item>
    </style>

    <!-- 通用选择项单条目中 Title TextView 样式 -->
    <style name="Common_ClickableItem_Title_Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/title_text_color_black_90</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <!-- 通用选择项单条目中 Value TextView 样式 -->
    <style name="Common_ClickableItem_Value_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableEnd">@drawable/ic_arrow_down</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColorHint">@color/text_color_hint</item>
        <item name="android:textColor">@color/sub_title_text_color_black_60</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <!--通用开关项单条目样式 SwitchButton 样式-->
    <style name="SwitchButton_Item_Layout_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">
            @dimen/page_content_item_padding_horizontal_16
        </item>
    </style>

    <!--通用开关项单条目中 Title TextView 样式-->
    <style name="SwitchButton_Item_Title_Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textColor">@color/title_text_color_black_90</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <!--通用开关项单条目中 SwitchButton 样式-->
    <style name="SwitchButton_Item_Button_Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="kswThumbHeight">@dimen/dimen_size_18</item>
        <item name="kswThumbWidth">@dimen/dimen_size_18</item>
        <item name="kswThumbRangeRatio">2.3</item>
    </style>

    <style name="ResetButton_Style" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@drawable/reset_param_button_background_tint</item>
        <item name="rippleColor">@color/ripple_material_light</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/reset_param_button_text_color</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 通用提交 Button 样式-->
    <style name="SubmitButton_Style" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@drawable/submit_button_background_tint</item>
        <item name="rippleColor">@color/ripple_material_light</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/submit_button_text_color</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TestButton_Style" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/ripple_material_light</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <style name="Common_MaterialButton_Style" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/ripple_material_light</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MeasureData_Button_Style" parent="@style/Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="cornerRadius">2dp</item>
        <item name="backgroundTint">@drawable/measure_data_button_background_tint</item>
        <item name="rippleColor">@color/ripple_material_light</item>
        <item name="strokeColor">@color/transparent</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">@dimen/dimen_size_18</item>
        <item name="iconTint">@color/measure_data_button_icon_tint_color</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/measure_data_button_text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--设备运行状态分组标题样式-->
    <style name="DeviceCurrentState_GroupItem_Title_Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/title_text_color_black_90</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--设备运行状态单条基本信息样式-->
    <style name="DeviceCurrentState_Item_Layout_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">
            @dimen/page_content_item_padding_horizontal_16
        </item>
    </style>

    <!--设备运行状态单条项目标题样式-->
    <style name="DeviceCurrentState_Item_Title_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/title_text_color_black_90</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <style name="DeviceCurrentState_ClickableItem_Value_Style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableEnd">@drawable/ic_arrow_right</item>
        <item name="android:gravity">center_vertical|right</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColorHint">@color/text_color_hint</item>
        <item name="android:textColor">@color/sub_title_text_color_black_60</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <!--MR702 终端参数页面单条项目值样式-->
    <style name="MR702_Terminal_Param_LinearLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!--MR702 终端参数页面单条项目中 EditText 样式-->
    <style name="MR702_Terminal_Param_EditText_Style">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">15dp</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical|left</item>
        <item name="android:maxLines">1</item>
        <item name="android:hint">请输入</item>
        <item name="android:textColorHint">@color/text_color_hint</item>
        <item name="android:textColor">@color/sub_title_text_color_black_60</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

    <style name="MaterialAutoCompleteTextView_Style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/sub_title_text_color_black_60</item>
        <item name="android:textSize">@dimen/page_content_item_text_size_14</item>
    </style>

</resources>
