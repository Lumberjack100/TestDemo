    <!-- 采集器、传感器参数说明-->
    <string name="collector_address">
        采集器地址：当同一条RS485总线下，接入多个采集器时，区分每个采集器，采集器(DAS)可识别区分，可填入1-255任意数字。
        这里说的采集器不是DAS，而是指支持Modbus RTU协议的传感器或采集器。
        此处的场景是，DAS作为总的控制器，对接入的子采集器的协调控制。
    </string>
    <string name="calculating_time">
        解算时间：是指DAS持续工作的时间，在这个时间段内，对采集到的数据进行解算处理(如剔除错误数据等)，提高数据精度和准确性。
    </string>
    <string name="standby_time">
        待机时间：是指DAS休眠的时间，DAS休眠时功耗极底，休眠时间的设置一般推荐6小时(360秒)，具体设置多少根据情况而定。
    </string>
    <string name="collect_time">
        采集时间：当DAS处于工作模式时，对外接的传感器/采集器发送采集指令，每次发送采集指令的时间间隔即为采集时间，采集时间间隔数值越小，
        获取到的数据样本就越多，对提高数据精度和准确性有帮助，具体设置多少，要看外部传感器/采集器是否支持，以及对功耗的考量。
    </string>
    <string name="osmometer_address">
        渗压计地址：当同一条RS485总线下，接入多个渗压计时，区分每个渗压计，采集器(DAS)可识别区分，可填入1-255任意数字。
        这里说的渗压计是指数字式的，支持Modbus RTU协议。当接入振弦式渗压计时，需额外配置振弦数据采集器。
    </string>
    <string name="water_alarm_value">
        水位报警值：当水位超过设定值时，自动报警。猪哥数值设定多少，需要跟业主、设计院等沟通，以便指定合理有效的报警值。
    </string>
    <string name="water_revised">
        水位修正值：渗压计首次安装到现场时，需要和人工测量的水深校准，如果渗压计测量的水深和人工测量的有差值，那么将这个差值填入到"水深修正值"一栏，
        后面自动测量的水深就校正过来了。
    </string>
    <string name="osmometer_cord">
        渗压计绳长的作用：通过管口高程、渗压计绳长、渗压计测量水深三个数计算出水位高程。
    </string>
    <string name="nozzel_height">
        管口高程数据来源：\n1、查阅图纸 \n 2、业主沟通 \n 3、设计院沟通 \n 4、自行测量
    </string>
    <string name="rain">
        翻斗式雨量计：通过计算内置翻斗的反转次数，计算降雨量，翻斗的分辨力常用为0.1mm、0.2mm、0.5mm，这项参数和雨量计要一致，不能选错。
    </string>

    <!-- DAG采集器参数说明-->
    <string name="dag_collector_addres">
        采集器地址：传感器中采集器的地址 (信道号)
    </string>
    <string name="dag_collector_collect_interval">
        采集器采集间隔：采集器用于进行一次数据采集的时间
    </string>
    <string name="dag_collector_solution_interval">
       采集器解算间隔：采集器用于进行一次数据解算的时间(解算间隔必须大于采集间隔)
    </string>
    <string name="dag_communication_module_sleep_interval">
       通讯模块休眠间隔：通讯模块的休眠时间，唤醒时间固定为5s
    </string>
    <string name="dag_sensor_type">
       传感器类型：兼容的传感器类型编号
    </string>
    <string name="dag_sensor_address">
       传感器地址：传感器自带的地址
    </string>
    <string name="dag_sensor_correction_value">
       传感器修正值：(默认：0.00，单位：mm，2位正小数)，用于修正不同传感器的零点系统误差
    </string>

    <!-- ADME 执行机构参数说明-->
    <string name="adme_data_settlement_method">
        数据解算方式：顶固定法为以顶部为零向下起算的数据，底固定法以底部为零向上起算的数据
    </string>
    <string name="adme_data_response">
        数据应答：开启数据应答后，平台会给予数据是否完整的反馈，如数据不完整则进行数据重发
    </string>
    <string name="adme_waiting_interval_per_round">
        每轮等待间隔：两轮测量的等待间隔时间这个值可以是0
    </string>
    <string name="adme_log_output_mode">
        日志输出方式：日志只能以一种方式进行输出
    </string>
    <string name="adme_motor_drive_address">
