<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gt600_graph"
    app:startDestination="@id/gt600HomeFragment">

    <include app:graph="@navigation/include_query_data_graph" />
    <include app:graph="@navigation/include_quick_config_cmd_graph" />
    <include app:graph="@navigation/include_advanced_setting_graph" />
    <include app:graph="@navigation/include_time_calibration_graph" />

    <fragment
        android:id="@+id/gt600HomeFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.gnss_product.fragment.gt600.GT600HomeFragment"
        android:label="GT600HomeFragment" />

    <fragment
        android:id="@+id/commonLocationInfoFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.common.CommonLocationInfoFragment"
        android:label="CommonLocationInfoFragment"
        tools:layout="@layout/fragment_common_location_info" />

    <fragment
        android:id="@+id/commonSensorDataHistoryFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.common.CommonSensorDataHistoryFragment"
        android:label="CommonSensorDataHistoryFragment"
        tools:layout="@layout/fragment_common_sensor_data_history" />

    <fragment
        android:id="@+id/gt600BaseInfoFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.gnss_product.fragment.gt600.GT600BaseInfoFragment"
        android:label="GT600BaseInfoFragment" />

    <!-- GT600 网络信息页面 -->
    <fragment
        android:id="@+id/gt600NetInfoFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.gnss_product.fragment.gt600.GT600NetInfoFragment"
        android:label="GT600NetInfoFragment" />

