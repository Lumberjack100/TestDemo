    <fragment
        android:id="@+id/gt600StatusInfoFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.gnss_product.fragment.gt600.GT600StatusInfoFragment"
        android:label="GT600StatusInfoFragment" />

    <!-- GT600 姿态监测页面 -->
    <fragment
        android:id="@+id/gt600LocationInfoFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.gnss_product.fragment.gt600.Gt600LocationInfoFragment"
        android:label="Gt600LocationInfoFragment"
        tools:layout="@layout/fragment_gt600_location_info" />

    <fragment
        android:id="@+id/m20SWorkModelParamFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.gnss_product.fragment.m20s.M20SWorkModelParamFragment"
        android:label="M20SWorkModelParamFragment"
        tools:layout="@layout/fragment_m20s_work_model_param" />

    <fragment
        android:id="@+id/m50NetworkConfigFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.gnss_product.fragment.m50.M50NetworkConfigFragment"
        android:label="M50NetworkConfigFragment"
        tools:layout="@layout/fragment_m50_network_config" />

    <fragment
        android:id="@+id/dataCenterHomeFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.common.UniversalDataCenterHomeFragment"
        android:label="UniversalDataCenterHomeFragment"
        tools:layout="@layout/fragment_universal_data_center_home" />

