<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adme_graph"
    app:startDestination="@id/admeHomeFragment">

    <include app:graph="@navigation/included_querydevicedata_graph" />

    <fragment
        android:id="@+id/admeHomeFragment"
        android:name="com.shmedo.mcloudapp.device.ui.adme.fragment.AdmeHomeFragment"
        android:label="AdmeHomeFragment"
        tools:layout="@layout/fragment_adme_home">

        <action
            android:id="@+id/action_admeHomeFragment_to_querydevicedata_graph"
            app:destination="@id/querydevicedata_graph"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

    </fragment>

</navigation>