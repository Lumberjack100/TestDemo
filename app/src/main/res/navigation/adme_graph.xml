<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adme_graph"
    app:startDestination="@id/admeHomeFragment">

    <include app:graph="@navigation/included_querydevicedata_graph" />

    <fragment
        android:id="@+id/admeHomeFragment"
        android:name="com.shmedo.mcloudapp.device.ui.adme.fragment.AdmeHomeFragment"
        android:label="AdmeHomeFragment"
        tools:layout="@layout/fragment_adme_home">

        <action
            android:id="@+id/action_admeHomeFragment_to_querydevicedata_graph"
            app:destination="@id/querydevicedata_graph"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

        <action
            android:id="@+id/action_admeHomeFragment_to_admeCurrentStateFragment"
            app:destination="@id/admeCurrentStateFragment"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

        <action
            android:id="@+id/action_admeHomeFragment_to_admeAdvancedConfigurationFragment"
            app:destination="@id/admeAdvancedConfigurationFragment"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

    </fragment>

    <fragment
        android:id="@+id/admeCurrentStateFragment"
        android:name="com.shmedo.mcloudapp.device.ui.adme.fragment.AdmeCurrentStateFragment"
        android:label="AdmeCurrentStateFragment"
        tools:layout="@layout/fragment_adme_current_state" />

    <fragment
        android:id="@+id/admeAdvancedConfigurationFragment"
        android:name="com.shmedo.mcloudapp.device.ui.adme.fragment.AdmeAdvancedConfigurationFragment"
        android:label="AdmeAdvancedConfigurationFragment"
        tools:layout="@layout/fragment_adme_advanced_configuration" >

        <action
            android:id="@+id/action_admeAdvancedConfigurationFragment_to_admeMeterWheelFragment"
            app:destination="@id/admeMeterWheelFragment"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

    </fragment>

    <fragment
        android:id="@+id/admeMeterWheelFragment"
        android:name="com.shmedo.mcloudapp.device.ui.adme.fragment.AdmeMeterWheelFragment"
        android:label="AdmeMeterWheelFragment"
        tools:layout="@layout/fragment_adme_meter_wheel" />
</navigation>