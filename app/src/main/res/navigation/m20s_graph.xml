<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/m20s_graph"
    app:startDestination="@id/m20SHomeFragment">

    <include app:graph="@navigation/include_query_data_graph" />
    <include app:graph="@navigation/include_data_center_graph" />
    <include app:graph="@navigation/include_alarm_setting_graph" />
    <include app:graph="@navigation/include_firmware_upgrade_graph" />
    <include app:graph="@navigation/include_ble_command_debug_graph" />


    <fragment
        android:id="@+id/m20SHomeFragment"
        android:name="com.shmedo.mcloudapp.device.ui.m20s.fragment.M20SHomeFragment"
        android:label="M20SHomeFragment"
        tools:layout="@layout/fragment_universal_device_home">

        <action
            android:id="@+id/action_m20SHomeFragment_to_m20SDeviceInfoFragment"
            app:destination="@id/m20SDeviceInfoFragment"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

        <action
            android:id="@+id/action_m20SHomeFragment_to_m20SWorkModelFragment"
            app:destination="@id/m20SWorkModelFragment"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />
        <action
            android:id="@+id/action_m20SHomeFragment_to_m20SRadioSettingFragment"
            app:destination="@id/m20SRadioSettingFragment"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

    </fragment>

    <fragment
        android:id="@+id/m20SDeviceInfoFragment"
        android:name="com.shmedo.mcloudapp.device.ui.m20s.fragment.deviceinfo.M20SDeviceInfoFragment"
        android:label="M20SDeviceInfoFragment"
        tools:layout="@layout/fragment_base_running_device_info" />

    <fragment
        android:id="@+id/m20SWorkModelFragment"
        android:name="com.shmedo.mcloudapp.device.ui.m20s.fragment.M20SWorkModelFragment"
        android:label="M20SWorkModelFragment"
        tools:layout="@layout/fragment_m20s_work_model" />

    <fragment
        android:id="@+id/m20SRadioSettingFragment"
        android:name="com.shmedo.mcloudapp.device.ui.m20s.fragment.M20SRadioSettingFragment"
        android:label="M20SRadioSettingFragment"
        tools:layout="@layout/fragment_m20s_radio_setting" />

    <action
        android:id="@+id/action_global_to_queryDeviceDataFragment"
        app:destination="@id/query_data_graph"
        app:enterAnim="@anim/activity_open_enter"
        app:exitAnim="@anim/activity_open_exit"
        app:popEnterAnim="@anim/activity_close_enter"
        app:popExitAnim="@anim/activity_close_exit" />
    <action
        android:id="@+id/action_global_universalDataCenterHomeFragment"
        app:destination="@id/data_center_graph"
        app:enterAnim="@anim/activity_open_enter"
        app:exitAnim="@anim/activity_open_exit"
        app:popEnterAnim="@anim/activity_close_enter"
        app:popExitAnim="@anim/activity_close_exit" />
    <action
        android:id="@+id/action_global_to_firmwareUpgradeFragment"
        app:destination="@id/firmware_upgrade_graph"
        app:enterAnim="@anim/activity_open_enter"
        app:exitAnim="@anim/activity_open_exit"
        app:popEnterAnim="@anim/activity_close_enter"
        app:popExitAnim="@anim/activity_close_exit" />

    <action
        android:id="@+id/action_global_to_alarmSettingFragment"
        app:destination="@id/alarm_setting_graph"
        app:enterAnim="@anim/activity_open_enter"
        app:exitAnim="@anim/activity_open_exit"
        app:popEnterAnim="@anim/activity_close_enter"
        app:popExitAnim="@anim/activity_close_exit" />

    <action
        android:id="@+id/action_global_to_commandDebug"
        app:destination="@id/ble_command_debug_graph"
        app:enterAnim="@anim/activity_open_enter"
        app:exitAnim="@anim/activity_open_exit"
        app:popEnterAnim="@anim/activity_close_enter"
        app:popExitAnim="@anim/activity_close_exit" />

</navigation>