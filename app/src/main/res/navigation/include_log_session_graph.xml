<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/log_session_graph"
    app:startDestination="@id/logSessionListFragment">

    <fragment
        android:id="@+id/logSessionListFragment"
        android:name="com.shmedo.mcloudapp.ui.page.debug.logger.LogSessionListFragment"
        android:label="LogSessionListFragment"
        tools:layout="@layout/fragment_log_session_list">

        <action
            android:id="@+id/action_logSessionListFragment_to_logDataFragment"
            app:destination="@id/logDataFragment"
            app:enterAnim="@anim/activity_open_enter"
            app:exitAnim="@anim/activity_open_exit"
            app:popEnterAnim="@anim/activity_close_enter"
            app:popExitAnim="@anim/activity_close_exit" />

    </fragment>

    <fragment
        android:id="@+id/logDataFragment"
        android:name="com.shmedo.mcloudapp.ui.page.debug.logger.LogDataFragment"
        android:label="LogDataFragment"
        tools:layout="@layout/fragment_log_data" />

</navigation>