<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ble_command_debug_graph"
    app:startDestination="@id/bleCustomCommandLogPrintFragment">

    <fragment
        android:id="@+id/bleCustomCommandLogPrintFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.common.BleCustomCommandLogPrintFragment"
        android:label="BleCustomCommandLogPrintFragment"
        tools:layout="@layout/fragment_ble_custom_command_log_print" />

    <fragment
        android:id="@+id/builtinCommandSelectorFragment"
        android:name="com.shmedo.mcloudapp.ui.page.device.common.BuiltinCommandSelectorFragment"
        android:label="BuiltinCommandSelectorFragment"
        tools:layout="@layout/fragment_builtin_command_selector" />

    <action
        android:id="@+id/action_to_builtinCommandSelectorFragment"
        app:destination="@id/builtinCommandSelectorFragment"
        app:enterAnim="@anim/activity_open_enter"
        app:exitAnim="@anim/activity_open_exit"
        app:popEnterAnim="@anim/activity_close_enter"
        app:popExitAnim="@anim/activity_close_exit" />
</navigation>