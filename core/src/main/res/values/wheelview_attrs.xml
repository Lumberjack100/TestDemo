<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="WheelView">
        <attr name="centerDrawable" format="reference|color" />
        <attr name="topShadow" format="reference|color" />
        <attr name="bottomShadow" format="reference|color" />
    </declare-styleable>
    <declare-styleable name="SideBar">
        <!--默认颜色-->
        <attr format="color" name="defaultColor"/>
        <!--选种颜色-->
        <attr format="color" name="chooseColor"/>
        <!--背景颜色-->
        <attr format="color" name="bgColor"/>
    </declare-styleable>
</resources>